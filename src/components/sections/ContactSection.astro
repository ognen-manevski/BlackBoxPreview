---
import PhoneIcon from '../icons/PhoneIcon.astro';
import MailIcon from '../icons/MailIcon.astro';
import SubscribeField from '../atoms/SubscribeField.astro';
import PrivacyConsent from '../atoms/PrivacyConsent.astro';
import ContactDetailItem from '../atoms/ContactDetailItem.astro';
import type { HomePageContent } from '../../i18n/pages/home';
interface Props { content: HomePageContent['contact']; }
const { content } = Astro.props;
---

<section class="section contact" id="contact" aria-labelledby="contact-heading">
  <video
    class="contact__bg-video"
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source src="/videos/gradients/dark/base-gradient-1.mp4" type="video/mp4" />
  </video>
  <div class="contact__bg-overlay" aria-hidden="true"></div>

  <div class="container contact__inner">
    <div class="contact__content">
      <p class="section-label">{content.label}</p>
      <h2 class="section-headline contact__headline" id="contact-heading">
        {content.heading}
      </h2>
      <p class="section-copy contact__copy">
        {content.copy}
      </p>

      <div class="contact__subscribe-wrap">
        <SubscribeField class="contact__subscribe" buttonLabel={content.subscribe} label={content.emailLabel} placeholder={content.emailPlaceholder} />
        <PrivacyConsent
          class="contact__consent"
          id="contact-subscribe-consent"
          name="contactSubscribeConsent"
          text={content.subscribeConsent}
          linkText={content.privacyPolicy}
          linkHref="#"
        />
      </div>

      <div class="contact__direct" aria-label={content.directAriaLabel}>
        <ContactDetailItem
          class="contact__direct-item"
          label={content.phoneLabel}
          value="+389 75 444 908"
          href="tel:+38975444908"
          iconStyle="--icon-badge-size: 2rem; --icon-badge-border: color-mix(in srgb, var(--border-color) 72%, var(--color-brand)); --icon-badge-bg: color-mix(in srgb, var(--bg-secondary) 75%, var(--bg));"
        >
          <PhoneIcon slot="icon" />
        </ContactDetailItem>

        <ContactDetailItem
          class="contact__direct-item"
          label={content.emailDirectLabel}
          value="contact@blackboxsolutions.mk"
          href="mailto:contact@blackboxsolutions.mk"
          iconStyle="--icon-badge-size: 2rem; --icon-badge-border: color-mix(in srgb, var(--border-color) 72%, var(--color-brand)); --icon-badge-bg: color-mix(in srgb, var(--bg-secondary) 75%, var(--bg));"
        >
          <MailIcon slot="icon" />
        </ContactDetailItem>
      </div>
    </div>

    <div class="contact__form-wrap u-border-interactive">
      <form class="contact__form" action="#" method="post">
        <label class="contact__field">
          <span>{content.nameLabel}</span>
          <input type="text" name="name" placeholder={content.namePlaceholder} autocomplete="name" required>
        </label>

        <label class="contact__field">
          <span>{content.emailLabel}</span>
          <input type="email" name="email" placeholder={content.emailPlaceholder} autocomplete="email" required>
        </label>

        <label class="contact__field">
          <span>{content.projectLabel}</span>
          <textarea
            name="projectDetails"
            placeholder={content.projectPlaceholder}
            rows="6"
            required
          ></textarea>
        </label>

        <div class="contact__upload-row">
          <label class="contact__file-link" for="contact-file">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21.44 11.05 12.25 20.24a5.25 5.25 0 1 1-7.42-7.43L14.73 2.92a3.5 3.5 0 0 1 4.95 4.95l-9.2 9.2a1.75 1.75 0 1 1-2.47-2.48l8.49-8.48" />
            </svg>
            <span>{content.addFile}</span>
          </label>
          <input id="contact-file" class="contact__file-input" type="file" name="attachment">
        </div>

        <div class="contact__actions">
          <button class="btn btn--primary" type="submit">{content.send}</button>
          <button class="btn btn--outline" type="reset">{content.reset}</button>
        </div>

        <PrivacyConsent
          class="contact__consent"
          id="contact-form-consent"
          name="contactFormConsent"
          required={true}
          text={content.formConsent}
          linkText={content.privacyPolicy}
          linkHref="#"
        />
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    background: var(--bg);
  }

  .contact__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .contact__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--bg) 70%, transparent) 0%, color-mix(in srgb, var(--bg) 24%, transparent) 70%, color-mix(in srgb, var(--bg) 35%, transparent) 100%);
    z-index: 1;
  }

  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--sp-8);
    align-items: start;
    position: relative;
    z-index: 2;
  }

  .contact__content {
    display: grid;
    gap: var(--sp-4);
    max-width: 42rem;
  }

  .contact__headline {
    max-width: 18ch;
  }

  .contact__copy {
    max-width: 58ch;
  }

  .contact__subscribe-wrap {
    margin-top: var(--sp-6);
    display: grid;
    gap: var(--sp-3);
    max-width: 34rem;
  }

  .contact__consent {
    max-width: 52ch;
  }

  .contact__direct {
    margin-top: var(--sp-7);
    display: grid;
    gap: var(--sp-4);
    max-width: 20rem;
  }

  .contact__direct-item {
    align-items: center;
  }

  .contact__form-wrap {
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--bg-secondary) 90%, var(--bg));
    padding: var(--sp-6);
  }

  .contact__form {
    display: grid;
    gap: var(--sp-4);
  }

  .contact__field {
    display: grid;
    gap: var(--sp-2);
  }

  .contact__field > span {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .contact__field :is(input, textarea) {
    width: 100%;
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-secondary) 82%, var(--bg));
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: 1.5;
    padding: var(--sp-3) var(--sp-4);
    transition: border-color var(--t-fast), background var(--t-fast);
  }

  .contact__field textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .contact__field :is(input, textarea)::placeholder {
    color: var(--text-muted);
  }

  .contact__field :is(input, textarea):is(:focus, :focus-visible) {
    border-color: var(--color-brand);
    outline: none;
  }

  .contact__upload-row {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .contact__file-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--text-secondary);
    cursor: pointer;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--t-fast);
  }

  .contact__file-link:is(:hover, :focus-visible) {
    color: var(--text-primary);
  }

  .contact__file-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 1px;
    height: 1px;
  }

  .contact__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-2);
    margin-top: var(--sp-1);
  }

  .contact__actions .btn {
    justify-content: center;
    align-items: center;
    min-height: 2.375rem;
    padding-top: var(--sp-2);
    padding-bottom: var(--sp-2);
  }

  @media (max-width: 1100px) {
    .contact__inner {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .contact__content,
    .contact__headline,
    .contact__copy,
    .contact__subscribe-wrap,
    .contact__direct {
      max-width: none;
    }
  }

  @media (max-width: 700px) {
    .contact__bg-overlay {
      background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 62%, transparent) 0%, color-mix(in srgb, var(--bg) 34%, transparent) 100%);
    }

    .contact__form-wrap {
      padding: var(--sp-4);
    }

    .contact__actions {
      grid-template-columns: 1fr;
    }

    .contact__direct {
      margin-top: var(--sp-5);
    }
  }
</style>
