---
import standardImage from '../../assets/images/services/neoslide/display-types/standard.jpg';
import totemsImage from '../../assets/images/services/neoslide/display-types/totems.jpg';
import menuBoardsImage from '../../assets/images/services/neoslide/display-types/menu-boards.jpg';
import interactiveImage from '../../assets/images/services/neoslide/display-types/interactive.jpg';
import videoWallImage from '../../assets/images/services/neoslide/display-types/video-wall.jpg';
import anySizeImage from '../../assets/images/services/neoslide/display-types/any-size.jpg';
import type { DigitalSignageContent } from '../../i18n/pages/digital-signage';

interface Props { content: DigitalSignageContent['displayTypes'] } const { content } = Astro.props;
const images = [standardImage.src, totemsImage.src, menuBoardsImage.src, interactiveImage.src, videoWallImage.src, anySizeImage.src];
const displayTypes = content.items.map((item, index) => ({ ...item, imageSrc: images[index] }));
---

<section class="section ds-display-types" aria-labelledby="display-types-heading">
    <div class="container ds-display-types__container">
        <header class="section__header ds-display-types__intro">
            <div class="ds-display-types__heading">
                <p class="section-label">{content.label}</p>

                <h2 class="section-headline ds-display-types__headline" id="display-types-heading">
                    {content.heading}
                </h2>
            </div>

            <div class="ds-display-types__lead-wrap">
                <p class="section-copy ds-display-types__lead">
                    {content.copy}
                </p>
            </div>
        </header>

        <div class="ds-display-types__grid" aria-label={content.gridAriaLabel}>
            {
                displayTypes.map((displayType, index) => (
                    <article class="ds-display-types__card u-border-interactive">
                        <figure class="ds-display-types__media">
                            <img
                                src={displayType.imageSrc}
                                alt={displayType.imageAlt}
                                loading={index === 0 ? 'eager' : 'lazy'}
                                decoding="async"
                                class="ds-display-types__image"
                            />
                        </figure>

                        <div class="ds-display-types__details">
                            <span class="ds-display-types__counter" aria-hidden="true">
                                {displayType.counter}
                            </span>

                            <div class="ds-display-types__text">
                                <h3 class="ds-display-types__title">
                                    {displayType.title}
                                </h3>
                                <p class="ds-display-types__description">
                                    {displayType.description}
                                </p>
                                <ul class="ds-display-types__chips" aria-label={`${displayType.title} ${content.tagsSuffix}`}>
                                    {displayType.badge.split(' · ').map((chip) => (
                                        <li class="ds-display-types__chip">{chip}</li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .ds-display-types {
        background: var(--bg);
        border-bottom: 1px solid var(--border-color);
    }

    .ds-display-types__container {
        display: grid;
        gap: var(--sp-8);
    }

    .ds-display-types__intro {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sp-6);
        align-items: start;
        margin-bottom: 0;
    }

    .ds-display-types__heading {
        display: grid;
        gap: var(--sp-3);
    }

    .ds-display-types__headline,
    .ds-display-types__lead{
        margin: 0;
    }

    .ds-display-types__lead-wrap {
        display: grid;
        gap: var(--sp-3);
        align-self: end;
        max-width: 58ch;
    }

    .ds-display-types__small {
        display: block;
        margin-top: 0.15rem;
        color: var(--text-secondary);
    }

    .ds-display-types__grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: var(--sp-4);
        align-items: stretch;
    }

    .ds-display-types__card {
        display: grid;
        grid-template-rows: auto 1fr;
        padding: 0;
        border-radius: var(--radius-lg);
        background: var(--surface);
        height: 100%;
        overflow: hidden;
    }

    .ds-display-types__media {
        width: 100%;
        margin: 0;
        aspect-ratio: 16 / 9;
        overflow: hidden;
    }

    .ds-display-types__image {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease-out;
    }

    .ds-display-types__card:hover .ds-display-types__image,
    .ds-display-types__card:focus-within .ds-display-types__image {
        transform: scale(1.04);
    }

    .ds-display-types__details {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        gap: var(--sp-4);
        padding: var(--sp-5);
        align-items: start;
        align-content: start;
    }

    .ds-display-types__counter {
        font-family: var(--font-mono);
        color: var(--color-brand);
        font-size: clamp(1rem, 0.9rem + 0.35vw, 1.25rem);
        font-weight: 600;
        line-height: 1;
        letter-spacing: 0.08em;
    }

    .ds-display-types__text {
        display: grid;
        gap: var(--sp-2);
        align-content: start;
    }

    .ds-display-types__title,
    .ds-display-types__description {
        margin: 0;
    }

    .ds-display-types__chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: var(--sp-2) 0 0;
        padding: 0;
        list-style: none;
    }

    .ds-display-types__chip {
        display: inline-flex;
        align-items: center;
        min-height: 2rem;
        padding: 0.3rem 0.7rem;
        border: 1px solid color-mix(in srgb, var(--color-brand) 55%, transparent);
        border-radius: 999px;
        color: var(--color-brand);
        font-family: var(--font-body);
        font-size: var(--text-sm);
        line-height: 1.2;
        background: color-mix(in srgb, var(--color-brand) 8%, transparent);
    }

    .ds-display-types__title {
        font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.25rem);
        line-height: 1.2;
    }

    .ds-display-types__description {
        color: var(--text-secondary);
        font-size: var(--text-sm);
        line-height: 1.55;
    }

    @media (max-width: 1024px) {
        .ds-display-types__container {
            gap: var(--sp-6);
        }

        .ds-display-types__intro {
            grid-template-columns: 1fr;
        }

        .ds-display-types__lead-wrap {
            max-width: 65ch;
        }

        .ds-display-types__grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--sp-4);
        }

        .ds-display-types__details {
            gap: var(--sp-3);
        }
    }

    @media (max-width: 640px) {
        .ds-display-types__grid {
            grid-template-columns: 1fr;
        }

        .ds-display-types__details {
            gap: var(--sp-3);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .ds-display-types__image {
            transition: none;
        }

        .ds-display-types__card:hover .ds-display-types__image,
        .ds-display-types__card:focus-within .ds-display-types__image {
            transform: none;
        }
    }
</style>
