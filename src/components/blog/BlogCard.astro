---
import ProgressiveImage from '../atoms/ProgressiveImage.astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import arrowForwardRaw from '../../assets/vectors/icons/material/custom/arrow_forward-300w.svg?raw';
import { getLocalizedPath } from '../../i18n/utils';
import { getImageOutputWidth, getResponsiveImageWidths } from '../../utils/images';
type EditorialEntry = CollectionEntry<'blog'> | CollectionEntry<'news'>;
interface Props { post: EditorialEntry }
const { post } = Astro.props;
const slug = post.id.split('/')[0];
const section = post.collection;
const imageTransitionName = `editorial-image-${section}-${slug}`;
const href = getLocalizedPath(`/${section === 'blog' ? 'use-cases' : section}/${slug}/`, post.data.lang);
const ctaLabel = post.data.lang === 'mk' ? 'Дознај повеќе' : 'Find out more';
const arrowIcon = arrowForwardRaw
  .replace('fill="CurrentColor"', 'fill="currentColor"')
  .replace('<svg ', '<svg class="blog-card__arrow-svg" ');
---
<article class="blog-card u-border-interactive">
  <a class="blog-card__link" href={href}>
    <div class="blog-card__media" data-progressive-host="relative"><ProgressiveImage src={post.data.cover}><Image class="blog-card__image" style={`view-transition-name: ${imageTransitionName}`} src={post.data.cover} alt={post.data.coverAlt} widths={getResponsiveImageWidths(post.data.cover)} width={getImageOutputWidth(post.data.cover)} sizes="(max-width: 48rem) 100vw, (max-width: 64rem) 50vw, 33vw" loading="lazy" /></ProgressiveImage></div>
    <div class="blog-card__body">
      <h2 class="blog-card__title">{post.data.title}</h2>
      <p class="blog-card__description">{post.data.description}</p>
      <span class="blog-card__cta">
        {ctaLabel}
        <span class="blog-card__arrow" aria-hidden="true" set:html={arrowIcon} />
      </span>
    </div>
  </a>
</article>
