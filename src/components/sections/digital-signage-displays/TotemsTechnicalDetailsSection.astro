---
import ShelfLabelsDsCard from '../../atoms/ShelfLabelsDsCard.astro';
import SectionTitleGroup from '../../molecules/SectionTitleGroup.astro';
import iconScreenSizes from '../../../assets/vectors/icons/shelf-labels/ico_screen-sizes.svg?raw';
import totemsDisplayImage from '../../../assets/images/services/neoslide/display-types/totems.jpg';
import type { TotemsContent } from '../../../i18n/pages/digital-signage-displays/totems';

interface Props {
  content: TotemsContent['technicalDetails'];
  iconSet?: 'totems' | 'interactive-displays';
}

const { content, iconSet = 'totems' } = Astro.props;
const totemsSpecificationIconModules = import.meta.glob<string>(
  '../../../assets/vectors/icons/totems/totem-specification-icons/*.svg',
  { query: '?raw', import: 'default' },
);
const interactiveDisplaysHardwareIconModules = import.meta.glob<string>(
  '../../../assets/vectors/icons/interactive-displays/interactive-hardware/*.svg',
  { query: '?raw', import: 'default' },
);
const specificationIconNames = iconSet === 'totems'
  ? [
      'screen-brightness',
      'connectivity-ports',
      'power-operating-costs',
      'operating-system-compatibility',
      'touch-technology',
    ]
  : [
      'touch-technology',
      'computing-software',
      'connectivity-peripherals',
      'visibility-durability',
      'mounting-accessibility',
    ];
const specificationIconModules = iconSet === 'totems'
  ? totemsSpecificationIconModules
  : interactiveDisplaysHardwareIconModules;
const specificationIconDirectory = iconSet === 'totems'
  ? 'totems/totem-specification-icons'
  : 'interactive-displays/interactive-hardware';
const loadSpecificationIcon = async (name: string) => {
  const iconPath = `../../../assets/vectors/icons/${specificationIconDirectory}/${name}.svg`;
  const loadIcon = specificationIconModules[iconPath];

  if (!loadIcon) {
    throw new Error(`Missing ${iconSet} technical specification icon: ${name}`);
  }

  return (await loadIcon()).replace(/^<\?xml[^>]*>\s*/, '');
};
const replacementIcons = await Promise.all(specificationIconNames.map(loadSpecificationIcon));
const featureIcons = [
  iconScreenSizes.replace(/^<\?xml[^>]*>\s*/, ''),
  ...replacementIcons,
];

if (featureIcons.length !== content.features.length) {
  throw new Error('Digital totems technical feature icons must match the feature count.');
}

const features = content.features.map((feature, index) => {
  const icon = featureIcons[index];

  if (!icon) {
    throw new Error(`Missing digital totems technical feature icon at index ${index}.`);
  }

  return { ...feature, icon };
});
---

<section class="section totems-technical" aria-labelledby="totems-technical-heading">
  <div class="container totems-technical__frame u-section-title-stack">
    <SectionTitleGroup
      class="totems-technical__intro"
      label={content.label}
      heading={content.heading}
      headingId="totems-technical-heading"
      headlineWidth="22ch"
      titleWidth="58%"
      copy={content.copy}
    />

    <div class="totems-technical__body">
      <div class="totems-technical__cards" aria-label={content.listAriaLabel}>
        {features.map((feature) => (
          <div class="totems-technical__card">
            <ShelfLabelsDsCard title={feature.title} text={feature.text}>
              <span slot="icon" set:html={feature.icon} />
            </ShelfLabelsDsCard>
          </div>
        ))}
      </div>

      <div class="totems-technical__image">
        <img
          src={totemsDisplayImage.src}
          alt={content.imageAlt}
          width={totemsDisplayImage.width}
          height={totemsDisplayImage.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .totems-technical {
    background: var(--bg);
    border-bottom: 1px solid var(--border-color);
  }

  .totems-technical__frame {
    margin-block: var(--sp-10);
  }

  .totems-technical__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: stretch;
  }

  .totems-technical__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--sp-4);
    width: 100%;
  }

  .totems-technical__card {
    display: grid;
    width: 100%;
  }

  .totems-technical__cards :global(.sl-ds-card__icon > span) {
    display: contents;
  }

  .totems-technical__cards :global(.sl-ds-card__icon svg) {
    width: 88%;
    height: 88%;
  }

  .totems-technical__image {
    display: grid;
    min-width: 0;
    align-items: center;
  }

  .totems-technical__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  @media (max-width: 1024px) {
    .totems-technical__cards {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
    }
  }

  @media (max-width: 884px) {
    .totems-technical__body {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }

    .totems-technical__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .totems-technical__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
