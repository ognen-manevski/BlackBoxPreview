---
import logoDarkPoster from '../../assets/images/video-thumbnails/bg-videos/3D-Logo.jpg';
import type { HomePageContent } from '../../i18n/pages/home';
import { getOptimizedImageUrl } from '../../utils/images';

interface Props { content: HomePageContent['about']; }
const { content } = Astro.props;
const optimizedPoster = await getOptimizedImageUrl(logoDarkPoster, 1600);
---

<section class="section about" aria-labelledby="about-who-we-are-heading">
  <div class="container">
    <div class="about__grid">
      <div class="about__content">
        <div class="about__heading">
          <p class="section-label">{content.whoWeAreEyebrow}</p>
          <h2 class="section-headline about__headline" id="about-who-we-are-heading">
            {content.whoWeAreHeading}
          </h2>
        </div>
        <p class="section-copy about__lead">
          {content.whoWeAreCopy1}
        </p>
        <p class="section-copy about__lead">
          {content.whoWeAreCopy2}
        </p>
      </div>

      <div class="about__media">
        <video
          class="about__video"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster={optimizedPoster}
          aria-label={content.videoAriaLabel}
        >
          <source src={`${import.meta.env.BASE_URL}videos/bg-videos/3D-Logo.mp4`} type="video/mp4" />
        </video>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background: var(--bg);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--sp-6);
    align-items: center;
  }

  .about__content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .about__heading {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .about__heading .section-label {
    margin-bottom: 0;
  }

  .about__headline {
    max-width: 24ch;
    text-wrap: balance;
  }

  .about__lead {
    max-width: none;
    text-wrap: pretty;
  }

  .about__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
  }

  .about-card {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    background: var(--surface, var(--bg-secondary));
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    min-height: 100%;
  }

  .about-card__svg {
    width: 1.35rem;
    height: 1.35rem;
    display: block;
  }

  .about-card__svg :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .about-card__title {
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .about-card__text {
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .about__media {
    position: relative;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg-secondary) 80%, var(--bg)) 0%, var(--bg) 100%);
    min-height: clamp(18rem, 30vw, 28rem);
  }

  .about__video {
    display: block;
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 1100px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__video {
      max-height: 24rem;
    }
  }

  @media (max-width: 480px) {
    .about__media {
      min-height: 20rem;
    }
  }
</style>
