---
import PhoneIcon from '../icons/PhoneIcon.astro';
import MailIcon from '../icons/MailIcon.astro';
import SubscribeField from '../atoms/SubscribeField.astro';
import ContactForm from './ContactForm.astro';
import ContactDetailItem from '../atoms/ContactDetailItem.astro';
import gradient1DarkPoster from '../../assets/images/video-thumbnails/gradients/dark/gradient-1-grain-0.jpg';
import { getOptimizedImageUrl } from '../../utils/images';
import type { HomePageContent } from '../../i18n/pages/home';
import { commonTranslations } from '../../i18n/common';
import { getLocaleFromUrl, getLocalizedPath, getTranslations } from '../../i18n/utils';
interface Props { content: HomePageContent['contact']; }
const { content } = Astro.props;
const optimizedPoster = await getOptimizedImageUrl(gradient1DarkPoster, 1600);
const common = getTranslations(commonTranslations, getLocaleFromUrl(Astro.url));
const privacyHref = getLocalizedPath('/privacy-policy/', getLocaleFromUrl(Astro.url));
---

<section class="section contact" id="contact" aria-labelledby="contact-heading">
  <video
    class="contact__bg-video"
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    poster={optimizedPoster}
    aria-hidden="true"
  >
    <source src={`${import.meta.env.BASE_URL}videos/gradients/dark/base-gradient-1.mp4`} type="video/mp4" media="(min-width: 641px)" />
  </video>
  <div class="contact__bg-overlay" aria-hidden="true"></div>

  <div class="container contact__inner">
    <div class="contact__content">
      <p class="section-label">{content.label}</p>
      <h2 class="section-headline contact__headline" id="contact-heading">
        {content.heading}
      </h2>
      <p class="section-copy contact__copy">
        {content.copy}
      </p>

      <div class="contact__subscribe-wrap">
        <h3 class="section-label">{common.footer.newsletter}</h3>
        <SubscribeField
          class="contact__subscribe"
          buttonLabel={content.subscribe}
          label={content.emailLabel}
          placeholder={content.emailPlaceholder}
          privacyId="contact-subscribe-consent"
          privacyText={content.subscribeConsent}
          privacyLinkText={content.privacyPolicy}
          privacyLinkHref={privacyHref}
        />
      </div>

      <div class="contact__direct" aria-label={content.directAriaLabel}>
        <ContactDetailItem
          class="contact__direct-item"
          label={content.phoneLabel}
          value="+389 75 444 908"
          href="tel:+38975444908"
          iconStyle="--icon-badge-size: 2rem; --icon-badge-border: color-mix(in srgb, var(--border-color) 72%, var(--color-brand)); --icon-badge-bg: var(--icon-bg); --icon-badge-color: var(--color-brand);"
        >
          <PhoneIcon slot="icon" />
        </ContactDetailItem>

        <ContactDetailItem
          class="contact__direct-item"
          label={content.emailDirectLabel}
          value="contact@blackboxsolutions.mk"
          href="mailto:contact@blackboxsolutions.mk"
          iconStyle="--icon-badge-size: 2rem; --icon-badge-border: color-mix(in srgb, var(--border-color) 72%, var(--color-brand)); --icon-badge-bg: var(--icon-bg); --icon-badge-color: var(--color-brand);"
        >
          <MailIcon slot="icon" />
        </ContactDetailItem>
      </div>
    </div>

    <ContactForm content={content} />
  </div>
</section>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    background: var(--bg);
  }

  .contact__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    transition: opacity var(--t-base);
  }

  .contact__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--bg) 70%, transparent) 0%, color-mix(in srgb, var(--bg) 24%, transparent) 70%, color-mix(in srgb, var(--bg) 35%, transparent) 100%);
    z-index: 1;
  }

  .contact__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--sp-8);
    align-items: start;
    position: relative;
    z-index: 2;
  }

  .contact__content {
    display: grid;
    gap: var(--sp-4);
    max-width: 42rem;
  }

  .contact__headline {
    max-width: 18ch;
  }

  .contact__copy {
    max-width: 58ch;
  }

  .contact__subscribe-wrap {
    margin-top: var(--sp-6);
    display: grid;
    gap: var(--sp-3);
    max-width: 34rem;
  }

  .contact__direct {
    margin-top: var(--sp-7);
    display: grid;
    gap: var(--sp-4);
    max-width: 20rem;
  }

  .contact__direct-item {
    align-items: center;
  }

  @media (max-width: 1100px) {
    .contact__inner {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .contact__content,
    .contact__headline,
    .contact__copy,
    .contact__subscribe-wrap,
    .contact__direct {
      max-width: none;
    }
  }

  @media (max-width: 700px) {
    .contact__bg-overlay {
      background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 62%, transparent) 0%, color-mix(in srgb, var(--bg) 34%, transparent) 100%);
    }

    .contact__direct {
      margin-top: var(--sp-5);
    }
  }
</style>
