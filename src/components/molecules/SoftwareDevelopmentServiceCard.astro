---
interface Props {
    counter: string;
    title: string;
    description: string;
}

const { counter, title, description } = Astro.props as Props;
---

<article class="sd-service-card u-border-interactive">
    <div class="sd-service-card__details">
        <div class="sd-service-card__content">
            <span class="sd-service-card__counter" aria-hidden="true">
                {counter}
            </span>
            <h3 class="sd-service-card__title">{title}</h3>
            <p class="sd-service-card__description">{description}</p>
        </div>

        <div class="sd-service-card__visual-wrap" aria-hidden="true">
            <div class="sd-service-card__visual-frame">
                <div class="sd-service-card__visual">
                    <slot name="visual" />
                </div>
            </div>
        </div>

    </div>
</article>

<style>
    .sd-service-card {
        display: flex;
        border-radius: var(--radius-lg);
        background: var(--surface);
        padding: var(--sp-5);
        height: 100%;
    }

    .sd-service-card__details {
        width: 100%;
        min-width: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(8.5rem, 13rem);
        gap: var(--sp-5);
        align-items: center;
    }

    .sd-service-card__content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: var(--sp-3);
    }

    .sd-service-card__visual-wrap {
        display: flex;
        justify-content: flex-end;
        align-items: center;
    }

    .sd-service-card__visual-frame {
        width: min(100%, 13rem);
        aspect-ratio: 1 / 1;
        border-radius: var(--radius);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: var(--icon-bg);
        color: var(--color-brand);
        border: 1px solid var(--color-brand);
        overflow: hidden;

    }

    .sd-service-card__visual:empty,
    .sd-service-card__visual-frame:has(.sd-service-card__visual:empty),
    .sd-service-card__visual-wrap:has(.sd-service-card__visual:empty) {
        display: none;
    }

    .sd-service-card__visual {
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .sd-service-card__counter {
        font-family: var(--font-mono);
        color: var(--color-brand);
        font-size: clamp(1rem, 0.9rem + 0.35vw, 1.25rem);
        font-weight: 600;
        line-height: 1;
        letter-spacing: 0.08em;
        flex: 0 0 auto;
    }

    .sd-service-card__title {
        margin: 0;
        font-size: var(--text-lg);
        /* line-height: 1.2; */
    }

    .sd-service-card__description {
        margin: 0;
    }

    .sd-service-card__description {
        color: var(--text-secondary);
        /* font-size: var(--text-sm); */
        line-height: 1.55;
    }

    .sd-service-card__visual :global(svg),
    .sd-service-card__visual :global(img) {
        width: 100%;
        height: auto;
        display: block;
    }

    @media (max-width: 1024px) {
        .sd-service-card {
            padding: var(--sp-4);
        }

        .sd-service-card__details {
            grid-template-columns: minmax(0, 1fr) minmax(7.5rem, 10rem);
            gap: var(--sp-4);
        }
    }

    @media (max-width: 640px) {
        .sd-service-card {
            padding: var(--sp-4);
        }

        .sd-service-card__details {
            grid-template-columns: 1fr;
            gap: var(--sp-4);
        }

        .sd-service-card__visual-wrap {
            justify-content: flex-start;
        }

        .sd-service-card__visual-frame {
            width: min(100%, 11rem);
        }
    }
</style>
