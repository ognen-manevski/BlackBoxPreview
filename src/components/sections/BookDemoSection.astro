---
import IconBadge from '../atoms/IconBadge.astro';
import Checkmark from '../atoms/Checkmark.astro';
import LeadForm from './LeadForm.astro';
import gradient1DarkPoster from '../../assets/images/video-thumbnails/gradients/dark/gradient-1-grain-0.jpg';
import { getOptimizedImageUrl } from '../../utils/images';
import { demoContent } from '../../i18n/pages/demo';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/types';

interface Props {
  defaultService?: string;
  lang: Lang;
}

const { lang, defaultService = '' } = Astro.props as Props;
const demoTranslations = getTranslations(demoContent, lang);
const content = demoTranslations.compact;
const interestGroups = demoTranslations.interestGroups;
const normalizedDefaultService = defaultService.trim().toLowerCase();
const defaultInterestByService: Record<string, string> = {
  'digital signage': 'Digital Signage Platform',
  'digital signage platform': 'Digital Signage Platform',
  'digital totems': 'Totems',
  totems: 'Totems',
  'интерактивни екрани': 'Interactive Displays',
  'интерактивни дисплеи': 'Interactive Displays',
  'interactive displays': 'Interactive Displays',
  'electronic shelf labels': 'Electronic Shelf Labels',
  'електронски ценовни етикети': 'Electronic Shelf Labels',
  'video streaming': 'Video Streaming Platform',
  'видео стриминг': 'Video Streaming Platform',
  'video streaming platform': 'Video Streaming Platform',
  'custom software': 'Custom Software',
  'сопствен софтвер': 'Custom Software',
  'дигитални тотеми': 'Totems',
};
const selectedDefaultInterest = defaultInterestByService[normalizedDefaultService];
const selectedInterestValues = selectedDefaultInterest ? [selectedDefaultInterest] : [];
const optimizedPoster = await getOptimizedImageUrl(gradient1DarkPoster, 1600);
---

<section
  class="section book-demo"
  id="book-demo"
  aria-labelledby="book-demo-heading"
  data-book-demo
  data-default-service={defaultService}
>
  <video
    class="book-demo__bg-video"
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    poster={optimizedPoster}
    aria-hidden="true"
  >
    <source src={`${import.meta.env.BASE_URL}videos/gradients/dark/base-gradient-1.mp4`} type="video/mp4" media="(min-width: 641px)" />
  </video>
  <div class="book-demo__bg-overlay" aria-hidden="true"></div>

  <div class="container book-demo__inner">
    <div class="book-demo__content">
      <p class="section-label">{content.label}</p>
      <h2 class="section-headline book-demo__headline" id="book-demo-heading">
        {content.heading}
      </h2>
      <p class="section-copy book-demo__copy">
        {content.copy}<br>{content.copySecondLine}
      </p>

      <ul class="book-demo__benefits" aria-label={content.benefitsAriaLabel}>
        <li class="book-demo__benefit-item">
          <IconBadge
            class="book-demo__benefit-icon"
            style="--icon-badge-size: 1.5rem; --icon-badge-border: var(--border-color); --icon-badge-bg: color-mix(in srgb, var(--bg-secondary) 75%, var(--bg)); --icon-badge-color: var(--color-brand);"
          >
            <Checkmark />
          </IconBadge>
          <span>{content.benefits[0]}</span>
        </li>
        <li class="book-demo__benefit-item">
          <IconBadge
            class="book-demo__benefit-icon"
            style="--icon-badge-size: 1.5rem; --icon-badge-border: var(--border-color); --icon-badge-bg: color-mix(in srgb, var(--bg-secondary) 75%, var(--bg)); --icon-badge-color: var(--color-brand);"
          >
            <Checkmark />
          </IconBadge>
          <span>{content.benefits[1]}</span>
        </li>
        <li class="book-demo__benefit-item">
          <IconBadge
            class="book-demo__benefit-icon"
            style="--icon-badge-size: 1.5rem; --icon-badge-border: var(--border-color); --icon-badge-bg: color-mix(in srgb, var(--bg-secondary) 75%, var(--bg)); --icon-badge-color: var(--color-brand);"
          >
            <Checkmark />
          </IconBadge>
          <span>{content.benefits[2]}</span>
        </li>
      </ul>
    </div>

    <div class="book-demo__form-wrap u-border-interactive">
      <h3 class="book-demo__form-title">
        {content.formTitleStart}<span class="book-demo__service-name" data-demo-service>{defaultService}</span>{content.formTitleEnd}
      </h3>

      <LeadForm
        variant="compact-demo"
        content={content}
        interestGroups={interestGroups}
        checkedValues={selectedInterestValues}
        lang={lang}
      />
    </div>
  </div>
</section>

<script>
  const requestedIntent = new URLSearchParams(window.location.search).get('interest');
  if (requestedIntent) {
    document.querySelectorAll<HTMLInputElement>('input[data-service-intent]:not([data-service-intent=""])').forEach(input => {
      const intents = input.dataset.serviceIntent?.split(/\s+/) ?? [];
      if (intents.includes(requestedIntent)) {
        input.checked = true;
      }
    });
  }

  const demoSections = document.querySelectorAll('[data-book-demo]');

  demoSections.forEach(section => {
    const serviceSlot = section.querySelector('[data-demo-service]');
    const checkboxes = Array.from(section.querySelectorAll<HTMLInputElement>('input[name="services"]'));
    const titleOptions = checkboxes.filter(input => input.hasAttribute('data-demo-title-option'));
    const defaultService = section.getAttribute('data-default-service') || '';

    const updateTitle = () => {
      const selected = titleOptions.find(input => input.matches(':checked'));
      const serviceName = selected?.dataset.demoTitleLabel || defaultService;

      if (serviceSlot) {
        serviceSlot.textContent = serviceName;
      }
    };

    checkboxes.forEach(input => {
      input.addEventListener('change', updateTitle);
    });

    updateTitle();
  });
</script>

<style>
  .book-demo {
    position: relative;
    overflow: hidden;
    background: var(--bg);
  }

  .book-demo__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
    transition: opacity var(--t-base);
  }

  .book-demo__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--bg) 70%, transparent) 0%,
      color-mix(in srgb, var(--bg) 24%, transparent) 70%,
      color-mix(in srgb, var(--bg) 35%, transparent) 100%
      );
    z-index: 1;
  }

  .book-demo__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--sp-8);
    align-items: start;
  }

  .book-demo__content {
    display: grid;
    gap: var(--sp-4);
    max-width: 44rem;
  }

  .book-demo__headline {
    max-width: 16ch;
  }

  .book-demo__copy {
    max-width: 62ch;
  }

  .book-demo__benefits {
    margin: var(--sp-4) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-3);
  }

  .book-demo__benefit-item {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--text-primary);
    font-size: var(--text-base);
  }

  .book-demo__benefit-icon {
    flex-shrink: 0;
  }

  .book-demo__form-wrap {
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    padding: var(--sp-6);
    display: grid;
    gap: var(--sp-5);
  }

  .book-demo__form-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .book-demo__service-name {
    color: var(--color-brand);
  }

  @media (max-width: 1024px) {
    .book-demo__inner {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .book-demo__headline {
      max-width: 20ch;
    }
  }

  @media (max-width: 640px) {
    .book-demo__form-wrap {
      padding: var(--sp-5);
    }

  }

  @media (max-width: 300px) {
    .book-demo__form-wrap {
      padding: var(--sp-3);
      gap: var(--sp-3);
    }

    .book-demo__form-title {
      font-size: var(--text-md);
      line-height: 1.15;
      overflow-wrap: anywhere;
    }

  }

  @media (max-width: 400px) {
    .book-demo__headline {
      font-size: clamp(1.35rem, 7vw, 2rem);
      line-height: 1.15;
    }
  }
</style>
