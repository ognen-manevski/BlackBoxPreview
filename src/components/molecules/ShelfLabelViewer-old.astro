---
interface Props {
  initialColor?: "white" | "black" | "wood";
}

const { initialColor = "white" } = Astro.props;
import placeholderOutlineSvg from "../../assets/vectors/illustrations/shelf-labels/3d-label-placeholder-outline.svg?raw";
---

<div
  class="shelf-label-viewer"
  data-shelf-label-viewer
  data-initial-color={initialColor}
>
  <div class="shelf-label-viewer__blue-glow" aria-hidden="true"></div>
  <canvas aria-label="Interactive 3D shelf label model"></canvas>

  <div class="shelf-label-viewer__loading" data-model-loading>
    <div
      class="shelf-label-viewer__placeholder"
      aria-hidden="true"
      set:html={placeholderOutlineSvg}
    ></div>
    <p class="shelf-label-viewer__status" data-model-status>Loading model…</p>
  </div>
</div>

<script>
  import * as THREE from "three";
  import { MeshoptDecoder } from "meshoptimizer/decoder";
  import { DRACOLoader } from "three/examples/jsm/loaders/DRACOLoader.js";
  import {
    GLTFLoader,
    type GLTF,
  } from "three/examples/jsm/loaders/GLTFLoader.js";
  import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";

  const BASE_URL = import.meta.env.BASE_URL;

  function initShelfLabelViewer(
    container: HTMLElement,
    signal: AbortSignal,
  ): void {
    const canvas = container.querySelector("canvas");
    const status = container.querySelector<HTMLElement>("[data-model-status]");
    const loadingOverlay = container.querySelector<HTMLElement>(
      "[data-model-loading]",
    );

    if (!(canvas instanceof HTMLCanvasElement)) return;

    const MODEL_ROTATION_X = 86 * (Math.PI / 180);
    const VIDEO_ASPECT = 1000 / 700;
    const CAMERA_FIT_X = 0;
    const CAMERA_FIT_Y = 0;
    const CAMERA_FIT_Z = 1;
    const EMITTER_BLINK_SPEED = 0.5;
    const EMITTER_MIN_INTENSITY = 0;
    const EMITTER_MAX_INTENSITY = 10.0;
    const initialColor =
      (container.getAttribute("data-initial-color") as
        "white" | "black" | "wood" | null) ?? "white";

    const scene = new THREE.Scene();
    const video = document.createElement("video");
    video.src = `${BASE_URL}videos/shelf-labels/product-features-loop.mp4`;
    video.loop = true;
    video.muted = true;
    video.playsInline = true;
    video.autoplay = true;
    video.preload = "auto";
    video.crossOrigin = "anonymous";
    video.load();

    const videoTexture = new THREE.VideoTexture(video);
    videoTexture.colorSpace = THREE.SRGBColorSpace;
    videoTexture.minFilter = THREE.LinearFilter;
    videoTexture.magFilter = THREE.LinearFilter;
    videoTexture.generateMipmaps = false;
    videoTexture.flipY = true;

    const camera = new THREE.PerspectiveCamera(35, 1, 0.01, 100);
    camera.position.set(0, 0.8, 4);

    const renderer = new THREE.WebGLRenderer({
      canvas,
      antialias: true,
      alpha: true,
    });

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1;

    scene.add(new THREE.HemisphereLight(0xffffff, 0x444444, 2.5));

    const keyLight = new THREE.DirectionalLight(0xffffff, 5);
    keyLight.position.set(3, 4, 5);
    scene.add(keyLight);

    //blue
    const styles = getComputedStyle(document.documentElement);
    const lightColor = styles.getPropertyValue("--color-aurora").trim();

    const blueLightColor = new THREE.Color(lightColor);

    const blueLight = new THREE.DirectionalLight(blueLightColor, 2);
    blueLight.position.set(0, -3, 0);
    scene.add(blueLight);

    const fillLight = new THREE.DirectionalLight(0xffffff, 2);
    fillLight.position.set(-4, 1, 2);
    scene.add(fillLight);

    const controls = new OrbitControls(camera, canvas);

    controls.enableDamping = true;
    controls.dampingFactor = 0.08;

    // Drag with mouse or one finger.
    controls.enableRotate = true;

    // Disable zooming and panning for this first test.
    controls.enableZoom = false;
    controls.enablePan = false;

    controls.rotateSpeed = 0.7;
    controls.target.set(0, 0, 0);

    const loader = new GLTFLoader();
    const dracoLoader = new DRACOLoader();

    dracoLoader.setDecoderPath(`${BASE_URL}draco/`);
    loader.setDRACOLoader(dracoLoader);
    loader.setMeshoptDecoder(MeshoptDecoder);

    const textureLoader = new THREE.TextureLoader();
    const woodTexture = textureLoader.load(`${BASE_URL}models/shelf-label/wood.png`);
    woodTexture.wrapS = THREE.ClampToEdgeWrapping;
    woodTexture.wrapT = THREE.ClampToEdgeWrapping;
    woodTexture.repeat.set(1, 1);
    woodTexture.colorSpace = THREE.SRGBColorSpace;
    woodTexture.flipY = false;
    woodTexture.anisotropy = 1;

    let model: THREE.Object3D | undefined;
    let animationFrame = 0;
    let screenVideoPlane: THREE.Mesh | undefined;
    const emitterMaterials: Array<
      | THREE.MeshStandardMaterial
      | THREE.MeshPhysicalMaterial
      | THREE.MeshBasicMaterial
    > = [];

    const ensureUv = (geometry: THREE.BufferGeometry): void => {
      if (geometry.getAttribute("uv")) return;

      geometry.computeBoundingBox();

      const boundingBox = geometry.boundingBox;
      if (!boundingBox) return;

      const position = geometry.getAttribute("position");
      if (!position || !("getX" in position)) return;

      const size = boundingBox.getSize(new THREE.Vector3());
      const axes = [
        { axis: "x", size: size.x },
        { axis: "y", size: size.y },
        { axis: "z", size: size.z },
      ].sort((left, right) => right.size - left.size);

      const uAxis = axes[0].axis as "x" | "y" | "z";
      const vAxis = axes[1].axis as "x" | "y" | "z";
      const uRange = boundingBox.max[uAxis] - boundingBox.min[uAxis] || 1;
      const vRange = boundingBox.max[vAxis] - boundingBox.min[vAxis] || 1;
      const uv = new Float32Array(position.count * 2);

      for (let index = 0; index < position.count; index += 1) {
        const x = position.getX(index);
        const y = position.getY(index);
        const z = position.getZ(index);
        const coordinates = { x, y, z };

        uv[index * 2] = (coordinates[uAxis] - boundingBox.min[uAxis]) / uRange;
        uv[index * 2 + 1] =
          (coordinates[vAxis] - boundingBox.min[vAxis]) / vRange;
      }

      geometry.setAttribute("uv", new THREE.BufferAttribute(uv, 2));
    };

    const applyBodyColor = (color: "white" | "black" | "wood"): void => {
      if (!model) return;

      model.traverse((object: THREE.Object3D) => {
        if (!(object instanceof THREE.Mesh)) return;

        const materials = Array.isArray(object.material)
          ? object.material
          : [object.material];

        for (const material of materials) {
          if (material.name === "Plastic-White") {
            material.visible = true;

            if (
              material instanceof THREE.MeshStandardMaterial ||
              material instanceof THREE.MeshPhysicalMaterial ||
              material instanceof THREE.MeshBasicMaterial
            ) {
              material.transparent = false;
              material.opacity = 1;
              material.vertexColors = false;

              if (color === "black") {
                material.map = null;
                material.color.set(0x121212);
                if (
                  material instanceof THREE.MeshStandardMaterial ||
                  material instanceof THREE.MeshPhysicalMaterial
                ) {
                  material.roughness = 0.7;
                  material.metalness = 0.05;
                  material.envMapIntensity = 0;
                  material.emissiveMap = null;
                  material.emissive.set(0x000000);
                  material.emissiveIntensity = 1;
                }
              } else if (color === "wood") {
                ensureUv(object.geometry);
                material.map = woodTexture;
                material.color.set(0xffffff);
                if (
                  material instanceof THREE.MeshStandardMaterial ||
                  material instanceof THREE.MeshPhysicalMaterial
                ) {
                  material.roughness = 1;
                  material.metalness = 0.7;
                  material.envMapIntensity = 0;
                  material.emissiveMap = woodTexture;
                  material.emissive.set(0xffa500);
                  material.emissiveIntensity = 0.2;
                }
              } else {
                material.map = null;
                material.color.set(0xd7d7d7);
                if (
                  material instanceof THREE.MeshStandardMaterial ||
                  material instanceof THREE.MeshPhysicalMaterial
                ) {
                  material.roughness = 0.45;
                  material.metalness = 0;
                  material.envMapIntensity = 0;
                  material.emissiveMap = null;
                  material.emissive.set(0x000000);
                  material.emissiveIntensity = 1;
                }
              }

              material.needsUpdate = true;
            }
          } else if (material.name === "Plastic-Black") {
            material.visible = false;
          } else if (material.name === "Plastic-Wood") {
            material.visible = false;
          } else if (
            material.name === "back-label-black" ||
            material.name === "barcode"
          ) {
            if (
              material instanceof THREE.MeshStandardMaterial ||
              material instanceof THREE.MeshPhysicalMaterial ||
              material instanceof THREE.MeshBasicMaterial
            ) {
              // These textures are alpha masks, so tint color controls visible ink.
              material.color.set(color === "black" ? 0xffffff : 0x000000);
              material.needsUpdate = true;
            }
          }
        }
      });
    };

    const onColorChange = (event: Event): void => {
      if (!(event instanceof CustomEvent)) return;

      const color = event.detail?.color;

      if (color === "white" || color === "black" || color === "wood") {
        applyBodyColor(color);
      }
    };

    document.addEventListener("shelf-label-color-change", onColorChange);

    loader.load(
      `${BASE_URL}models/shelf-label/Label-optimized.gltf`,
      (gltf: GLTF) => {
        model = gltf.scene;
        scene.add(model);

        model.traverse((object: THREE.Object3D) => {
          if (!(object instanceof THREE.Mesh)) return;

          const materials = Array.isArray(object.material)
            ? object.material
            : [object.material];

          for (const material of materials) {
            if (material.name !== "Emitter") continue;

            if (
              material instanceof THREE.MeshStandardMaterial ||
              material instanceof THREE.MeshPhysicalMaterial ||
              material instanceof THREE.MeshBasicMaterial
            ) {
              emitterMaterials.push(material);
            }
          }
        });

        const applyVideoTexture = (): void => {
          if (!model) return;

          model.traverse((object: THREE.Object3D) => {
            if (!(object instanceof THREE.Mesh)) return;

            const originalMaterial = object.material;
            const materials = Array.isArray(originalMaterial)
              ? originalMaterial
              : [originalMaterial];

            const updatedMaterials = materials.map((material) => {
              if (material.name !== "Screen-material") return material;

              if (!screenVideoPlane) {
                object.geometry.computeBoundingBox();

                const boundingBox = object.geometry.boundingBox;

                if (boundingBox) {
                  const size = boundingBox.getSize(new THREE.Vector3());
                  const axes = [
                    { axis: "x", size: size.x },
                    { axis: "y", size: size.y },
                    { axis: "z", size: size.z },
                  ].sort((left, right) => right.size - left.size);

                  const planeWidth = axes[0].size;
                  const planeHeight = axes[1].size;
                  const screenAspect = planeWidth / planeHeight;
                  const videoAspect = VIDEO_ASPECT;

                  const videoPlaneWidth =
                    videoAspect > screenAspect
                      ? planeWidth
                      : planeHeight * videoAspect;
                  const videoPlaneHeight =
                    videoAspect > screenAspect
                      ? planeWidth / videoAspect
                      : planeHeight;

                  screenVideoPlane = new THREE.Mesh(
                    new THREE.PlaneGeometry(1, 1),
                    new THREE.MeshBasicMaterial({
                      map: videoTexture,
                      toneMapped: false,
                      side: THREE.FrontSide,
                    }),
                  );

                  screenVideoPlane.scale.set(
                    videoPlaneWidth,
                    videoPlaneHeight,
                    1,
                  );
                  screenVideoPlane.rotation.x =
                    -MODEL_ROTATION_X - 4 * (Math.PI / 180);
                  screenVideoPlane.position.set(0, 0.001, 0);
                  object.add(screenVideoPlane);
                }
              }

              material.dispose();

              return new THREE.MeshBasicMaterial({
                color: 0xffffff,
                toneMapped: false,
                side: THREE.FrontSide,
              });
            });

            object.material = Array.isArray(originalMaterial)
              ? updatedMaterials
              : updatedMaterials[0];
          });
        };

        const startVideo = (): void => {
          void video.play().catch(() => {
            canvas.addEventListener(
              "pointerdown",
              () => {
                void video.play();
              },
              { once: true },
            );
          });
        };

        if (video.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
          applyVideoTexture();
          startVideo();
        } else {
          video.addEventListener(
            "loadeddata",
            () => {
              applyVideoTexture();
              startVideo();
            },
            { once: true },
          );

          video.load();
        }

        applyBodyColor(initialColor);

        // Determine the real model dimensions.
        const bounds = new THREE.Box3().setFromObject(model);
        const center = bounds.getCenter(new THREE.Vector3());
        const size = bounds.getSize(new THREE.Vector3());

        // Center the model regardless of its Blender origin.
        model.position.sub(center);
        model.rotation.x = MODEL_ROTATION_X;

        const maxDimension = Math.max(size.x, size.y, size.z);

        // Fit the camera to the model automatically.
        const distance =
          maxDimension /
          (2 * Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)));

        camera.position.set(
          distance * CAMERA_FIT_X,
          distance * CAMERA_FIT_Y,
          distance * CAMERA_FIT_Z,
        );

        camera.near = Math.max(maxDimension / 100, 0.001);
        camera.far = maxDimension * 100;
        camera.updateProjectionMatrix();

        controls.target.set(0, 0, 0);
        controls.update();

        if (loadingOverlay) {
          loadingOverlay.style.display = "none";
          loadingOverlay.setAttribute("aria-hidden", "true");
        }
        if (status) status.hidden = true;
      },
      undefined,
      (error: unknown) => {
        console.error("Could not load shelf-label model:", error);

        if (status) {
          status.textContent =
            "The 3D model could not be loaded.";
        }
      },
    );

    const resize = (): void => {
      const width = container.clientWidth;
      const height = container.clientHeight;

      if (width === 0 || height === 0) return;

      renderer.setSize(width, height, false);

      camera.aspect = width / height;
      camera.updateProjectionMatrix();
    };

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(container);
    resize();

    const render = (): void => {
      if (signal.aborted) return;

      const blinkOn =
        Math.sin(
          performance.now() * 0.001 * EMITTER_BLINK_SPEED * Math.PI * 2,
        ) >= 0;
      const pulse = blinkOn ? EMITTER_MAX_INTENSITY : EMITTER_MIN_INTENSITY;

      for (const material of emitterMaterials) {
        if (
          material instanceof THREE.MeshStandardMaterial ||
          material instanceof THREE.MeshPhysicalMaterial
        ) {
          material.emissiveIntensity = pulse;
        }

        if (material instanceof THREE.MeshBasicMaterial) {
          material.opacity = blinkOn ? 1 : 0;
          material.transparent = true;
        }
      }

      controls.update();
      renderer.render(scene, camera);

      animationFrame = requestAnimationFrame(render);
    };

    render();

    signal.addEventListener(
      "abort",
      () => {
        cancelAnimationFrame(animationFrame);
        resizeObserver.disconnect();
        controls.dispose();
        dracoLoader.dispose();
        document.removeEventListener("shelf-label-color-change", onColorChange);
        video.pause();
        video.removeAttribute("src");
        video.load();
        videoTexture.dispose();
        woodTexture.dispose();
        screenVideoPlane?.removeFromParent();
        screenVideoPlane?.geometry.dispose();
        const screenVideoPlaneMaterial = screenVideoPlane?.material;

        if (screenVideoPlaneMaterial) {
          if (Array.isArray(screenVideoPlaneMaterial)) {
            for (const material of screenVideoPlaneMaterial) {
              material.dispose();
            }
          } else {
            screenVideoPlaneMaterial.dispose();
          }
        }

        model?.traverse((object: THREE.Object3D) => {
          if (!(object instanceof THREE.Mesh)) return;

          object.geometry.dispose();

          const materials = Array.isArray(object.material)
            ? object.material
            : [object.material];

          for (const material of materials) {
            for (const value of Object.values(
              material as Record<string, unknown>,
            )) {
              if (value instanceof THREE.Texture) {
                value.dispose();
              }
            }

            material.dispose();
          }
        });

        renderer.dispose();
      },
      { once: true },
    );
  }

  let cleanupController: AbortController | undefined;

  function initialize(): void {
    cleanupController?.abort();
    cleanupController = new AbortController();

    document
      .querySelectorAll<HTMLElement>("[data-shelf-label-viewer]")
      .forEach((container) => {
        initShelfLabelViewer(container, cleanupController!.signal);
      });
  }

  initialize();

  // Keeps it working when Astro ClientRouter performs a page swap.
  document.addEventListener("astro:page-load", initialize);

  document.addEventListener("astro:before-swap", () => {
    cleanupController?.abort();
  });
</script>

<style>
  .shelf-label-viewer {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: visible;
    /* background: var(--color-background); */
    cursor: grab;
    touch-action: none;
  }

  /* .shelf-label-viewer__blue-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: -200%;
    aspect-ratio: 1 / 1;
    transform: scale(0.5);
    border-radius: 999px;
    background: var(--color-aurora);
    filter: blur(calc(100dvw * 4));

    background: radial-gradient(
      circle at 50% 120%,
      var(--color-aurora) 0,
      transparent 50%
    );

    overflow: visible;

    pointer-events: none;
    z-index: 0;
  } */

  .shelf-label-viewer:active {
    cursor: grabbing;
  }

  .shelf-label-viewer canvas {
    display: block;
    width: 100%;
    height: 100%;
    position: relative;
    z-index: 1;
  }

  .shelf-label-viewer__loading {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr;
    grid-template-rows: 1fr;
    place-items: center;
    pointer-events: none;
    z-index: 2;
  }

  .shelf-label-viewer__placeholder,
  .shelf-label-viewer__status {
    grid-area: 1 / 1;
  }

  .shelf-label-viewer__placeholder {
    width: min(100%, 72rem);
    height: auto;
  }

  .shelf-label-viewer__placeholder :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .shelf-label-viewer__status {
    margin: 0;
    color: var(--text-secondary);
    pointer-events: none;
    z-index: 1;
  }
</style>
