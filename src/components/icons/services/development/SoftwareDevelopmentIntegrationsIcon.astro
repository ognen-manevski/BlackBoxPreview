<svg class="sd-devint-icon" xmlns="http://www.w3.org/2000/svg" width="1400" height="1200" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1400 1200">
  <defs>
    <style>


      .sd-devint-icon{
        --fill-color: var(--icon-bg);
        --stroke-color: var(--color-brand);
      }

      .cls-1-devint {
        clip-path: url(#clippath-6);
      }

      .cls-2-devint {
        clip-path: url(#clippath-4);
      }

      .cls-3-devint, .cls-4-devint, .cls-5-devint {
        fill: none;
      }

      .cls-6-devint {
        clip-path: url(#clippath-1);
      }

      .cls-7-devint {
        clip-path: url(#clippath-5);
      }

      .cls-8-devint {
        clip-path: url(#clippath-3);
      }

      .cls-4-devint {
        fill-rule: evenodd;
      }

      .cls-4-devint, .cls-5-devint {
        stroke: var(--stroke-color);
        stroke-miterlimit: 10;
        stroke-width: 5px;
      }

      .cls-9-devint {
        clip-path: url(#clippath-2);
      }

      .cls-1-devint0 {
        clip-path: url(#clippath);
      }


      #server-bg, #earth-bg, #mid-circ, #pc-bg, #gear-bg{
        fill: var(--fill-color);
      }

      #text-devint{
        fill: var(--stroke-color);
      }


      #dt-1, #dt-2, #dt-3, #dt-4, #dt-5{
        transform-box: fill-box;
        transform-origin: center;
        --dist: -160px;
      }

      #dt-4 [data-name="dt-1"]{
        animation-direction: reverse;
      }


      .sd-service-card:hover #dt-2 [data-name="dt-1"],
      .sd-service-card:hover #dt-4 [data-name="dt-1"],
      .sd-service-card:hover #dt-5 [data-name="dt-1"]{
        animation: dt-anim-y 2s linear infinite;
      }

      .sd-service-card:hover #dt-1 [data-name="dt-1"],
      .sd-service-card:hover #dt-3 [data-name="dt-1"]{
        animation: dt-anim-x 2s linear infinite;
      }

      @keyframes dt-anim-y {
        from {
          transform: translateY(0);
        }
        to {
          transform: translateY(var(--dist));
        }
      }

      @keyframes dt-anim-x {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(var(--dist));
        }
      }


      #s-1, #s-2, #s-3{
        transform-box: fill-box;
        transform-origin: center;
      }

      .sd-service-card:hover #s-1,
      .sd-service-card:hover #s-2,
      .sd-service-card:hover #s-3{
        animation: wifi-anim var(--duration) step-start infinite;
        animation-delay: var(--delay);
      }

      #s-3{
        --duration: 2s;
        --delay: 0s;
      }

      #s-2{
        --duration: 2s;
        --delay: 0.1s;
      }

      #s-1{
        --duration: 2s;
        --delay: 0.2s;
      }


      @keyframes wifi-anim {
        0%, 55%, 100% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
      }

      #server-1, #db-1{
        --delay-parent: 0s;
      }

      #server-2, #db-2{
        --delay-parent: 0.1s;
      }

      #server-3, #db-3{
        --delay-parent: 0.2s;
      }


      .c-1 {
        --delay-local: 0s;
      }
      .c-2 {
        --delay-local: 0.1s;
      }
      .c-3 {
        --delay-local: 0.2s;
      }

      .sd-service-card:hover .c-1,
      .sd-service-card:hover .c-2,
      .sd-service-card:hover .c-3 {
        animation: dots-blink 1s step-start infinite;
        animation-delay: calc(var(--delay-local) + var(--delay-parent, 0s));
      }

      @keyframes dots-blink {
        0%,
        100%{
          opacity: 1;
        }

        50% {
          opacity: 0;
        }
      }

      #gear-bg{
        transform-box: fill-box;
        transform-origin: center;
      }

      .sd-service-card:hover #gear-bg{
        animation: gear-anim 20s linear infinite;
      }

      @keyframes gear-anim {
        from {
          transform: rotate(0deg);
        }
        to {
          transform: rotate(360deg);
        }
      }

      #package-phone, #package-pc{
        transform-box: fill-box;
        transform-origin: center;
      }

      .sd-service-card:hover #package-phone{
        animation: package-anim-phone 2s linear infinite;
      }

      .sd-service-card:hover #package-pc{
        animation: package-anim-pc 2s linear infinite;
      }

      @keyframes package-anim-pc {
        0% {
          transform: translate(400px, 140px);
        }
        70% {
          transform: translate(0px, 140px);
        }
        100% {
          transform: translate(0px, -20px);
        }
      }

      @keyframes package-anim-phone {
        0% {
          transform: translate(0px, 30px);
        }
        70% {
          transform: translate(0px, -250px);
        }
        100% {
          transform: translate(-60px, -250px);
        }
      }




