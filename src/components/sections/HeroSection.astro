---
import ArrowButton from "../atoms/ArrowButton.astro";
import neoslideDarkLong from '../../assets/images/home/long/neoslide-dark-long.jpg';
import neoslideLightLong from '../../assets/images/home/long/neoslide-wh-long.jpg';
import shelfLabelsDarkLong from '../../assets/images/home/long/labels-dark-long.jpg';
import shelfLabelsLightLong from '../../assets/images/home/long/labels-wh-long.jpg';
import videoStreamingDarkLong from '../../assets/images/home/long/video-dark-long.jpg';
import videoStreamingLightLong from '../../assets/images/home/long/video-wh-long.jpg';
import softwareDevelopmentDarkLong from '../../assets/images/home/long/code-dark-long.jpg';
import softwareDevelopmentLightLong from '../../assets/images/home/long/code-wh-long.jpg';
import bgGradient2DarkPoster from '../../assets/images/video-thumbnails/gradients/dark/gradient-2-grain-0.jpg';
import bgGradient2LightPoster from '../../assets/images/video-thumbnails/gradients/light/gradient-2-grain-wh-0.jpg';
import spkLogo from '../../assets/images/company-logos/clients/sm/spk-sm.jpg';
import vinLogo from '../../assets/images/company-logos/clients/sm/vin-sm.jpg';
import specLogo from '../../assets/images/company-logos/clients/sm/spec-sm.jpg';
import popovLogo from '../../assets/images/company-logos/clients/sm/popov-sm.jpg';
import neotelLogo from '../../assets/images/company-logos/clients/sm/neotel-sm.jpg';
import arrowForwardSvg from '../../assets/vectors/icons/material/custom/arrow_forward-400w.svg?raw';
import type { HomePageContent } from '../../i18n/pages/home';
interface Props { content: HomePageContent['hero']; }
const { content } = Astro.props;
const slideAriaLabel = (index: number, label: string) => `${index + 1} of ${content.slides.length}: ${label}`;
---

<section class="hero" id="hero" aria-label={content.ariaLabel}>
  <div class="hero__background" aria-hidden="true">
    <video
      class="hero__bg-video hero__bg-video--dark"
      src={`${import.meta.env.BASE_URL}videos/gradients/dark/base-gradient-2.mp4`}
      poster={bgGradient2DarkPoster.src}
      autoplay
      muted
      loop
      playsinline
    ></video>
    <video
      class="hero__bg-video hero__bg-video--light"
      src={`${import.meta.env.BASE_URL}videos/gradients/light/base-gradient-2.mp4`}
      poster={bgGradient2LightPoster.src}
      autoplay
      muted
      loop
      playsinline
    ></video>
  </div>

  <div class="hero__inner container">
    <!-- ========== LEFT: CONTENT ========== -->
    <div class="hero__content">
      <!-- Trust badge -->
      <div class="hero__trust">
        <span class="hero__trust-rating" aria-hidden="true">
          <span class="hero__trust-score">{content.rating}</span>
          <span class="hero__trust-stars">{content.stars}</span>
        </span>
        <span class="hero__trust-divider" aria-hidden="true"></span>
        <span class="hero__trust-clients">
          <strong class="hero__trust-count">{content.trustedCount}</strong>
          <span class="hero__trust-label">{content.trustedLabel}<br />{content.trustedLabelSecondLine}</span>
        </span>
        <span class="hero__trust-logos" aria-label="Trusted client logos">
          <img class="hero__trust-logo hero__trust-logo--front" src={spkLogo.src} alt="Sparkasse Bank" />
          <img class="hero__trust-logo" src={neotelLogo.src} alt="Neotel" />
          <img class="hero__trust-logo" src={specLogo.src} alt="SPEC" />
          <img class="hero__trust-logo" src={popovLogo.src} alt="Popov" />
          <img class="hero__trust-logo" src={vinLogo.src} alt="VIN" />
        </span>
      </div>

      <!-- Headline -->
      <h1 class="hero__headline section-headline section-headline--hero">
        <span class="hero__headline-static"
          >{content.headlineStart}
        </span>
        <span class="hero-highlight-group">
          <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: 0s;">{content.highlights[0]}</span>&#32;
          <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -1.67s;">{content.highlights[1]}</span>&#32; {content.conjunction} <span
            class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -3.33s;">{content.highlights[2]}</span
          >
        </span>
      </h1>

      <!-- Lead -->
      <p class="hero__lead">
        {content.lead}
      </p>

      <!-- CTAs -->
      <div class="hero__actions">
        <div class="hero__cta-group">
          <ArrowButton href={`${import.meta.env.BASE_URL}book-a-free-demo/`} variant="primary"
            >{content.primaryCta}</ArrowButton
          >
          <a href={`${import.meta.env.BASE_URL}#about`} class="btn btn--ghost">{content.secondaryCta}</a>
        </div>
        <div class="hero__cta-note">{content.ctaNote}</div>
      </div>
    </div>

    <!-- ========== RIGHT: CAROUSEL ========== -->
    <div
      class="hero__carousel"
      role="region"
      aria-roledescription="carousel"
      aria-label={content.carouselAriaLabel}
    >
      <div class="carousel__viewport" id="carouselViewport">
        <div class="carousel__track" id="heroCarouselTrack">
          <div
            class="carousel__slide"
            role="group"
            aria-roledescription={content.slideRole}
            aria-label={slideAriaLabel(0, content.slides[0])}
          >
            <div class="carousel__field">
              <div class="carousel__media-frame">
                <img class="carousel__media carousel__media--dark" src={neoslideDarkLong.src} alt="" loading="eager" decoding="async" />
                <img class="carousel__media carousel__media--light" src={neoslideLightLong.src} alt="" loading="eager" decoding="async" />
              </div>
              <h3 class="carousel__slide-title">{content.slides[0]}</h3>
            </div>
          </div>

          <div
            class="carousel__slide"
            role="group"
            aria-roledescription={content.slideRole}
            aria-label={slideAriaLabel(1, content.slides[1])}
          >
            <div class="carousel__field">
              <div class="carousel__media-frame">
                <img class="carousel__media carousel__media--dark" src={shelfLabelsDarkLong.src} alt="" loading="lazy" decoding="async" />
                <img class="carousel__media carousel__media--light" src={shelfLabelsLightLong.src} alt="" loading="lazy" decoding="async" />
              </div>
              <h3 class="carousel__slide-title">{content.slides[1]}</h3>
            </div>
          </div>

          <div
            class="carousel__slide"
            role="group"
            aria-roledescription={content.slideRole}
            aria-label={slideAriaLabel(2, content.slides[2])}
          >
            <div class="carousel__field">
              <div class="carousel__media-frame">
                <img class="carousel__media carousel__media--dark" src={videoStreamingDarkLong.src} alt="" loading="lazy" decoding="async" />
                <img class="carousel__media carousel__media--light" src={videoStreamingLightLong.src} alt="" loading="lazy" decoding="async" />
              </div>
              <h3 class="carousel__slide-title">{content.slides[2]}</h3>
            </div>
          </div>

          <div
            class="carousel__slide"
            role="group"
            aria-roledescription={content.slideRole}
            aria-label={slideAriaLabel(3, content.slides[3])}
          >
            <div class="carousel__field">
              <div class="carousel__media-frame">
                <img class="carousel__media carousel__media--dark" src={softwareDevelopmentDarkLong.src} alt="" loading="lazy" decoding="async" />
                <img class="carousel__media carousel__media--light" src={softwareDevelopmentLightLong.src} alt="" loading="lazy" decoding="async" />
              </div>
              <h3 class="carousel__slide-title">{content.slides[3]}</h3>
            </div>
          </div>
        </div>
      </div>

      <div class="carousel__nav">
        <button
          class="carousel__arrow carousel__arrow--prev"
          type="button"
          aria-label="Previous slide"
          data-carousel-prev
        >
          <span class="carousel__arrow-icon" set:html={arrowForwardSvg} />
        </button>

        <div class="carousel__dots" role="tablist" aria-label={content.slideIndicators}>
          <button
            class="carousel__dot"
            type="button"
            role="tab"
            data-index="0"
            aria-label={content.slides[0]}
            aria-selected="true"></button>
          <button
            class="carousel__dot"
            type="button"
            role="tab"
            data-index="1"
            aria-label={content.slides[1]}
            aria-selected="false"></button>
          <button
            class="carousel__dot"
            type="button"
            role="tab"
            data-index="2"
            aria-label={content.slides[2]}
            aria-selected="false"></button>
          <button
            class="carousel__dot"
            type="button"
            role="tab"
            data-index="3"
            aria-label={content.slides[3]}
            aria-selected="false"></button>
        </div>

        <button
          class="carousel__arrow carousel__arrow--next"
          type="button"
          aria-label="Next slide"
          data-carousel-next
        >
          <span class="carousel__arrow-icon" set:html={arrowForwardSvg} />
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    min-width: 0;
  }

  .hero__lead {
    max-width: 64ch;
  }

  /* ---- Section shell ---- */
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--hero-background);
    color: var(--text-primary);
    /* min-height: calc(100dvh - 6rem); */
    min-height: min(calc(100dvh - 6rem), 60rem);
    /* max-height: 60rem; */
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity var(--t-base);
  }

  .hero__bg-video--dark {
    opacity: 1;
  }

  .hero__bg-video--light {
    opacity: 0;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      90deg,
      var(--video-overlay) 0%,
      /* var(--video-overlay) 38%,
      var(--video-overlay-transparent) 78%, */
      var(--video-overlay-transparent) 100%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: var(--sp-10);
    row-gap: var(--sp-10);
    align-items: center;
    padding-top: var(--sp-9);
    padding-bottom: var(--sp-9);
  }

  /* ---- Trust badge ---- */
  .hero__trust {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: var(--sp-2) var(--sp-5);
    /* margin-bottom: var(--sp-6); */
    width: fit-content;
  }

  .hero__trust-rating {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .hero__trust-score {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
  }

  .hero__trust-stars {
    font-size: var(--text-sm);
    letter-spacing: var(--letter-spacing-label);
  }

  .hero__trust-divider {
    display: block;
    width: 1px;
    height: 1.75rem;
    background: var(--border-color);
    flex-shrink: 0;
  }

  .hero__trust-clients {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .hero__trust-count {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
  }

  .hero__trust-label {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .hero__trust-logos {
    display: flex;
    align-items: center;
    padding-left: var(--sp-2);
  }

  .hero__trust-logo {
    position: relative;
    width: 2rem;
    height: 2rem;
    margin-left: -0.55rem;
    object-fit: cover;
    border: 2px solid var(--border-color);
    border-radius: 50%;
    background: var(--bg);
  }

  .hero__trust-logo:first-child {
    margin-left: 0;
  }

  .hero__trust-logo:nth-child(1) {
    z-index: 5;
  }

  .hero__trust-logo:nth-child(2) {
    z-index: 4;
  }

  .hero__trust-logo:nth-child(3) {
    z-index: 3;
  }

  .hero__trust-logo:nth-child(4) {
    z-index: 2;
  }

  .hero__trust-logo:nth-child(5) {
    z-index: 1;
  }


  /* ---- Lead ---- */

  /* ---- CTAs ---- */
  .hero__actions {
    display: flex;
    flex-direction: column;
    /* align-items: flex-end; */
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .hero__cta-group {
    display: flex;
    flex-direction: row;
    gap: var(--sp-3);
  }

  .hero__cta-note {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding-left: var(--sp-1);
  }

  /* ---- Carousel ---- */
  .hero__carousel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--sp-4);
    min-width: 0;
  }

  .carousel__viewport {
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    background: transparent;
  }

  .carousel__viewport:active {
    cursor: grabbing;
  }

  .carousel__track {
    display: flex;
    will-change: transform;
    transition: transform 0.5s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      transition: none;
    }
  }

  .carousel__slide {
    position: relative;
    /* extra width holds the inter-slide gap outside the viewport when centered */
    width: calc(100% + var(--sp-4));
    box-sizing: border-box;
    padding-right: var(--sp-4);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .carousel__field {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    background: var(--bg);
    border-radius: var(--radius-sm);
    padding: var(--sp-4);
    box-sizing: border-box;
    width: 100%;
  }

  .carousel__media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .carousel__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    user-select: none;
    -webkit-user-drag: none;
    background: transparent;
    transition: opacity var(--t-base);
  }

  .carousel__media--dark {
    opacity: 1;
  }

  .carousel__media--light {
    opacity: 0;
  }

  .carousel__slide-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
    text-align: center;
  }

  :global([data-theme='light']) .carousel__media--dark {
    opacity: 0;
  }

  :global([data-theme='light']) .carousel__media--light {
    opacity: 1;
  }

  :global([data-theme='light']) .hero__bg-video--dark {
    opacity: 0;
  }

  :global([data-theme='light']) .hero__bg-video--light {
    opacity: 1;
  }

  /* Dot indicators */
  .carousel__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-1);
  }

  .carousel__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    width: 2.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    background: var(--bg);
    color: var(--text-primary);
    cursor: pointer;
    padding: 0;
    transition:
      border-color var(--t-base),
      background var(--t-base),
      color var(--t-base);
  }

  .carousel__arrow:hover,
  .carousel__arrow:focus-visible {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .carousel__arrow-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
  }

  .carousel__arrow-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .carousel__arrow--prev .carousel__arrow-icon {
    transform: scaleX(-1);
  }

  .carousel__dots {
    --width: 0.6rem;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    height: 2.25rem;
    /* fixed width so the growing active dot never resizes this wrapper */
    width: calc(8 * var(--width) + 3 * var(--sp-2) + 2 * var(--sp-4) + 2px);
    box-sizing: border-box;
    gap: var(--sp-2);
    padding: 0 var(--sp-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .carousel__dot {
    height: var(--width);
    width: var(--width);
    /* border-radius: var(--radius-sm); */
    background: var(--text-muted);
    border: none;
    padding: 0;
    cursor: pointer;
    transition:
      background var(--t-base),
      width var(--t-base);
  }

  .carousel__dot:hover {
    background: var(--text-secondary);
  }

  .carousel__dot[aria-selected="true"] {
    background: var(--color-brand);
    width: calc(var(--width) * 5);
  }

  /* ---- Responsive ---- */
  @media (max-width: 1024px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--sp-8);
    }

    .hero {
      min-height: auto;
      max-height: none;
    }
  }

  @media (max-width: 768px) {
    .hero__inner {
      padding-top: var(--sp-7);
      padding-bottom: var(--sp-7);
    }

    .hero__lead {
      font-size: var(--text-base);
    }

    .hero__actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero__carousel {
      padding: var(--sp-4);
    }
  }

  @media (max-width: 480px) {
    .hero__trust {
      box-sizing: border-box;
      width: fit-content;
      max-width: 100%;
      flex-wrap: nowrap;
      gap: var(--sp-2);
      padding: var(--sp-2);
    }

    .hero__trust-clients {
      min-width: 0;
      flex: 1 1 auto;
    }

    .hero__trust-label {
      overflow-wrap: anywhere;
    }

    .hero__trust-logos {
      padding-left: 0;
    }

    .hero__cta-group {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .hero__cta-group > * {
      width: 100%;
      box-sizing: border-box;
    }
  }

  @media (max-width: 320px) {
    .hero__trust {
      flex-wrap: wrap;
      align-items: flex-start;
    }

    .hero__trust-rating {
      flex: 0 0 100%;
    }

    .hero__trust-divider {
      flex: 0 0 100%;
      width: 100%;
      height: 1px;
    }

    .hero__trust-clients {
      flex: 0 1 auto;
    }

    .hero__trust-logos {
      width: auto;
      flex: 0 0 auto;
      justify-content: flex-start;
      align-self: center;
    }

    .hero__trust-logo {
      width: 1.5rem;
      height: 1.5rem;
      margin-left: -0.5rem;
    }

    .hero__trust-logo:first-child {
      margin-left: 0;
    }
  }

  @media (max-width: 240px) {
    .hero__trust-divider {
      display: none;
    }

    .hero__trust-rating,
    .hero__trust-clients,
    .hero__trust-logos {
      flex: 0 0 100%;
    }
  }
</style>

<script>
  const viewport = document.getElementById(
    "carouselViewport",
  ) as HTMLElement | null;
  const track = document.getElementById(
    "heroCarouselTrack",
  ) as HTMLElement | null;
  const dots = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".carousel__dot"),
  );
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-carousel-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-carousel-next]");

  if (viewport && track) {
    const carouselTrack = track;
    const slides = Array.from(
      carouselTrack.querySelectorAll<HTMLElement>(".carousel__slide"),
    );
    const total = slides.length;

    const preloadImages = (root: ParentNode) =>
      Array.from(root.querySelectorAll<HTMLImageElement>("img")).map((image) => {
        image.loading = "eager";
        return image.decode().catch(() => undefined);
      });

    preloadImages(carouselTrack);

    if (total > 1) {
      // Keep one clone on each side so the end-to-start transition stays seamless.
      const firstClone = slides[0].cloneNode(true) as HTMLElement;
      const lastClone = slides[total - 1].cloneNode(true) as HTMLElement;
      firstClone.setAttribute("aria-hidden", "true");
      lastClone.setAttribute("aria-hidden", "true");
      [firstClone, lastClone].forEach((clone) => {
        preloadImages(clone);
      });
      carouselTrack.appendChild(firstClone);
      carouselTrack.insertBefore(lastClone, slides[0]);

      let current = 1; // 0 = lastClone, 1..total = real slides, total+1 = firstClone
      let startX = 0;
      let dragDiff = 0;
      let dragging = false;
      let isAnimating = false;
      let queuedDirection = 0;
      let timer = 0;
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      // Slide width includes the inter-slide gap, so step by its full width.
      const w = () => slides[0]?.offsetWidth ?? viewport.offsetWidth;

      function syncDots(idx: number) {
        const real = (((idx - 1) % total) + total) % total;
        dots.forEach((dot, i) =>
          dot.setAttribute("aria-selected", String(i === real)),
        );
      }

      function setPosition(idx: number, animated = true) {
        const shouldAnimate = animated && !reduced;
        carouselTrack.style.transition = shouldAnimate
          ? "transform 0.5s ease"
          : "none";
        carouselTrack.style.transform = `translateX(${-idx * w()}px)`;
      }

      function normalizePosition() {
        if (current === 0) {
          // Last-slide clone -> matching real last slide.
          current = total;
          setPosition(current, false);
        } else if (current === total + 1) {
          // First-slide clone -> matching real first slide.
          current = 1;
          setPosition(current, false);
        }
      }

      function go(direction: number) {
        // Never let current move beyond the two available clones.
        // If another input arrives mid-transition, remember one follow-up move.
        if (isAnimating) {
          queuedDirection = direction;
          return;
        }

        current += direction;
        syncDots(current);

        if (reduced) {
          normalizePosition();
          setPosition(current, false);
          return;
        }

        isAnimating = true;
        setPosition(current, true);
      }

      function goToSlide(index: number) {
        if (isAnimating) return;

        const target = index + 1;
        if (target === current) return;

        current = target;
        syncDots(current);

        if (reduced) {
          setPosition(current, false);
          return;
        }

        isAnimating = true;
        setPosition(current, true);
      }

      function finishTransition() {
        normalizePosition();
        isAnimating = false;

        if (queuedDirection !== 0) {
          const direction = queuedDirection;
          queuedDirection = 0;
          requestAnimationFrame(() => go(direction));
        }
      }

      // Once a movement finishes, silently swap a clone for its matching real
      // slide before accepting the next queued movement.
      carouselTrack.addEventListener("transitionend", (event) => {
        if (event.target !== carouselTrack || event.propertyName !== "transform") return;
        finishTransition();
      });

      // If a resize or browser interruption cancels a transform transition,
      // release the animation lock instead of leaving the carousel stuck.
      carouselTrack.addEventListener("transitioncancel", (event) => {
        if (event.target !== carouselTrack || event.propertyName !== "transform") return;
        finishTransition();
      });

      // Dot clicks
      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          goToSlide(i);
          resetAutoplay();
        });
      });

      // Arrow buttons
      prevBtn?.addEventListener("click", () => {
        go(-1);
        resetAutoplay();
      });

      nextBtn?.addEventListener("click", () => {
        go(1);
        resetAutoplay();
      });

      function tick() {
        go(1);
      }

      function startAutoplay() {
        if (reduced) return;
        clearInterval(timer);
        timer = window.setInterval(tick, 4500);
      }

      function resetAutoplay() {
        clearInterval(timer);
        startAutoplay();
      }

      // Drag / swipe via Pointer Events
      viewport.addEventListener("pointerdown", (e) => {
        if (isAnimating) return;
        if (e.pointerType === "mouse" && e.button !== 0) return;

        e.preventDefault();
        dragging = true;
        startX = e.clientX;
        dragDiff = 0;
        carouselTrack.style.transition = "none";
        viewport.setPointerCapture(e.pointerId);
        clearInterval(timer);
      });

      viewport.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        dragDiff = e.clientX - startX;
        carouselTrack.style.transform = `translateX(${-current * w() + dragDiff}px)`;
      });

      const finishDrag = () => {
        if (!dragging) return;
        dragging = false;

        const threshold = w() * 0.18;

        if (dragDiff < -threshold) {
          go(1);
        } else if (dragDiff > threshold) {
          go(-1);
        } else if (Math.abs(dragDiff) > 1 && !reduced) {
          // Snap back only when the pointer actually displaced the track.
          // This avoids waiting for a transitionend that cannot fire.
          isAnimating = true;
          setPosition(current, true);
        } else {
          setPosition(current, false);
        }

        syncDots(current);
        startAutoplay();
      };

      viewport.addEventListener("pointerup", finishDrag);
      viewport.addEventListener("pointercancel", finishDrag);
      viewport.addEventListener("lostpointercapture", finishDrag);

      // Pause autoplay on hover
      viewport.addEventListener("mouseenter", () => clearInterval(timer));
      viewport.addEventListener("mouseleave", () => {
        if (!dragging) startAutoplay();
      });

      // Init
      setPosition(current, false);
      syncDots(current);
      startAutoplay();

      window.addEventListener("resize", () => {
        isAnimating = false;
        queuedDirection = 0;
        normalizePosition();
        setPosition(current, false);
      }, { passive: true });
    }
  }
</script>
