---
import Navbar from '../components/molecules/Navbar.astro';
import Footer from '../components/molecules/Footer.astro';
import { getLocaleFromUrl } from '../i18n/utils';
import type { Lang } from '../i18n/types';
import { commonTranslations } from '../i18n/common';
import { getTranslations } from '../i18n/utils';
import { formsTurnstileEnabled } from '../config/forms';
import { cookiebotDomainGroupId } from '../config/cookiebot';
import robotoFontUrl from '../assets/fonts/Roboto/Roboto-VariableFont_wdth,wght.woff2?url';
import interFontUrl from '../assets/fonts/Inter/Inter-VariableFont_opsz,wght.woff2?url';

import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/utilities.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  lang?: Lang;
}

const {
  title,
  description,
  canonical,
  ogImage = 'thumbnails/Black-Box-Solutions_OG-Link-Preview.jpg',
  lang = getLocaleFromUrl(Astro.url),
} = Astro.props;
const resolvedDescription = description ?? getTranslations(commonTranslations, lang).seo.defaultDescription;

const canonicalURL = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href);
const baseURL = new URL(import.meta.env.BASE_URL, Astro.site ?? Astro.url);
const resolvedOgImage = new URL(
  ogImage.startsWith('http://') || ogImage.startsWith('https://')
    ? ogImage
    : ogImage.replace(/^\/+/, ''),
  baseURL,
).href;
---
<!doctype html>
<html lang={lang}>
<head>
  {cookiebotDomainGroupId && (
    <script
      id="Cookiebot"
      src="https://consent.cookiebot.com/uc.js"
      data-cbid={cookiebotDomainGroupId}
      data-blockingmode="auto"
      type="text/javascript"
      is:inline
    ></script>
  )}
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={resolvedDescription}>
  <link rel="canonical" href={canonicalURL}>
  <meta name="robots" content="index, follow">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={resolvedDescription}>
  <meta property="og:image" content={resolvedOgImage}>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={resolvedDescription}>
  <meta name="twitter:image" content={resolvedOgImage}>

  <!-- Favicons -->
  <link rel="icon" href={`${import.meta.env.BASE_URL}brand/favicons/favicon-adaptive.svg`} type="image/svg+xml">
  <!-- <link rel="icon" href={`${import.meta.env.BASE_URL}brand/favicons/favicon.ico`} sizes="any"> -->
  <!-- <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}brand/favicons/apple-touch-icon.png`}> -->
  <link rel="manifest" href={`${import.meta.env.BASE_URL}brand/favicons/site.webmanifest`}>

  <!-- Theme color --><meta name="theme-color" content="#111111">

  <!-- Sitemap -->
  <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`}>

  <!-- Fonts -->
  <link rel="preload" href={robotoFontUrl} as="font" type="font/woff2" crossorigin>
  <link rel="preload" href={interFontUrl} as="font" type="font/woff2" crossorigin>
  {formsTurnstileEnabled && (
    <script
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  )}
</head>
<body>

  <Navbar currentLang={lang} />

  <main id="main-content">
    <slot />
  </main>

  <Footer lang={lang} />

  <!-- Entrance animations -->
  <script>
    const animEls = document.querySelectorAll('[data-animate]');

    if ('IntersectionObserver' in window && animEls.length) {
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.10, rootMargin: '0px 0px -48px 0px' }
      );

      animEls.forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${(i % 4) * 80}ms`;
        observer.observe(el);
      });
    } else {
      animEls.forEach(el => el.classList.add('is-visible'));
    }
  </script>

  <script>
    if ('serviceWorker' in navigator) {
      const registerVideoCacheWorker = () => {
        navigator.serviceWorker.register(`${import.meta.env.BASE_URL}sw.js`, {
          scope: import.meta.env.BASE_URL,
          updateViaCache: 'none',
        }).catch((error) => {
          console.error('Shared media caching could not be enabled.', error);
        });
      };

      if (document.readyState === 'complete') {
        registerVideoCacheWorker();
      } else {
        window.addEventListener('load', registerVideoCacheWorker, { once: true });
      }
    }
  </script>

</body>
</html>
