---
import StatMetricCard from '../atoms/StatMetricCard.astro';
import SectionTitleGroup from '../molecules/SectionTitleGroup.astro';
import type{ShelfLabelsContent}from'../../i18n/pages/shelf-labels'; interface Props{content:ShelfLabelsContent['performance']} const{content}=Astro.props; const stats=content.stats;
---

<section class="section sl-performance" id="proven-performance" aria-labelledby="proven-performance-heading">
  <div class="container">
    <SectionTitleGroup
      class="sl-performance__header"
      headlineClass="sl-performance__headline"
      label={content.label}
      heading={content.heading}
      headingId="proven-performance-heading"
      titleWidth="52%"
      copy={content.copy}
    />

    <ul class="sl-performance__stats" aria-label={content.ariaLabel}>
      {stats.map((stat) => (
        <li class="sl-performance__stat-item">
          <StatMetricCard
            value={stat.value}
            label={stat.label}
            compactValue={stat.compactValue}
            valueSuffixSmall={stat.valueSuffixSmall}
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sl-performance {
    background: var(--bg);
    border-bottom: 1px solid var(--border-color);
  }

  .sl-performance__header {
    margin-bottom: var(--sp-6);
  }

  :global(.sl-performance__headline) {
    max-width: 30ch;
  }

  .sl-performance__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-2);
  }

  .sl-performance__stat-item {
    list-style: none;
    display: flex;
  }

  .sl-performance__stat-item :global(.stat-metric-card) {
    width: 100%;
  }

  @media (max-width: 1200px) {
    .sl-performance__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {

  @media (max-width: 600px) {
    .sl-performance__stats {
      grid-template-columns: 1fr;
    }
  }
</style>
