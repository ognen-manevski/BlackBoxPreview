---
import DsCard from "../atoms/DsCard.astro";
import type { DigitalSignageContent } from '../../i18n/pages/digital-signage';
interface Props { content: DigitalSignageContent['hero'] } const { content } = Astro.props;
---

<section class="ds-hero" aria-label={content.ariaLabel} data-ds-hero>
    <div class="container ds-hero__frame">
        <div class="ds-hero__left">
            <!-- HERO -->

            <div class="ds-hero-step">
                <div class="ds-hero__intro" data-ds-intro>
                    <h1 class="ds-hero__title section-headline section-headline--hero">
                        <span class="hero__headline-static"
                            >{content.headlineStart}
                        </span>
                        <span class="hero-highlight-group">
                            <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: 0s;">{content.highlights[0]}</span>&#32;
                            <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -1.67s;">{content.highlights[1]}</span>&#32;
                            <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -3.33s;">{content.highlights[2]}</span>
                        </span>
                    </h1>
                    <p class="ds-hero__lead section-copy">
                        {content.lead}
                    </p>
                </div>
            </div>

            <!-- CARDS -->

            <div class="ds-hero__cards">
                <div class="ds-card-step" data-ds-card-step>
                    <DsCard
                        title={content.cards[0].title} text={content.cards[0].text}
                    >
                        <svg
                            slot="icon"
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect x="3" y="4" width="18" height="13" rx="2"></rect>
                            <path d="M8 20h8"></path>
                            <path d="M12 17v3"></path>
                        </svg>
                    </DsCard>
                </div>
                <div class="ds-card-step" data-ds-card-step>
                    <DsCard
                        title={content.cards[1].title} text={content.cards[1].text}
                    >
                        <svg
                            slot="icon"
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z"></path>
                        </svg>
                    </DsCard>
                </div>
                <div class="ds-card-step" data-ds-card-step>
                    <DsCard
                        title={content.cards[2].title} text={content.cards[2].text}
                    >
                        <svg
                            slot="icon"
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
                            <path d="M2 10h20"></path>
                        </svg>
                    </DsCard>
                </div>
                <div class="ds-card-step" data-ds-card-step>
                    <DsCard
                        title={content.cards[3].title} text={content.cards[3].text}
                    >
                        <svg
                            slot="icon"
                            viewBox="0 0 24 24"
                            width="20"
                            height="20"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.8"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                        >
                            <rect x="3" y="5" width="15" height="10" rx="2"></rect>
                            <path d="M18 8h1a2 2 0 0 1 2 2v2"></path>
                            <path d="M10 20h4"></path>
                            <path d="M8 15v5"></path>
                            <path d="M16 15v5"></path>
                        </svg>
                    </DsCard>
                </div>
                <div class="ds-card-step" data-ds-card-step data-ds-outro></div>
            </div>
        </div>

        <!-- VIDEO -->

        <div class="ds-hero__video-wrap" data-ds-video-wrap>
            <div class="ds-hero__video-shell" data-ds-video-shell>
                <video
                    class="ds-hero__video ds-hero__video--dark"
                    data-ds-video
                    muted
                    playsinline
                    preload="auto"
                    aria-label={content.videoAriaLabel}
                    src={`${import.meta.env.BASE_URL}videos/digital-signage/totem-onscroll/video-hero-onscroll-61frames.mp4`}
                >
                </video>
                <video
                    class="ds-hero__video ds-hero__video--light"
                    data-ds-video
                    muted
                    playsinline
                    preload="auto"
                    aria-hidden="true"
                    src={`${import.meta.env.BASE_URL}videos/digital-signage/totem-onscroll/video-hero-wh-onscroll-61frames.mp4`}
                >
                </video>
            </div>
        </div>

        <!-- OUTRO -->

        <div class="ds-hero__outro"></div>
    </div>
</section>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const TOTAL_FRAMES = 61;
    const DESKTOP_QUERY = "(min-width: 1025px)";
    const REDUCED_MOTION_QUERY = "(prefers-reduced-motion: reduce)";

    const root = document.querySelector<HTMLElement>("[data-ds-hero]");

    if (root) {
        const videoWrap = root.querySelector<HTMLElement>(
            "[data-ds-video-wrap]",
        );
        const videos = Array.from(
            root.querySelectorAll<HTMLVideoElement>("[data-ds-video]"),
        );
        const outro = root.querySelector<HTMLElement>("[data-ds-outro]");

        if (videoWrap && videos.length >= 2 && outro) {
            const reducedMotion = window.matchMedia(REDUCED_MOTION_QUERY);

            const getActiveVideo = (): HTMLVideoElement => {
                const isLight =
                    document.documentElement.getAttribute("data-theme") ===
                    "light";

                return isLight ? videos[1] : videos[0];
            };

            const primeVideos = (): void => {
                videos.forEach((video) => {
                    const prime = (): void => {
                        video.currentTime = Math.min(0, video.duration || 0.03);
                    };

                    if (video.readyState >= HTMLMediaElement.HAVE_METADATA) {
                        prime();
                    } else {
                        video.addEventListener("loadedmetadata", prime, {
                            once: true,
                        });
                    }
                });
            };

            primeVideos();

            if (reducedMotion.matches) {
                videos.forEach((video) => {
                    video.controls = true;
                });
            } else {
                let lastVideo: HTMLVideoElement | null = null;
                let lastFrame = -1;
                let requestedFrame = -1;
                let rafId = 0;

                const seekToFrame = (
                    video: HTMLVideoElement,
                    frame: number,
                ): void => {
                    if (!video.duration || !Number.isFinite(video.duration)) {
                        return;
                    }

                    if (video !== lastVideo) {
                        lastVideo = video;
                        lastFrame = -1;
                    }

                    const clampedFrame = Math.max(
                        0,
                        Math.min(frame, TOTAL_FRAMES - 1),
                    );

                    if (clampedFrame === lastFrame) return;

                    requestedFrame = clampedFrame;

                    if (rafId) return;

                    rafId = window.requestAnimationFrame(() => {
                        rafId = 0;

                        if (requestedFrame === lastFrame) return;

                        const targetTime =
                            (requestedFrame / (TOTAL_FRAMES - 1)) *
                            video.duration;

                        video.currentTime = targetTime;
                        lastFrame = requestedFrame;
                    });
                };

                ScrollTrigger.matchMedia({
                    [DESKTOP_QUERY]: () => {
                        const seekTrigger = ScrollTrigger.create({
                            trigger: root,
                            start: "top top",
                            endTrigger: outro,
                            end: "top top",
                            scrub: true,
                            onUpdate: (self) => {
                                const frame = Math.round(
                                    self.progress * (TOTAL_FRAMES - 1),
                                );

                                seekToFrame(getActiveVideo(), frame);
                            },
                        });

                        const expansion = gsap.fromTo(
                            videoWrap,
                            {
                                transform: "translateX(50%)",
                                right: "0%",
                                width: "100%",
                                x: 0,
                            },
                            {
                                transform: "translateX(0%)",
                                right: "0%",
                                width: "100%",
                                x: 0,
                                ease: "none",
                                scrollTrigger: {
                                    trigger: outro,
                                    start: "top bottom",
                                    end: "center center",
                                    scrub: true,
                                    invalidateOnRefresh: true,
                                },
                            },
                        );

                        return () => {
                            seekTrigger.kill();
                            expansion.scrollTrigger?.kill();
                            expansion.kill();

                            gsap.set(videoWrap, {
                                clearProps: "left,width,transform",
                            });
                        };
                    },
                });
            }
        }
    }
</script>

<style>
    .ds-hero-step {
        position: sticky;
        top: calc(-10svh - var(--navbar-height));
    }

    .ds-hero {
        position: relative;
        background: var(--bg);
        overflow: clip;
    }

    .ds-hero__frame {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-areas:
            "content video"
            "outro outro";
        align-items: start;
        /* padding-top: calc(var(--navbar-height) + var(--sp-8)); */
    }

    .ds-hero__left {
        grid-area: content;
        position: relative;
        z-index: 2;
        min-width: 0;
        /* padding-right: var(--sp-6); */
    }

    .ds-hero__intro {
        display: grid;
        align-content: center;
        gap: var(--sp-4);
        min-height: calc(100svh - var(--navbar-height));
        max-width: 36rem;
    }

    .ds-hero__title {
        margin: 0;
    }

    .ds-hero__lead {
        margin: 0;
        max-width: 56ch;
    }

    .ds-hero__cards {
        position: relative;
        display: grid;
        max-width: 34rem;
        padding-bottom: 22svh;
        top: calc(25svh - var(--navbar-height));
    }

    .ds-card-step {
        position: sticky;
        top: 50svh;
        min-height: 30svh;
        --card-height: calc(100px + var(--sp-4));
    }

    .ds-card {
        position: sticky;
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: var(--sp-3);
        padding: var(--sp-4);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        background: var(--surface);
        height: 100px; /*80px*/
    }

    .ds-card-step:nth-child(2) {
        translate: 0 calc(var(--card-height));
    }
    .ds-card-step:nth-child(3) {
        translate: 0 calc(var(--card-height) * 2);
    }
    .ds-card-step:nth-child(4) {
        translate: 0 calc(var(--card-height) * 3);
    }
    .ds-card-step:nth-child(5) {
        translate: 0 calc(var(--card-height) * 4);
    }

    .ds-card__icon {
        width: var(--sp-7);
        height: var(--sp-7);
        border-radius: var(--radius);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: color-mix(in srgb, var(--color-brand) 18%, transparent);
        color: var(--color-brand);
        border: 1px solid var(--color-brand);
    }

    .ds-card__title {
        margin: 0;
        font-size: var(--text-base);
        line-height: 1.3;
    }

    .ds-card__text {
        margin: 0;
        color: var(--text-secondary);
        font-size: var(--text-sm);
        line-height: 1.45;
    }

    .ds-hero__video-wrap {
        grid-column: 1 / -1;
        grid-row: 1;
        position: sticky;
        top: var(--navbar-height);
        left: 50%;
        justify-self: stretch;
        width: 50%;
        height: calc(100svh - var(--navbar-height));
        min-width: 0;
        z-index: 1;
        will-change: left, width, transform;
        overflow: visible;
        /* mix-blend-mode: lighten; */
    }

    /* :global([data-theme="dark"]) .ds-hero__video-wrap {
        mix-blend-mode: lighten;
    }

    :global([data-theme="light"]) .ds-hero__video-wrap {
        mix-blend-mode: darken;
    } */

    .ds-hero__video-shell {
        position: relative;
        width: 100%;
        height: 100%;
        /* overflow: hidden; */
        overflow: visible;
        background: transparent;
    }

    .ds-hero__video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border: 0;
    }

    .ds-hero__video--light {
        display: none;
    }

    :global([data-theme="light"]) .ds-hero__video--dark {
        display: none;
    }

    :global([data-theme="light"]) .ds-hero__video--light {
        display: block;
    }

    .ds-hero__outro {
        grid-area: outro;
        position: relative;
        z-index: 3;
        min-height: 100svh;
        display: grid;
        place-items: center;
        text-align: center;
    }

    .ds-hero__outro-content {
        display: grid;
        justify-items: center;
        gap: var(--sp-3);
        max-width: 42rem;
        padding: var(--sp-6);
    }

    .ds-hero__outro-title,
    .ds-hero__outro-copy {
        margin: 0;
    }

    .ds-hero__outro-cta {
        width: fit-content;
        align-items: center;
    }

    @media (max-width: 1024px) {
        .ds-hero {
            overflow: visible;
        }

        .ds-hero__frame {
            grid-template-columns: 1fr;
            grid-template-areas:
                "video"
                "content"
                "outro";
            gap: var(--sp-6);
        }

        .ds-hero__video-wrap {
            grid-area: video;
            grid-column: auto;
            grid-row: auto;
            position: relative;
            top: auto;
            left: auto;
            justify-self: stretch;
            width: 100%;
            height: auto;
            /* aspect-ratio: 16 / 10; */
            will-change: auto;
        }

        .ds-hero__left {
            padding-right: 0;
        }

        .ds-hero__intro {
            min-height: auto;
            padding-block: var(--sp-6);
        }

        .ds-hero__cards {
            gap: var(--sp-3);
            padding-bottom: 0;
        }

        .ds-card-step {
            min-height: auto;
        }

        .ds-card,
        .ds-card-step:nth-child(1) .ds-card,
        .ds-card-step:nth-child(2) .ds-card,
        .ds-card-step:nth-child(3) .ds-card,
        .ds-card-step:nth-child(4) .ds-card {
            position: relative;
            top: auto;
        }

        .ds-hero__outro {
            min-height: auto;
            padding-block: var(--sp-10);
        }
    }

    @media (max-width: 768px) {
        .ds-hero__frame {
            padding-top: calc(var(--navbar-height) + var(--sp-4));
        }

        .ds-hero__outro-content {
            padding-inline: var(--sp-4);
        }

        .ds-hero__outro-title {
            font-size: clamp(1.45rem, 1.1rem + 2.2vw, 2rem);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .ds-hero__video-wrap {
            will-change: auto;
        }
    }
</style>
