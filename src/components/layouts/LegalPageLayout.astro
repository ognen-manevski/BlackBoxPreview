---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/types';
import { legalTranslations } from '../../i18n/pages/legal';
import '../../styles/legal.css';

interface Props { lang: Lang; title: string; description: string; restoreListMarkers?: boolean; styledHeader?: boolean; }
const { lang, title, description, restoreListMarkers = false, styledHeader = false } = Astro.props;
const t = legalTranslations[lang];
---

<BaseLayout lang={lang} title={`${title} | BlackBox Solutions`} description={description}>
  <div class="legal-page">
    <article class="legal-page__article container">
      <header class:list={["legal-page__header", styledHeader && "legal-page__header--styled"]}>
        <p class="section-label">{t.eyebrow}</p>
        <h1>{title}</h1>
        <p class="legal-page__updated"><strong>{t.lastUpdated}:</strong> {t.updatedDate}</p>
      </header>
      <div class="legal-page__content" data-list-markers={restoreListMarkers || undefined}><slot /></div>
    </article>
  </div>
</BaseLayout>
