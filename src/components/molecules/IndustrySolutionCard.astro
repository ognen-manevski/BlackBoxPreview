---
interface Props {
    number: string;
    title: string;
    excerpt: string;
    imageSrc?: string;
    imageAlt?: string;
}

const { number, title, excerpt, imageSrc, imageAlt = '' } = Astro.props as Props;
const hasImage = Boolean(imageSrc);
---

<article class="industry-solution-card" aria-label={title}>
    <p class="industry-solution-card__number">{number}</p>

    <div class:list={["industry-solution-card__body", hasImage && "has-image"]}>
        <div class="industry-solution-card__content">
            <h3 class="industry-solution-card__title">{title}</h3>
            <p class="industry-solution-card__excerpt">{excerpt}</p>
        </div>

        {
            imageSrc && (
                <div class="industry-solution-card__thumb-wrap" aria-hidden="true">
                    <img
                        class="industry-solution-card__thumb"
                        src={imageSrc}
                        alt={imageAlt}
                        loading="lazy"
                        decoding="async"
                    />
                </div>
            )
        }
    </div>
</article>

<style>
    .industry-solution-card {
        display: grid;
        grid-template-columns: min-content minmax(0, 1fr);
        gap: var(--sp-4);
        align-items: stretch;
        width: 100%;
        height: 100%;
        min-height: 13.5rem;
        padding: var(--sp-5);
        background:  var(--bg-secondary);
    }

    .industry-solution-card__number {
        font-family: var(--font-mono);
        font-size: var(--text-lg);
        font-weight: var(--weight-semibold);
        color: var(--color-brand);
        line-height: 1;
        align-self: start;
        margin-top: 0.1em;
    }

    .industry-solution-card__body {
        display: grid;
        min-width: 0;
    }

    .industry-solution-card__body.has-image {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.435fr);
        gap: var(--sp-4);
        align-items: center;
    }

    .industry-solution-card__content {
        display: grid;
        grid-template-rows: auto 1fr;
        row-gap: var(--sp-3);
        min-width: 0;
    }

    .industry-solution-card__title {
        font-size: clamp(1.2rem, 0.35vw + 1.05rem, 1.45rem);
        line-height: 1.25;
        margin: 0;
    }

    .industry-solution-card__excerpt {
        color: var(--text-secondary);
        margin: 0;
        max-width: 34ch;
        line-height: 1.6;
    }

    .industry-solution-card__thumb-wrap {
        width: 100%;
        align-self: center;
        border-radius: var(--radius);
        overflow: hidden;
    }

    .industry-solution-card__thumb {
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
        display: block;
        transition: transform 0.25s ease;
    }

    .industry-solution-card:is(:hover, :focus-within) .industry-solution-card__thumb {
        transform: scale(1.03);
    }

    @media (max-width: 1200px) {
        .industry-solution-card__body.has-image {
            grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
        }
    }

    @media (max-width: 700px) {
        .industry-solution-card {
            grid-template-columns: min-content minmax(0, 1fr);
            gap: var(--sp-3);
            padding: var(--sp-4);
            min-height: auto;
        }

        .industry-solution-card__body.has-image {
            grid-template-columns: 1fr;
            gap: var(--sp-3);
        }

        .industry-solution-card__thumb-wrap {
            grid-column: auto;
        }
    }
</style>