---
import { Image } from "astro:assets";
import ArrowButton from "../atoms/ArrowButton.astro";
import ProgressiveImage from "../atoms/ProgressiveImage.astro";
import HeroTrust from "../molecules/HeroTrust.astro";
import neoslideDarkLong from '../../assets/images/home/long/neoslide-dark-long.jpg';
import shelfLabelsDarkLong from '../../assets/images/home/long/labels-dark-long.jpg';
import videoStreamingDarkLong from '../../assets/images/home/long/video-dark-long.jpg';
import softwareDevelopmentDarkLong from '../../assets/images/home/long/code-dark-long.jpg';
import bgGradient2DarkPoster from '../../assets/images/video-thumbnails/gradients/dark/gradient-2-grain-0.jpg';
import arrowForwardSvg from '../../assets/vectors/icons/material/custom/arrow_forward-400w.svg?raw';
import { getLocalizedPath } from '../../i18n/utils';
import type { HomePageContent } from '../../i18n/pages/home';
import type { Lang } from '../../i18n/types';
import { getImageOutputWidth, getOptimizedImageUrl, getResponsiveImageWidths } from '../../utils/images';
interface Props { content: HomePageContent['hero']; lang: Lang; }
const { content, lang } = Astro.props;
const slideAriaLabel = (index: number, label: string) => `${index + 1} of ${content.slides.length}: ${label}`;
const optimizedBackgroundPoster = await getOptimizedImageUrl(bgGradient2DarkPoster, 1600);
---

<section class="hero" id="hero" aria-label={content.ariaLabel}>
  <div class="hero__background" aria-hidden="true">
    <video
      class="hero__bg-video"
      src={`${import.meta.env.BASE_URL}videos/gradients/dark/base-gradient-2.mp4`}
      poster={optimizedBackgroundPoster}
      autoplay
      muted
      loop
      playsinline
    ></video>
  </div>

  <div class="container">
    <div class="hero__inner">
    <!-- ========== LEFT: CONTENT ========== -->
    <div class="hero__content">
      <!-- Headline -->
      <h1 class="hero__headline section-headline section-headline--hero" data-lang={lang}>
        {lang === 'en' ? (
          <>
            <span class="hero__headline-layout hero__headline-layout--english-wide">
              {content.headlineLineOne}<br />
              {content.headlineLineTwo}<br />
              <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: 0s;">{content.highlights[0]}</span>{' '}
              <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -1.67s;">{content.highlights[1]}</span><br />
              {content.conjunction}{' '}
              <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -3.33s;">{content.highlights[2]}</span>
            </span>
            <span class="hero__headline-layout hero__headline-layout--english-narrow">
              {content.headlineLineOne}<br />
              {content.headlineLineTwoNarrow}<br />
              {content.headlineLineThreeNarrow}{' '}
              <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: 0s;">{content.highlights[0]}</span><br />
              <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -1.67s;">{content.highlights[1]}</span>{' '}
              {content.conjunction}{' '}
              <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -3.33s;">{content.highlights[2]}</span>
            </span>
          </>
        ) : (
          <span class="hero__headline-layout hero__headline-layout--macedonian">
            {content.headlineLineOne}<br />
            {content.headlineLineTwoNarrow}{' '}
            <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: 0s;">{content.highlights[0]}</span><br />
            <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -1.67s;">{content.highlights[1]}</span>{' '}
            {content.headlineLineThreeSuffix}<br />
            {content.headlineLineFour}
          </span>
        )}
        <span class="hero__headline-layout hero__headline-layout--mobile">
          {content.headlineStart}
          <span class="hero-highlight-group">
            <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: 0s;">{content.highlights[0]}</span>&#32;
            <span class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -1.67s;">{content.highlights[1]}</span>&#32; {content.conjunction} <span
              class="hero-highlight hero-highlight--animated" style="--hero-highlight-delay: -3.33s;">{content.highlights[2]}</span
            >
          </span>
        </span>
      </h1>

      <!-- Lead -->
      <p class="hero__lead">
        {content.lead}
      </p>

      <!-- CTAs -->
      <div class="hero__actions">
        <div class="hero__cta-group">
          <ArrowButton href={getLocalizedPath('/book-a-free-demo/', lang)} variant="primary"
            >{content.primaryCta}</ArrowButton
          >
          <a href={getLocalizedPath('/about/', lang)} class="btn btn--ghost">{content.secondaryCta}</a>
        </div>
        <div class="hero__cta-note">{content.ctaNote}</div>
      </div>
    </div>

    <!-- ========== RIGHT: CAROUSEL AND PROOF ========== -->
    <div class="hero__showcase">
      <div
        class="hero__carousel"
        role="region"
        aria-roledescription="carousel"
        aria-label={content.carouselAriaLabel}
      >
        <div class="carousel__viewport">
          <div class="carousel__track">
            <div
              class="carousel__slide"
              role="group"
              aria-roledescription={content.slideRole}
              aria-label={slideAriaLabel(0, content.slides[0])}
            >
              <div class="carousel__field">
                <div class="carousel__media-frame" data-progressive-host="relative">
                  <ProgressiveImage src={neoslideDarkLong}>
                    <Image class="carousel__media" src={neoslideDarkLong} alt="" widths={getResponsiveImageWidths(neoslideDarkLong)} width={getImageOutputWidth(neoslideDarkLong)} sizes="auto, (min-width: 64rem) 40vw, 100vw" format="webp" loading="eager" decoding="async" />
                  </ProgressiveImage>
                </div>
                <div class="carousel__field-title-row">
                  <h3 class="carousel__slide-title">{content.slides[0]}</h3>
                  <ArrowButton class="carousel__field-cta" href={getLocalizedPath('/services/neoslide/', lang)} variant="primary" size="sm">{content.secondaryCta}</ArrowButton>
                </div>
              </div>
            </div>

            <div
              class="carousel__slide"
              role="group"
              aria-roledescription={content.slideRole}
              aria-label={slideAriaLabel(1, content.slides[1])}
            >
              <div class="carousel__field">
                <div class="carousel__media-frame" data-progressive-host="relative">
                  <ProgressiveImage src={shelfLabelsDarkLong}>
                    <Image class="carousel__media" src={shelfLabelsDarkLong} alt="" widths={getResponsiveImageWidths(shelfLabelsDarkLong)} width={getImageOutputWidth(shelfLabelsDarkLong)} sizes="auto, (min-width: 64rem) 40vw, 100vw" format="webp" loading="lazy" decoding="async" />
                  </ProgressiveImage>
                </div>
                <div class="carousel__field-title-row">
                  <h3 class="carousel__slide-title">{content.slides[1]}</h3>
                  <ArrowButton class="carousel__field-cta" href={getLocalizedPath('/digital-signage-displays/electronic-shelf-labels/', lang)} variant="primary" size="sm">{content.secondaryCta}</ArrowButton>
                </div>
              </div>
            </div>

            <div
              class="carousel__slide"
              role="group"
              aria-roledescription={content.slideRole}
              aria-label={slideAriaLabel(2, content.slides[2])}
            >
              <div class="carousel__field">
                <div class="carousel__media-frame" data-progressive-host="relative">
                  <ProgressiveImage src={videoStreamingDarkLong}>
                    <Image class="carousel__media" src={videoStreamingDarkLong} alt="" widths={getResponsiveImageWidths(videoStreamingDarkLong)} width={getImageOutputWidth(videoStreamingDarkLong)} sizes="auto, (min-width: 64rem) 40vw, 100vw" format="webp" loading="lazy" decoding="async" />
                  </ProgressiveImage>
                </div>
                <div class="carousel__field-title-row">
                  <h3 class="carousel__slide-title">{content.slides[2]}</h3>
                  <ArrowButton class="carousel__field-cta" href={getLocalizedPath('/services/video-streaming/', lang)} variant="primary" size="sm">{content.secondaryCta}</ArrowButton>
                </div>
              </div>
            </div>

            <div
              class="carousel__slide"
              role="group"
              aria-roledescription={content.slideRole}
              aria-label={slideAriaLabel(3, content.slides[3])}
            >
              <div class="carousel__field">
                <div class="carousel__media-frame" data-progressive-host="relative">
                  <ProgressiveImage src={softwareDevelopmentDarkLong}>
                    <Image class="carousel__media" src={softwareDevelopmentDarkLong} alt="" widths={getResponsiveImageWidths(softwareDevelopmentDarkLong)} width={getImageOutputWidth(softwareDevelopmentDarkLong)} sizes="auto, (min-width: 64rem) 40vw, 100vw" format="webp" loading="lazy" decoding="async" />
                  </ProgressiveImage>
                </div>
                <div class="carousel__field-title-row">
                  <h3 class="carousel__slide-title">{content.slides[3]}</h3>
                  <ArrowButton class="carousel__field-cta" href={getLocalizedPath('/services/software-development/', lang)} variant="primary" size="sm">{content.secondaryCta}</ArrowButton>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="carousel__nav">
        <button
          class="carousel__arrow carousel__arrow--prev"
          type="button"
          aria-label="Previous slide"
          data-carousel-prev
        >
          <span class="carousel__arrow-icon" set:html={arrowForwardSvg} />
        </button>

        <div class="carousel__dots" role="tablist" aria-label={content.slideIndicators}>
          <button
            class="carousel__dot"
            type="button"
            role="tab"
            data-index="0"
            aria-label={content.slides[0]}
            aria-selected="true"></button>
          <button
            class="carousel__dot"
            type="button"
            role="tab"
            data-index="1"
            aria-label={content.slides[1]}
            aria-selected="false"></button>
          <button
            class="carousel__dot"
            type="button"
            role="tab"
            data-index="2"
            aria-label={content.slides[2]}
            aria-selected="false"></button>
          <button
            class="carousel__dot"
            type="button"
            role="tab"
            data-index="3"
            aria-label={content.slides[3]}
            aria-selected="false"></button>
        </div>

        <button
          class="carousel__arrow carousel__arrow--next"
          type="button"
          aria-label="Next slide"
          data-carousel-next
        >
          <span class="carousel__arrow-icon" set:html={arrowForwardSvg} />
        </button>
        </div>
      </div>

      <HeroTrust content={content} />
    </div>
    </div>
  </div>
</section>

<style>


  /* ---- Section shell ---- */
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--hero-background);
    color: var(--text-primary);
    /* min-height: calc(100dvh - 6rem); */
    min-height: min(calc(100dvh - 6rem), 60rem);
    /* max-height: 60rem; */
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity var(--t-base);
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      90deg,
      var(--video-overlay) 0%,
      /* var(--video-overlay) 38%,
      var(--video-overlay-transparent) 78%, */
      var(--video-overlay-transparent) 100%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    gap: var(--sp-9);
    align-items: stretch;
    padding-top: var(--sp-9);
    padding-bottom: var(--sp-9);
    container-type: inline-size;
  }

  /*---- Content ----*/

  .hero__content {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
    container-type: inline-size;
  }

  .hero__lead {
    max-width: 64ch;
  }

  .hero__headline-layout {
    display: none;
  }

  /* ---- Showcase ---- */

  .hero__showcase {
    flex: 1 1 0;
    display: flex;
    max-width: 35rem;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-4);
    min-width: 0;
  }

  @media (min-width: 900px) {

    .hero__headline {
      font-size: var(--hero-headline-fit-size, clamp(2.5rem, 7cqi, 3.75rem));
    }

    .hero__headline-layout--english-wide,
    .hero__headline-layout--english-narrow,
    .hero__headline-layout--macedonian {
      white-space: nowrap;
    }

    .hero__headline-layout--english-narrow,
    .hero__headline-layout--macedonian {
      display: inline;
    }

    .hero__carousel {
      width: 100%;
      box-sizing: border-box;
    }
  }

  @media (min-width: 900px) and (max-height: 930px) {
    .hero {
      height: min(calc(100dvh - 6rem), 60rem);
    }

    .hero > .container {
      height: 100%;
    }

    .hero__inner {
      height: 100%;
      box-sizing: border-box;
      padding-block: clamp(1rem, 7dvh, 4rem);
    }

    .hero__showcase {
      min-height: 0;
    }

    .hero__carousel,
    .carousel__viewport {
      flex: 1;
      min-height: 0;
    }

    .carousel__track,
    .carousel__slide,
    .carousel__field {
      height: 100%;
    }

    .carousel__media-frame {
      flex: 1;
      min-height: 0;
      aspect-ratio: auto;
    }
  }

  @media (min-width: 900px) and (max-height: 760px) {
    .hero__inner {
      padding-block: clamp(1rem, 6dvh, 3rem);
    }

    .hero__content {
      gap: clamp(0.875rem, 2.5dvh, 1rem);
    }
  }

    @media (max-width: 1300px) {
    .hero__inner {
      gap: var(--sp-8);
    }
  }

  @media (max-width: 1200px) {
    .hero__inner {
      gap: var(--sp-7);
    }
  }


  @media (max-width: 1000px) {
    .hero__inner {
      gap: var(--sp-6);
    }
  }

  @media (max-width: 899px) {
    .hero__headline {
      font-size: clamp(2.2rem, 1.3rem + 2.6cqi, 2.4rem);
    }

    .hero__headline-layout--english-wide,
    .hero__headline-layout--english-narrow,
    .hero__headline-layout--macedonian {
      display: none;
    }

    .hero__headline-layout--mobile {
      display: inline;
    }
  }

  /* ---- Lead ---- */

  /* ---- CTAs ---- */
  .hero__actions {
    display: flex;
    flex-direction: column;
    /* align-items: flex-end; */
    gap: var(--sp-4);
    flex-wrap: wrap;
  }

  .hero__cta-group {
    display: flex;
    flex-direction: row;
    gap: var(--sp-3);
  }

  .hero__cta-note {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding-left: var(--sp-1);
  }

  /* ---- Carousel ---- */
  .hero__carousel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--sp-4);
    min-width: 0;
  }

  .carousel__viewport {
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    background: transparent;
  }

  .carousel__viewport:active {
    cursor: grabbing;
  }

  .carousel__track {
    display: flex;
    will-change: transform;
    transition: transform 0.5s ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      transition: none;
    }
  }

  .carousel__slide {
    position: relative;
    /* extra width holds the inter-slide gap outside the viewport when centered */
    width: calc(100% + var(--sp-4));
    box-sizing: border-box;
    padding-right: var(--sp-4);
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .carousel__field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    background: var(--bg);
    border-radius: var(--radius-sm);
    padding: var(--sp-4);
    box-sizing: border-box;
    width: 100%;
  }

  .carousel__media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .carousel__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    user-select: none;
    -webkit-user-drag: none;
    background: transparent;
    transition: opacity var(--t-base);
  }

  .carousel__slide-title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
    line-height: 1.3;
    margin: 0;
    text-align: left;
  }

  .carousel__field-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-top: auto;
  }

  .carousel__field-cta {
    flex: 0 0 auto;
  }

  /* Dot indicators */
  .carousel__nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-1);
  }

  .carousel__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 2.25rem;
    width: 2.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    background: var(--bg);
    color: var(--text-primary);
    cursor: pointer;
    padding: 0;
    transition:
      border-color var(--t-base),
      background var(--t-base),
      color var(--t-base);
  }

  .carousel__arrow:hover,
  .carousel__arrow:focus-visible {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }

  .carousel__arrow-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.125rem;
    height: 1.125rem;
  }

  .carousel__arrow-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }


  .carousel__arrow--prev .carousel__arrow-icon {
    transform: scaleX(-1);
  }

  .carousel__dots {
    --width: 0.6rem;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    height: 2.25rem;
    /* fixed width so the growing active dot never resizes this wrapper */
    width: calc(8 * var(--width) + 3 * var(--sp-2) + 2 * var(--sp-4) + 2px);
    box-sizing: border-box;
    gap: var(--sp-2);
    padding: 0 var(--sp-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg);
  }

  .carousel__dot {
    position: relative;
    height: var(--width);
    width: var(--width);
    border-radius: var(--radius-sm);
    background: var(--text-muted);
    border: none;
    padding: 0;
    cursor: pointer;
    overflow: hidden;
    transition:
      background var(--t-base),
      width var(--t-base);
  }

  .carousel__dot:hover {
    background: var(--text-secondary);
  }

  .carousel__dot[aria-selected="true"] {
    background: var(--color-brand-darkest);
    width: calc(var(--width) * 5);
  }

  .carousel__dot[aria-selected="true"]::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--color-brand);
    transform: scaleX(0);
    transform-origin: left;
  }

  .carousel__dot.is-progressing::after {
    animation: carousel-dot-progress 4.5s linear forwards;
  }

  @keyframes carousel-dot-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* ---- Responsive ---- */
  @media (max-width: 899px) {
    .hero__inner {
      flex-direction: column;
      align-items: center;
    }

    .hero__content,
    .hero__showcase {
      display: contents;
    }

    .hero__headline,
    .hero__lead {
      text-align: center;
    }

    .hero__lead {
      align-self: center;
    }

    .hero__actions {
      align-self: center;
      align-items: center;
    }

    .hero__cta-group {
      justify-content: center;
    }

    .hero__cta-note {
      padding-left: 0;
      text-align: center;
    }

    .hero__carousel {
      order: 1;
      margin-top: var(--sp-2);
      width: 100%;
      max-width: 35rem;
      align-self: center;
      box-sizing: border-box;
    }

    .hero__showcase > :global(.hero-proof) {
      order: -1;
      max-width: 35rem;
      margin-inline: auto;
    }

    .hero {
      min-height: auto;
      max-height: none;
    }
  }

  @media (max-width: 580px) {
    .hero__inner {
      padding-top: var(--sp-7);
      padding-bottom: var(--sp-7);
      align-items: stretch;
    }

    .hero__headline,
    .hero__lead {
      text-align: left;
    }

    .hero__lead {
      font-size: var(--text-base);
    }

    .hero__actions {
      flex-direction: column;
      align-items: flex-start;
      align-self: stretch;
    }

    .hero__cta-group {
      justify-content: flex-start;
    }

    .hero__cta-note {
      text-align: left;
    }

    .hero__carousel {
      padding: var(--sp-4);
    }

    .hero__carousel {
      max-width: none;
    }

    .hero__showcase > :global(.hero-proof) {
      max-width: none;
    }
  }

  @media (max-width: 480px) {
    .hero__cta-group {
      width: 100%;
      flex-direction: column;
      align-items: stretch;
    }

    .hero__cta-group > * {
      width: 100%;
      box-sizing: border-box;
    }
  }

  @media (max-width: 370px) {
    .hero__headline {
      font-size: clamp(1.9rem, 6.5vw, 2rem);
    }
  }

</style>

<script>
  const root = document.getElementById("hero");
  const headline = root?.querySelector<HTMLElement>(".hero__headline");
  const headlineContent = headline?.parentElement ?? null;
  const headlineLead = headlineContent?.querySelector<HTMLElement>(".hero__lead") ?? null;
  const headlineActions = headlineContent?.querySelector<HTMLElement>(".hero__actions") ?? null;

  if (headline && headlineContent && headlineLead && headlineActions) {
    const fitHeadline = () => {
      if (window.innerWidth < 900) {
        headline.style.removeProperty("--hero-headline-fit-size");
        return;
      }

      const activeLayout = Array.from(
        headline.querySelectorAll<HTMLElement>(".hero__headline-layout"),
      ).find((layout) => getComputedStyle(layout).display !== "none");
      if (!activeLayout) return;

      const sampleFontSize = 48;
      const probe = headline.cloneNode(true) as HTMLElement;
      probe.setAttribute("aria-hidden", "true");
      Object.assign(probe.style, {
        position: "fixed",
        left: "-10000px",
        top: "0",
        width: "max-content",
        maxWidth: "none",
        margin: "0",
        fontSize: `${sampleFontSize}px`,
        lineHeight: "1.1",
        whiteSpace: "nowrap",
        visibility: "hidden",
        pointerEvents: "none",
      });
      document.body.append(probe);
      const probeBounds = probe.getBoundingClientRect();
      probe.remove();

      const headlineStyle = getComputedStyle(headline);
      const leadStyle = getComputedStyle(headlineLead);
      const actionsStyle = getComputedStyle(headlineActions);
      const margins =
        parseFloat(headlineStyle.marginBlockStart) +
        parseFloat(headlineStyle.marginBlockEnd) +
        parseFloat(leadStyle.marginBlockStart) +
        parseFloat(leadStyle.marginBlockEnd) +
        parseFloat(actionsStyle.marginBlockStart) +
        parseFloat(actionsStyle.marginBlockEnd);
      const availableWidth =
        headlineContent.clientWidth -
        parseFloat(headlineStyle.marginInlineStart) -
        parseFloat(headlineStyle.marginInlineEnd);
      const availableHeight =
        headlineContent.clientHeight -
        headlineLead.offsetHeight -
        headlineActions.offsetHeight -
        margins -
        2 * 16;
      const heightScale = Math.min(1, window.innerHeight / 930);
      const shortViewportScale =
        window.innerHeight <= 760
          ? Math.max(0.5, (window.innerHeight - 80) / window.innerHeight)
          : 1;
      const scale = Math.min(
        availableWidth / probeBounds.width,
        availableHeight / probeBounds.height,
      ) * heightScale * shortViewportScale;

      if (Number.isFinite(scale) && scale > 0) {
        headline.style.setProperty(
          "--hero-headline-fit-size",
          `${Math.max(12, sampleFontSize * scale)}px`,
        );
      }
    };

    const fitOnFrame = () => window.requestAnimationFrame(fitHeadline);
    const resizeObserver = new ResizeObserver(fitOnFrame);
    resizeObserver.observe(headlineContent);
    resizeObserver.observe(headlineLead);
    resizeObserver.observe(headlineActions);
    window.addEventListener("resize", fitOnFrame);
    document.fonts.ready.then(fitOnFrame);
    fitOnFrame();
  }

  const viewport = root?.querySelector<HTMLElement>(".carousel__viewport") ?? null;
  const track = root?.querySelector<HTMLElement>(".carousel__track") ?? null;
  const dots = Array.from(root?.querySelectorAll<HTMLButtonElement>(".carousel__dot") ?? []);
  const prevBtn = root?.querySelector<HTMLButtonElement>("[data-carousel-prev]");
  const nextBtn = root?.querySelector<HTMLButtonElement>("[data-carousel-next]");

  if (viewport && track) {
    const carouselTrack = track;
    const slides = Array.from(
      carouselTrack.querySelectorAll<HTMLElement>(".carousel__slide"),
    );
    const total = slides.length;

    const preloadImages = (root: ParentNode) =>
      Array.from(root.querySelectorAll<HTMLImageElement>("img")).map((image) => {
        image.loading = "eager";
        return image.decode().catch(() => undefined);
      });

    preloadImages(carouselTrack);

    if (total > 1) {
      // Keep one clone on each side so the end-to-start transition stays seamless.
      const firstClone = slides[0].cloneNode(true) as HTMLElement;
      const lastClone = slides[total - 1].cloneNode(true) as HTMLElement;
      firstClone.setAttribute("aria-hidden", "true");
      lastClone.setAttribute("aria-hidden", "true");
      [firstClone, lastClone].forEach((clone) => {
        preloadImages(clone);
      });
      carouselTrack.appendChild(firstClone);
      carouselTrack.insertBefore(lastClone, slides[0]);

      let current = 1; // 0 = lastClone, 1..total = real slides, total+1 = firstClone
      let startX = 0;
      let dragDiff = 0;
      let dragging = false;
      let isAnimating = false;
      let queuedDirection = 0;
      let timer = 0;
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      // Slide width includes the inter-slide gap, so step by its full width.
      const w = () => slides[0]?.offsetWidth ?? viewport.offsetWidth;

      function syncDots(idx: number) {
        const real = (((idx - 1) % total) + total) % total;
        dots.forEach((dot, i) =>
          dot.setAttribute("aria-selected", String(i === real)),
        );
        startProgress();
      }

      function pauseProgress() {
        dots.forEach((dot) => dot.classList.remove("is-progressing"));
      }

      function startProgress() {
        const activeDot = dots.find((dot) => dot.getAttribute("aria-selected") === "true");
        pauseProgress();
        if (reduced || !activeDot) return;
        void activeDot.offsetWidth;
        activeDot.classList.add("is-progressing");
      }

      function pauseAutoplay() {
        clearInterval(timer);
        pauseProgress();
      }

      function setPosition(idx: number, animated = true) {
        const shouldAnimate = animated && !reduced;
        carouselTrack.style.transition = shouldAnimate
          ? "transform 0.5s ease"
          : "none";
        carouselTrack.style.transform = `translateX(${-idx * w()}px)`;
      }

      function normalizePosition() {
        if (current === 0) {
          // Last-slide clone -> matching real last slide.
          current = total;
          setPosition(current, false);
        } else if (current === total + 1) {
          // First-slide clone -> matching real first slide.
          current = 1;
          setPosition(current, false);
        }
      }

      function go(direction: number) {
        // Never let current move beyond the two available clones.
        // If another input arrives mid-transition, remember one follow-up move.
        if (isAnimating) {
          queuedDirection = direction;
          return;
        }

        current += direction;
        syncDots(current);

        if (reduced) {
          normalizePosition();
          setPosition(current, false);
          return;
        }

        isAnimating = true;
        setPosition(current, true);
      }

      function goToSlide(index: number) {
        if (isAnimating) return;

        const target = index + 1;
        if (target === current) return;

        current = target;
        syncDots(current);

        if (reduced) {
          setPosition(current, false);
          return;
        }

        isAnimating = true;
        setPosition(current, true);
      }

      function finishTransition() {
        normalizePosition();
        isAnimating = false;

        if (queuedDirection !== 0) {
          const direction = queuedDirection;
          queuedDirection = 0;
          requestAnimationFrame(() => go(direction));
        }
      }

      // Once a movement finishes, silently swap a clone for its matching real
      // slide before accepting the next queued movement.
      carouselTrack.addEventListener("transitionend", (event) => {
        if (event.target !== carouselTrack || event.propertyName !== "transform") return;
        finishTransition();
      });

      // If a resize or browser interruption cancels a transform transition,
      // release the animation lock instead of leaving the carousel stuck.
      carouselTrack.addEventListener("transitioncancel", (event) => {
        if (event.target !== carouselTrack || event.propertyName !== "transform") return;
        finishTransition();
      });

      // Dot clicks
      dots.forEach((dot, i) => {
        dot.addEventListener("click", () => {
          goToSlide(i);
          resetAutoplay();
        });
      });

      // Arrow buttons
      prevBtn?.addEventListener("click", () => {
        go(-1);
        resetAutoplay();
      });

      nextBtn?.addEventListener("click", () => {
        go(1);
        resetAutoplay();
      });

      function tick() {
        go(1);
      }

      function startAutoplay() {
        if (reduced) return;
        clearInterval(timer);
        startProgress();
        timer = window.setInterval(tick, 4500);
      }

      function resetAutoplay() {
        pauseAutoplay();
        startAutoplay();
      }

      // Drag / swipe via Pointer Events
      viewport.addEventListener("pointerdown", (e) => {
        if (isAnimating) return;
        if (e.pointerType === "mouse" && e.button !== 0) return;
        if (e.target instanceof Element && e.target.closest("a")) return;

        e.preventDefault();
        dragging = true;
        startX = e.clientX;
        dragDiff = 0;
        carouselTrack.style.transition = "none";
        viewport.setPointerCapture(e.pointerId);
        pauseAutoplay();
      });

      viewport.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        dragDiff = e.clientX - startX;
        carouselTrack.style.transform = `translateX(${-current * w() + dragDiff}px)`;
      });

      const finishDrag = () => {
        if (!dragging) return;
        dragging = false;

        const threshold = w() * 0.18;

        if (dragDiff < -threshold) {
          go(1);
        } else if (dragDiff > threshold) {
          go(-1);
        } else if (Math.abs(dragDiff) > 1 && !reduced) {
          // Snap back only when the pointer actually displaced the track.
          // This avoids waiting for a transitionend that cannot fire.
          isAnimating = true;
          setPosition(current, true);
        } else {
          setPosition(current, false);
        }

        syncDots(current);
        startAutoplay();
      };

      viewport.addEventListener("pointerup", finishDrag);
      viewport.addEventListener("pointercancel", finishDrag);
      viewport.addEventListener("lostpointercapture", finishDrag);

      // Pause autoplay on hover
      viewport.addEventListener("mouseenter", pauseAutoplay);
      viewport.addEventListener("mouseleave", () => {
        if (!dragging) startAutoplay();
      });

      // Init
      setPosition(current, false);
      syncDots(current);
      startAutoplay();

      window.addEventListener("resize", () => {
        isAnimating = false;
        queuedDirection = 0;
        normalizePosition();
        setPosition(current, false);
      }, { passive: true });
    }
  }
</script>
