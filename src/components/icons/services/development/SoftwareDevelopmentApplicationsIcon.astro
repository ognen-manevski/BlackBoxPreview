<svg class="sd-applications-icon-ca" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="1400" height="1200" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1400 1200">
  <defs>
    <style>


      .sd-applications-icon-ca {
        --fill-color: var(--icon-bg);
        --stroke-color: var(--color-brand);
      }


      .cls-1-ca, .cls-2-ca, .cls-3-ca {
        fill: none;
      }

      .cls-2-ca {
        fill-rule: evenodd;
      }

      .cls-2-ca, .cls-3-ca {
        stroke: var(--stroke-color);
        stroke-miterlimit: 10;
        stroke-width: 5px;
      }

      .cls-4-ca {
        clip-path: url(#sd-applications-clippath-ca);
      }

      #hand-ca, #arrow-ca{
        fill: var(--fill-color);
      }

      .sd-service-card:hover .sd-applications-icon-ca #hand-ca{
        animation: hand-anim-ca 4s ease infinite;
      }

      @keyframes hand-anim-ca {
        0%,
        100% {
          transform: translate(0px, 0px);
        }
        50% {
          transform: translate(0px, -200px);
        }
      }

      .sd-service-card:hover .sd-applications-icon-ca #info-popup-ca{
        animation: info-popup-anim-ca 4s ease-in-out infinite;
      }

      @keyframes info-popup-anim-ca {
        0%,
        100% {
          transform: translate(0px, 0px);
        }
        50% {
          transform: translate(0px, -150px);
        }
      }

      #app-1-ca, #app-2-ca{
        transform-box: fill-box;
        transform-origin: center;
      }

      .sd-service-card:hover .sd-applications-icon-ca #app-1-ca {
        animation: app-1-hover-anim-ca 4s ease infinite;
      }

      @keyframes app-1-hover-anim-ca {
        0%, 20%, 70%, 100% {
          transform: translateY(0) rotate(0deg);
        }

        30%, 60% {
          transform: translateY(-20px) rotate(-5deg);
        }
      }

      .sd-service-card:hover .sd-applications-icon-ca #app-2-ca {
        transform-box: fill-box;
        transform-origin: center;
        animation: app-2-hover-anim-ca 4s ease infinite;
      }

      @keyframes app-2-hover-anim-ca {
        0%, 10%, 80%, 100% {
          transform: translateY(20px) rotate(5deg);
        }

        20%, 70% {
          transform: translateY(0) rotate(0deg);
        }
      }

      #signal-ca{
        r: 0px;
      }

      .sd-service-card:hover .sd-applications-icon-ca #signal-ca{
        --r: 62.23889px;
        animation: signal-anim-ca 4s ease infinite;
      }

      @keyframes signal-anim-ca {
        0%{
          r: 0px;
        }
        100% {
          r: 400px;
        }
      }

      #s-1-ca, #s-2-ca, #s-3-ca{
        transform-box: fill-box;
        transform-origin: center;
      }

      #s-3-ca{
        --duration: 2s;
        --delay: 0s;
      }

      #s-2-ca{
        --duration: 2s;
        --delay: 0.1s;
      }

      #s-1-ca{
        --duration: 2s;
        --delay: 0.2s;
      }

      .sd-service-card:hover .sd-applications-icon-ca #s-1-ca, .sd-service-card:hover .sd-applications-icon-ca #s-2-ca, .sd-service-card:hover .sd-applications-icon-ca #s-3-ca{
        animation: wifi-anim-ca var(--duration) step-start infinite;
        animation-delay: var(--delay);
      }


      @keyframes wifi-anim-ca {
        0%, 55%, 100% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
      }

    </style>
