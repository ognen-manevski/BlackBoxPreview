---
import SoftwareDevelopmentServiceCard from '../../../molecules/services/software-development/SoftwareDevelopmentServiceCard.astro';
import SectionTitleGroup from '../../../molecules/SectionTitleGroup.astro';
import type { SoftwareDevelopmentContent } from '../../../../i18n/pages/services/software-development.ts';
import SoftwareDevelopmentApplicationsIcon from '../../../icons/services/development/SoftwareDevelopmentApplicationsIcon.astro';
import SoftwareDevelopmentFrontendIcon from '../../../icons/services/development/SoftwareDevelopmentFrontendIcon.astro';
import SoftwareDevelopmentBackendIcon from '../../../icons/services/development/SoftwareDevelopmentBackendIcon.astro';
import SoftwareDevelopmentIntegrationsIcon from '../../../icons/services/development/SoftwareDevelopmentIntegrationsIcon.astro';

// import SoftwareDevIntegrationsIcon from '../../../../assets/vectors/illustrations/software-development/dev_integrations.svg'
// import SoftwareDevApplicationsIcon from '../../../../assets/vectors/illustrations/software-development/dev_applications.svg'

const serviceIcons = [
  SoftwareDevelopmentApplicationsIcon,
  SoftwareDevelopmentFrontendIcon,
  SoftwareDevelopmentBackendIcon,
  SoftwareDevelopmentIntegrationsIcon,
];
interface Props { content: SoftwareDevelopmentContent['services'] } const { content } = Astro.props; const cards = content.cards;
---

<section class="section sd-services" aria-labelledby="sd-services-heading">
  <div class="grid-bg"></div>
  <div class="container sd-services__container u-section-title-stack">
    <SectionTitleGroup
      class="sd-services__intro"
      label={content.label}
      heading={content.heading}
      headingId="sd-services-heading"
      titleWidth="42%"
      headlineWidth="26ch"
      copy={content.copy}
    />

    <div class="sd-services__grid" aria-label={content.ariaLabel}>
      {
        cards.map((card, index) => {
          const Icon = serviceIcons[index];

          return (
            <SoftwareDevelopmentServiceCard
              counter={card.counter}
              title={card.title}
              description={card.description}
            >
              {Icon && <Icon slot="visual" />}
            </SoftwareDevelopmentServiceCard>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .sd-services {
    background: var(--bg);
    border-bottom: 1px solid var(--border-color);
    position: relative;
  }

  .sd-services__container {
    position: relative;
    z-index: 1;
  }

  .sd-services__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
    align-items: stretch;
  }


  @media (max-width: 1024px) {
    .sd-services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-4);
    }
  }

  @media (max-width: 640px) {
    .sd-services__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 400px) {
    :global(.sd-services .grid-bg::before) {
      background-size: 3rem 3rem;
    }

    :global(.sd-services .section-headline) {
      font-size: clamp(1.35rem, 7vw, 2rem);
      line-height: 1.15;
    }

    :global(.sd-service-card__title) {
      font-size: clamp(1.1rem, 6vw, var(--text-lg));
      line-height: 1.2;
    }
  }
</style>
