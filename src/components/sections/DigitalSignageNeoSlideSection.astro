---
import type { DigitalSignageContent } from '../../i18n/pages/digital-signage';
interface Props { content: DigitalSignageContent['neoSlide'] } const { content } = Astro.props;
---
<section class="ds-neoslide" aria-labelledby="ds-neoslide-heading">
    <div class="container ds-neoslide__container">
        <div class="ds-neoslide__content">
            <p class="section-label">{content.label}</p>
            <h2 class="section-headline ds-neoslide__headline" id="ds-neoslide-heading">
                {content.heading}
            </h2>
            <p class="section-copy ds-neoslide__copy">
                {content.copy}
            </p>
        </div>
    </div>
</section>

<style>
    .ds-neoslide {
        background: var(--bg);
        padding: var(--sp-9) 0;
    }

    .ds-neoslide__container {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
    }

    .ds-neoslide__content {
        display: grid;
        gap: var(--sp-3);
        max-width: 50rem;
    }

    .ds-neoslide__headline,
    .ds-neoslide__copy {
        margin: 0;
    }

    .ds-neoslide__headline {
        max-width: 18ch;
    }

    .ds-neoslide__copy {
        max-width: 58ch;
    }

    @media (max-width: 768px) {
        .ds-neoslide {
            padding: var(--sp-8) 0;
        }
    }
</style>
