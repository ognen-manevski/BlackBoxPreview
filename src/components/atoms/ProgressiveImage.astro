---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  /** Match the slotted image. The existing parent must be a progressive host. */
  fit?: 'cover' | 'contain' | 'fill';
  position?: string;
  bounds?: string;
}

const { src, fit = 'cover', position = 'center', bounds = 'inset: 0;' } = Astro.props;
const proxy = src && await getImage({ src, width: Math.min(32, src.width), format: 'webp', quality: 30 });
---

<!-- No wrapper: retain the original image/picture and its scoped styles verbatim. -->
<slot />
{proxy && <span data-progressive-proxy aria-hidden="true" style={bounds}>
  <span style={{ backgroundImage: `url("${proxy.src}")`, backgroundSize: fit === 'fill' ? '100% 100%' : fit, backgroundPosition: position }}></span>
</span>}

<style>
  :global([data-progressive-host]) { isolation: isolate; }
  :global([data-progressive-host="relative"]) { position: relative; }
  [data-progressive-proxy] {
    position: absolute;
    z-index: -1;
    display: block;
    overflow: clip;
    border-radius: inherit;
    pointer-events: none;
    opacity: 1;
    transition: opacity 240ms ease;
  }
  [data-progressive-proxy] > span {
    position: absolute;
    inset: 0;
    background-repeat: no-repeat;
    filter: blur(2rem);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-progressive-proxy] { transition: none; }
  }
</style>

<script>
  import '../../scripts/progressive-images';
</script>
