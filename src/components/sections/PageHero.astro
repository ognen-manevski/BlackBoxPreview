---
import { Image } from 'astro:assets';
import backgroundPoster from '../../assets/images/video-thumbnails/gradients/dark/gradient-2-grain-0.jpg';
import { getImageOutputWidth, getOptimizedImageUrl } from '../../utils/images';

interface Props {
  class?: string;
  eyebrow: string;
  title: string;
  subtitle?: string;
  updatedDate?: string;
  updatedLabel?: string;
  heroImage?: ImageMetadata;
  background?: {
    video: string;
    poster: ImageMetadata;
  };
}

const { class: className, eyebrow, title, subtitle, updatedDate, updatedLabel, heroImage, background } = Astro.props;
const optimizedPoster = await getOptimizedImageUrl(background?.poster ?? backgroundPoster, 1600);
---

<section class:list={['page-hero', className]} aria-label={title}>
  <div class="page-hero__background" aria-hidden="true">
    <video
      class="page-hero__video"
      src={`${import.meta.env.BASE_URL}videos/gradients/dark/${background?.video ?? 'base-gradient-2.mp4'}`}
      poster={optimizedPoster}
      autoplay
      muted
      loop
      playsinline
    ></video>
  </div>
  <div class="container page-hero__inner">
    <header class="page-hero__header">
      <div class="page-hero__copy">
        <p class="section-label">{eyebrow}</p>
        <h1 class="section-headline section-headline--hero larger-title">
          {heroImage && <Image class="page-hero__icon" src={heroImage} alt="" width={getImageOutputWidth(heroImage, 320)} format="webp" loading="eager" decoding="async" />}
          <span>{title}</span>
        </h1>
        {subtitle && <p class="page-hero__subtitle section-copy">{subtitle}</p>}
        {updatedDate && updatedLabel && (
          <p class="page-hero__updated"><strong>{updatedLabel}:</strong>{' '}{updatedDate}</p>
        )}
      </div>
    </header>
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg);
    margin-top: calc(-1 * var(--navbar-height));
  }

  .page-hero__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .page-hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .page-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(
      90deg,
      var(--video-overlay) 0%,
      var(--video-overlay-transparent) 100%
    );
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    block-size: calc(clamp(23rem, 30vw, 26rem) + var(--navbar-height));
    padding-block: var(--sp-6);
    padding-top: calc(var(--navbar-height) + var(--sp-6));
  }

  .page-hero__header {
    width: 100%;
  }

  .page-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    max-width: 56rem;
    text-align: left;
  }

  .page-hero__copy .section-label {
    margin-bottom: var(--sp-3);
  }

  .page-hero__copy h1 {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin: 0 0 var(--sp-4);
    text-align: left;
  }

  .page-hero__copy h1 > span {
    text-wrap: balance;
  }

  .page-hero__icon {
    flex: 0 0 auto;
    width: auto;
    height: 1em;
    aspect-ratio: auto;
    object-fit: contain;
    pointer-events: none;
  }

  .page-hero__subtitle {
    max-width: 56ch;
    margin: 0 0 var(--sp-5);
    text-wrap: balance;
  }

  .page-hero__updated {
    display: inline-flex;
    gap: .25em;
    width: fit-content;
    margin: 0;
    padding: var(--sp-1) var(--sp-3);
    border: 1px solid color-mix(in srgb, var(--text-primary) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg) 60%, transparent);
    color: var(--text-secondary);
    font-size: var(--text-sm);
  }

  @media (max-width: 720px) {
    .page-hero__inner {
      padding-block: var(--sp-5);
      padding-top: calc(var(--navbar-height) + var(--sp-5));
    }

    .page-hero__header {
      position: relative;
    }

    .page-hero__copy {
      position: relative;
      z-index: 1;
      align-items: flex-start;
      width: 100%;
      max-width: none;
      text-align: left;
    }

    .page-hero__copy h1,
    .page-hero__subtitle {
      max-width: 100%;
      text-align: left;
    }

    .page-hero__updated {
      align-self: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .page-hero__video {
      display: none;
    }
  }
</style>
