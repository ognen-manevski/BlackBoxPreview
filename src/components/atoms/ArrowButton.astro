---
import ArrowForwardIcon from '../icons/ArrowForwardIcon.astro';

interface Props {
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  variant?: 'primary' | 'outline' | 'ghost' | 'white';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}

const {
  href,
  type = 'button',
  variant = 'primary',
  size = 'md',
  class: className = '',
} = Astro.props as Props;

const classes = ['btn', `btn--${variant}`, size !== 'md' ? `btn--${size}` : '', 'btn--with-arrow', className].filter(Boolean).join(' ');
---

{
  href ? (
    <a href={href} class={classes}>
      <span><slot /></span>
      <slot name="icon">
        <ArrowForwardIcon class="btn__arrow" />
      </slot>
    </a>
  ) : (
    <button class={classes} type={type}>
      <span><slot /></span>
      <slot name="icon">
        <ArrowForwardIcon class="btn__arrow" />
      </slot>
    </button>
  )
}

