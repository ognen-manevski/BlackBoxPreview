---
import { Image } from 'astro:assets';
import ShelfLabelsDsCard from '../../atoms/ShelfLabelsDsCard.astro';
import DecorativeChipCloud from '../../atoms/DecorativeChipCloud.astro';
import ProgressiveImage from '../../atoms/ProgressiveImage.astro';
import SectionTitleGroup from '../../molecules/SectionTitleGroup.astro';
import iconScreenSizes from '../../../assets/vectors/icons/shelf-labels/ico_screen-sizes.svg?raw';
import interactiveTechnicalImage from '../../../assets/images/services/neoslide/interactive-displays/technical-details/technical-details.png';
import technicalLeftProduct from '../../../assets/images/services/neoslide/totems/technical-details/td-left.png';
import technicalRightProduct from '../../../assets/images/services/neoslide/totems/technical-details/td-right.png';
import type { TotemsContent } from '../../../i18n/pages/digital-signage-displays/totems';
import { getImageOutputWidth, getResponsiveImageWidths } from '../../../utils/images';

interface Props {
  content: TotemsContent['technicalDetails'];
  iconSet?: 'totems' | 'interactive-displays';
  decorativeChips?: readonly string[];
}

const { content, iconSet = 'totems', decorativeChips = [] } = Astro.props;
const totemsSpecificationIconModules = import.meta.glob<string>(
  '../../../assets/vectors/icons/totems/totem-specification-icons/*.svg',
  { query: '?raw', import: 'default' },
);
const interactiveDisplaysHardwareIconModules = import.meta.glob<string>(
  '../../../assets/vectors/icons/interactive-displays/interactive-hardware/*.svg',
  { query: '?raw', import: 'default' },
);
const specificationIconNames = iconSet === 'totems'
  ? [
      'screen-brightness',
      'connectivity-ports',
      'power-operating-costs',
      'operating-system-compatibility',
      'touch-technology',
    ]
  : [
      'touch-technology',
      'computing-software',
      'connectivity-peripherals',
      'visibility-durability',
      'mounting-accessibility',
    ];
const specificationIconModules = iconSet === 'totems'
  ? totemsSpecificationIconModules
  : interactiveDisplaysHardwareIconModules;
const specificationIconDirectory = iconSet === 'totems'
  ? 'totems/totem-specification-icons'
  : 'interactive-displays/interactive-hardware';
const loadSpecificationIcon = async (name: string) => {
  const iconPath = `../../../assets/vectors/icons/${specificationIconDirectory}/${name}.svg`;
  const loadIcon = specificationIconModules[iconPath];

  if (!loadIcon) {
    throw new Error(`Missing ${iconSet} technical specification icon: ${name}`);
  }

  return (await loadIcon()).replace(/^<\?xml[^>]*>\s*/, '');
};
const replacementIcons = await Promise.all(specificationIconNames.map(loadSpecificationIcon));
const featureIcons = [
  iconScreenSizes.replace(/^<\?xml[^>]*>\s*/, ''),
  ...replacementIcons,
];

if (featureIcons.length !== content.features.length) {
  throw new Error('Digital totems technical feature icons must match the feature count.');
}

const features = content.features.map((feature, index) => {
  const icon = featureIcons[index];

  if (!icon) {
    throw new Error(`Missing digital totems technical feature icon at index ${index}.`);
  }

  return { ...feature, icon };
});
---

<section
  class:list={['section totems-technical', iconSet === 'totems' && 'totems-technical--totems']}
  aria-labelledby="totems-technical-heading"
>
  <div class="container totems-technical__frame u-section-title-stack">
    <SectionTitleGroup
      class="totems-technical__intro"
      label={content.label}
      heading={content.heading}
      headingId="totems-technical-heading"
      headlineWidth="22ch"
      titleWidth="58%"
      copy={content.copy}
    />

    <div class="totems-technical__body">
      <div class="totems-technical__cards" aria-label={content.listAriaLabel}>
        {features.map((feature) => (
          <div class="totems-technical__card">
            <ShelfLabelsDsCard title={feature.title} text={feature.text}>
              <span slot="icon" set:html={feature.icon} />
            </ShelfLabelsDsCard>
          </div>
        ))}
      </div>

      {iconSet === 'totems' ? (
        <div class="totems-technical__image totems-technical__image--totems">
          <div
            class="totems-technical__visual"
            data-progressive-host="relative"
            data-animate
            role="img"
            aria-label={content.imageAlt}
          >
            <ProgressiveImage src={technicalLeftProduct} fit="contain">
              <Image
                src={technicalLeftProduct}
                alt=""
                widths={getResponsiveImageWidths(technicalLeftProduct)}
                width={getImageOutputWidth(technicalLeftProduct)}
                sizes="auto, (min-width: 64rem) 40vw, 100vw"
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </ProgressiveImage>
            <ProgressiveImage src={technicalRightProduct} fit="contain">
              <Image
                src={technicalRightProduct}
                alt=""
                widths={getResponsiveImageWidths(technicalRightProduct)}
                width={getImageOutputWidth(technicalRightProduct)}
                sizes="auto, (min-width: 64rem) 40vw, 100vw"
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </ProgressiveImage>
          </div>
        </div>
      ) : (
        <div class="totems-technical__image totems-technical__image--interactive">
          <div
            class="totems-technical__visual totems-technical__visual--interactive"
            data-progressive-host="relative"
            data-animate
            role="img"
            aria-label={content.imageAlt}
          >
            <ProgressiveImage src={interactiveTechnicalImage} fit="contain">
              <Image
                src={interactiveTechnicalImage}
                alt=""
                widths={getResponsiveImageWidths(interactiveTechnicalImage)}
                width={getImageOutputWidth(interactiveTechnicalImage)}
                sizes="auto, (min-width: 64rem) 40vw, 100vw"
                format="webp"
                loading="lazy"
                decoding="async"
              />
            </ProgressiveImage>
            <DecorativeChipCloud chips={decorativeChips} placement="technical" />
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .totems-technical {
    background: var(--bg);
    border-bottom: 1px solid var(--border-color);
  }

  .totems-technical__frame {
    margin-block: var(--sp-10);
  }

  .totems-technical__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-6);
    align-items: stretch;
  }

  .totems-technical__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--sp-4);
    width: 100%;
  }

  .totems-technical__card {
    display: grid;
    width: 100%;
  }

  .totems-technical__cards :global(.sl-ds-card__icon > span) {
    display: contents;
  }

  .totems-technical__cards :global(.sl-ds-card__icon svg) {
    width: 88%;
    height: 88%;
  }

  .totems-technical__image {
    display: grid;
    min-width: 0;
    align-items: center;
  }

  .totems-technical__image--totems {
    justify-items: center;
  }

  .totems-technical__visual {
    position: relative;
    width: min(100%, 24rem);
    aspect-ratio: 768 / 1042;
  }

  .totems-technical__image--totems .totems-technical__visual img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .totems-technical__image img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .totems-technical__image--interactive {
    justify-items: center;
  }

  .totems-technical__visual--interactive {
    position: relative;
    width: min(100%, 18rem);
    aspect-ratio: 768 / 1433;
  }

  .totems-technical__visual--interactive img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (max-width: 720px) {
    .totems-technical__visual--interactive {
      width: min(18rem, 58vw);
    }
  }

  @media (max-width: 1024px) {
    .totems-technical__cards {
      grid-template-columns: 1fr;
      gap: var(--sp-3);
    }
  }

  @media (max-width: 884px) {
    .totems-technical__body {
      grid-template-columns: 1fr;
      gap: var(--sp-5);
    }

    .totems-technical__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .totems-technical__cards {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }
  }

  .totems-technical--totems .totems-technical__body {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
  }

  .totems-technical--totems .totems-technical__cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
  }

  @media (max-width: 1100px) {
    .totems-technical--totems .totems-technical__body {
      grid-template-columns: minmax(0, 1.3fr) minmax(14rem, 0.7fr);
    }

    .totems-technical--totems .totems-technical__cards {
      gap: var(--sp-3);
    }

    .totems-technical--totems .totems-technical__visual {
      width: 100%;
    }
  }

  @media (max-width: 720px) {
    .totems-technical--totems .totems-technical__body {
      grid-template-columns: 1fr;
      gap: var(--sp-7);
    }

    .totems-technical--totems .totems-technical__image--totems {
      width: 100%;
      justify-items: center;
    }

    .totems-technical--totems .totems-technical__visual {
      width: min(24rem, 72vw);
    }
  }

  @media (max-width: 560px) {
    .totems-technical--totems .totems-technical__cards {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    .totems-technical--totems .totems-technical__visual {
      width: min(22rem, 72vw);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .totems-technical .totems-technical__visual[data-animate] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
