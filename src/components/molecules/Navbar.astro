---
import ArrowButton from "../atoms/ArrowButton.astro";
import LangToggle from "../atoms/LangToggle.astro";
import { commonTranslations } from "../../i18n/common";
import { getLocalizedPath, getTranslations } from "../../i18n/utils";
import type { Lang } from "../../i18n/types";
import logoRaw from "../../assets/vectors/brand/logo-horizontal.svg?raw";
import neoslideLogoRaw from "../../assets/vectors/icons/nav-menu-icons/neoslide-logo-gradient.svg?raw";

const serviceIconModules = import.meta.glob<string>(
  "../../assets/vectors/icons/nav-menu-icons/{development,digital-signage,shelf-labels,video-streaming}.svg",
  { query: "?raw", import: "default" },
);
const loadServiceIcon = async (name: string) => {
  const iconPath = `../../assets/vectors/icons/nav-menu-icons/${name}.svg`;
  const loadIcon = serviceIconModules[iconPath];
  if (!loadIcon) {
    throw new Error(`Missing navigation icon: ${name}`);
  }
  return (await loadIcon())
    .replace(/^<\?xml[^>]*>\s*/, "")
    .replace("<svg ", '<svg class="nav-dropdown__icon" aria-hidden="true" ');
};

interface Props {
  currentLang?: Lang;
}
const { currentLang = "en" } = Astro.props;
const t = getTranslations(commonTranslations, currentLang).navigation;
const common = getTranslations(commonTranslations, currentLang);
const href = (path: string) => getLocalizedPath(path, currentLang);
const [
  developmentIcon,
  digitalSignageIcon,
  shelfLabelsIcon,
  videoStreamingIcon,
] = await Promise.all([
  loadServiceIcon("development"),
  loadServiceIcon("digital-signage"),
  loadServiceIcon("shelf-labels"),
  loadServiceIcon("video-streaming"),
]);
const digitalSignageLabel = t.serviceLinks.digitalSignage.replace(
  /^NeoSlide\s*[–-]\s*/,
  "",
);
const logoMarkup = logoRaw.replace(
  "<svg ",
  '<svg class="navbar__logo" aria-hidden="true" ',
);
const neoslideLogoMarkup = neoslideLogoRaw
  .replace(/^<\?xml[^>]*>\s*/, "")
  .replace(
    "<svg ",
    '<svg class="nav-dropdown__neoslide-logo" aria-hidden="true" ',
  );
const normalizedPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (path: string) => {
  const target =
    getLocalizedPath(path, currentLang).split("#")[0].replace(/\/$/, "") || "/";
  return (
    normalizedPath === target ||
    (target !== "/" && normalizedPath.startsWith(`${target}/`))
  );
};
---

<nav class="navbar" role="navigation" aria-label={t.ariaLabel} id="navbar">
  <div class="container">
    <a href={href("/")} class="navbar__brand" aria-label={t.homeAriaLabel}>
      <Fragment set:html={logoMarkup} />
    </a>

    <div class="navbar__menu-panel container">
      <ul
        class="navbar__nav"
        role="list"
        id="navMenu"
        aria-label={t.primaryAriaLabel}
      >
        <li class="nav-item--dropdown nav-item--services">
          <div class="navbar__mobile-services-card">
            <span class="nav-mobile-section-title">{t.services}</span>
            <button
              class:list={[
                "nav-dropdown__trigger",
                "nav-interactive",
                (isActive("/services/neoslide/") ||
                  isActive("/services/video-streaming/") ||
                  isActive("/services/software-development/")) &&
                  "is-active",
              ]}
              id="servicesBtn"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="servicesDropdown"
              data-dropdown-toggle
              type="button"
            >
              {t.services}
              <svg
                class="chevron"
                width="8"
                height="5"
                viewBox="0 0 8 5"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="M7.06 0L4 3.05333L0.94 0L0 0.94L4 4.94L8 0.94L7.06 0Z"
                  fill="currentColor"></path>
              </svg>
              <span class="navbar__active-indicator" aria-hidden="true"></span>
            </button>
            <div class="nav-dropdown__panel" id="servicesDropdown">
              <a
                href={href("/services/neoslide/")}
                class:list={[
                  "nav-dropdown__item",
                  "nav-dropdown__item--featured",
                  "nav-interactive",
                  isActive("/services/neoslide/") && "is-active",
                ]}
                aria-label={t.serviceLinks.digitalSignage}
                aria-current={isActive("/services/neoslide/") ? "page" : undefined}
              >
                <span class="nav-dropdown__featured-content">
                  <span
                    class="nav-dropdown__icon-wrap"
                    set:html={digitalSignageIcon}
                  ></span>
                  <span>{digitalSignageLabel}</span>
                </span>
                <span set:html={neoslideLogoMarkup}></span>
                <span class="nav-dropdown__active-indicator" aria-hidden="true"></span>
              </a>
              <a
                href={href("/services/video-streaming/")}
                class:list={[
                  "nav-dropdown__item",
                  "nav-interactive",
                  isActive("/services/video-streaming/") && "is-active",
                ]}
                aria-current={isActive("/services/video-streaming/") ? "page" : undefined}
              >
                <span
                  class="nav-dropdown__icon-wrap"
                  set:html={videoStreamingIcon}
                ></span>
                <span>{t.serviceLinks.videoStreaming}</span>
                <span class="nav-dropdown__active-indicator" aria-hidden="true"></span>
              </a>
              <a
                href={href("/services/software-development/")}
                class:list={[
                  "nav-dropdown__item",
                  "nav-interactive",
                  isActive("/services/software-development/") && "is-active",
                ]}
                aria-current={isActive("/services/software-development/") ? "page" : undefined}
              >
                <span
                  class="nav-dropdown__icon-wrap"
                  set:html={developmentIcon}
                ></span>
                <span>{t.serviceLinks.softwareDevelopment}</span>
                <span class="nav-dropdown__active-indicator" aria-hidden="true"></span>
              </a>
            </div>
          </div>
        </li>
        <li class="nav-item--dropdown nav-item--displays">
          <div class="navbar__mobile-display-card">
            <span class="nav-mobile-section-title">{t.digitalSignageDisplays}</span>
            <button
              class:list={[
                "nav-dropdown__trigger",
                "nav-interactive",
                (isActive("/digital-signage-displays/totems/") ||
                  isActive("/digital-signage-displays/interactive-displays/") ||
                  isActive("/digital-signage-displays/electronic-shelf-labels/")) &&
                  "is-active",
              ]}
              id="displaysBtn"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="displaysDropdown"
              data-dropdown-toggle
              type="button"
            >
              {t.digitalSignageDisplays}
              <svg
                class="chevron"
                width="8"
                height="5"
                viewBox="0 0 8 5"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <path
                  d="M7.06 0L4 3.05333L0.94 0L0 0.94L4 4.94L8 0.94L7.06 0Z"
                  fill="currentColor"></path>
              </svg>
              <span class="navbar__active-indicator" aria-hidden="true"></span>
            </button>
            <div class="nav-dropdown__panel" id="displaysDropdown">
              <a
                href={href("/digital-signage-displays/totems/")}
                class:list={[
                  "nav-dropdown__item",
                  "nav-interactive",
                  isActive("/digital-signage-displays/totems/") && "is-active",
                ]}
                aria-current={isActive("/digital-signage-displays/totems/") ? "page" : undefined}
              >
                <span class="nav-dropdown__icon-wrap" set:html={digitalSignageIcon}></span>
                <span>{common.navigation.displayLinks.totems}</span>
                <span class="nav-dropdown__active-indicator" aria-hidden="true"></span>
              </a>
              <a
                href={href("/digital-signage-displays/interactive-displays/")}
                class:list={[
                  "nav-dropdown__item",
                  "nav-interactive",
                  isActive("/digital-signage-displays/interactive-displays/") && "is-active",
                ]}
                aria-current={isActive("/digital-signage-displays/interactive-displays/") ? "page" : undefined}
              >
                <span class="nav-dropdown__icon-wrap" set:html={digitalSignageIcon}></span>
                <span>{common.navigation.displayLinks.interactiveDisplays}</span>
                <span class="nav-dropdown__active-indicator" aria-hidden="true"></span>
              </a>
              <a
                href={href("/digital-signage-displays/electronic-shelf-labels/")}
                class:list={[
                  "nav-dropdown__item",
                  "nav-interactive",
                  isActive("/digital-signage-displays/electronic-shelf-labels/") && "is-active",
                ]}
                aria-current={isActive("/digital-signage-displays/electronic-shelf-labels/") ? "page" : undefined}
              >
                <span class="nav-dropdown__icon-wrap" set:html={shelfLabelsIcon}></span>
                <span>{common.navigation.displayLinks.shelfLabels}</span>
                <span class="nav-dropdown__active-indicator" aria-hidden="true"></span>
              </a>
            </div>
          </div>
        </li>
        <li class="navbar__mobile-other-links">
          <div class="navbar__mobile-company-card">
            <span class="nav-mobile-section-title">{common.footer.company}</span
            >
            <div class="navbar__mobile-other-links-list">
              <a
                href={href("/use-cases/")}
                class:list={[
                  "nav-interactive",
                  isActive("/use-cases/") && "is-active",
                ]}
                aria-current={isActive("/use-cases/") ? "page" : undefined}
                >{t.caseStudies}<span
                  class="navbar__active-indicator"
                  aria-hidden="true"></span></a
              >
              <a
                href={href("/about/")}
                class:list={[
                  "nav-interactive",
                  isActive("/about/") && "is-active",
                ]}
                aria-current={isActive("/about/") ? "page" : undefined}
                >{t.about}<span
                  class="navbar__active-indicator"
                  aria-hidden="true"
                ></span></a
              >
              <a
                href={href("/contact/")}
                class:list={[
                  "nav-interactive",
                  isActive("/contact/") && "is-active",
                ]}
                aria-current={isActive("/contact/") ? "page" : undefined}
                >{t.contact}<span
                  class="navbar__active-indicator"
                  aria-hidden="true"
                ></span></a
              >
            </div>
          </div>
        </li>
        <li class="navbar__mobile-controls" aria-label={t.controlsAriaLabel}>
          <div class="navbar__mobile-settings">
            <span class="navbar__mobile-settings-label">{t.changeLanguage}</span>
            <LangToggle currentLang={currentLang} />
          </div>
          <div class="navbar__mobile-demo-wrap">
            <ArrowButton
              href={href("/book-a-free-demo/")}
              variant="primary"
              size="sm"
              class="navbar__mobile-demo-button">{t.bookDemo}</ArrowButton
            >
          </div>
        </li>
      </ul>
    </div>

    <div class="navbar__controls">
      <div class="navbar__desktop-controls" aria-hidden="false">
        <LangToggle currentLang={currentLang} />
        <ArrowButton
          href={href("/book-a-free-demo/")}
          variant="primary"
          size="sm"
          class="navbar__demo-button">{t.bookDemo}</ArrowButton
        >
      </div>

      <button
        class="menu-toggle"
        id="menuToggle"
        aria-label={t.openMenu}
        data-open-label={t.openMenu}
        data-close-label={t.closeMenu}
        aria-expanded="false"
        aria-controls="navMenu"
        type="button"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<style is:global>
  /* ---- Navbar shell ---- */
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    padding: var(--sp-4) 0;
    background: var(--nav-bg);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border-color);
    z-index: 100;
    transition:
      background var(--t-base),
      border-color var(--t-base),
      box-shadow var(--t-base);
  }

  .navbar.scrolled {
    box-shadow: var(--shadow-sm);
  }

  .navbar .container {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    position: relative;
  }

  /* ---- Brand ---- */
  .navbar__brand {
    display: flex;
    align-items: center;
    width: auto;
    height: 2rem;
    flex-shrink: 0;
    color: var(--text-primary);
  }

  .navbar__brand:hover {
    color: var(--color-brand);
    transition: none;
  }

  .navbar__logo {
    display: block;
    width: auto;
    height: 2rem;
    aspect-ratio: 363 / 87;
    color: currentColor;
    fill: currentColor;
    max-width: none;
    flex-shrink: 0;
  }

  /* ---- Nav links ---- */
  .navbar__nav {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
    flex: 1;
  }

  .navbar .navbar__menu-panel {
    display: contents;
    position: static;
  }

  .navbar__mobile-services-card,
  .navbar__mobile-display-card,
  .navbar__mobile-company-card,
  .navbar__mobile-other-links {
    display: contents;
  }

  .navbar .navbar__nav > .navbar__mobile-other-links {
    display: contents;
  }

  .navbar__mobile-other-links-list {
    display: contents;
  }

  .navbar__mobile-company-card {
    display: contents;
  }

  .navbar__nav > li {
    display: flex;
    align-items: center;
  }

  .navbar__nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    line-height: 1;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius);
    white-space: nowrap;
    min-width: min-content;
  }

  .navbar__active-indicator {
    position: absolute;
    left: var(--sp-3);
    right: var(--sp-3);
    bottom: 0;
    height: 2px;
    background: var(--color-brand);
    opacity: 0;
    pointer-events: none;
  }

  .navbar__nav .nav-dropdown__trigger {
    position: relative;
    white-space: nowrap;
  }

  .navbar__nav
    :is(a.is-active, .nav-dropdown__trigger.is-active)
    .navbar__active-indicator {
    view-transition-name: active-nav-indicator;
    opacity: 1;
  }

  .navbar__nav .nav-interactive {
    transition:
      color var(--t-fast),
      background-color var(--t-fast);
  }

  .navbar__nav .nav-interactive:is(
      :hover,
      :focus-visible,
      [aria-current="page"],
      [aria-expanded="true"],
      .is-active
    ) {
    color: var(--text-primary);
    background-color:
      color-mix(in srgb, var(--text-primary), transparent 96%);
  }



  .navbar__nav .navbar__mobile-demo-button:hover {
    color: #fff;
    background: var(--color-brand-dark);
    border-color: var(--color-brand-dark);
  }

  /* ---- Services dropdown ---- */
  .nav-item--dropdown {
    position: relative;
  }

  .nav-dropdown__trigger {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius);
    background: transparent;
    border: none;
    gap: var(--sp-2);
    cursor: pointer;
  }

  .nav-dropdown__trigger .chevron {
    transition: transform var(--t-base);
    flex-shrink: 0;
  }

  .nav-dropdown__trigger[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  .nav-dropdown__panel {
    position: absolute;
    top: calc(100% + var(--sp-2));
    left: 0;
    min-width: 20rem;
    background: var(--surface);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--sp-2);
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    z-index: 50;
    visibility: hidden;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--t-base),
      transform var(--t-base),
      visibility 0s var(--t-base);
    pointer-events: none;
  }

  .nav-dropdown__panel.is-open {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity var(--t-base),
      transform var(--t-base),
      visibility 0s;
    pointer-events: auto;
  }

  .nav-dropdown__item {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    padding: var(--sp-3) var(--sp-4) !important;
    border-radius: var(--radius);
    white-space: nowrap;
  }

  .nav-dropdown__item--unlinked {
    color: var(--text-secondary);
    cursor: default;
  }

  .nav-dropdown__active-indicator {
    position: absolute;
    top: var(--sp-3);
    bottom: var(--sp-3);
    left: 0;
    width: 2px;
    background: var(--color-brand);
    opacity: 0;
    pointer-events: none;
  }

  .nav-dropdown__item.is-active .nav-dropdown__active-indicator {
    opacity: 1;
  }

  .nav-dropdown__icon {
    display: block;
    width: 100%;
    height: 100%;
    flex: 0 0 auto;
  }

  .nav-dropdown__icon-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 1.5rem;
    flex: 0 0 2.125rem;
  }

  .navbar__nav .nav-dropdown__item--featured {
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .nav-dropdown__featured-content {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    white-space: nowrap;
  }

  .nav-dropdown__neoslide-logo {
    height: 0.8rem;
    width: auto;
    /* height: auto; */
    flex: 0 0 auto;
    /* color: var(--text-primary); */
  }

  .nav-dropdown__item--featured {
    /* background-color: var(--color-brand-dark); */
    background-image:
      radial-gradient(
        circle at top right,
        var(--color-brand) -100%,
        transparent 100%
      ),
      radial-gradient(
        circle at bottom right,
        var(--color-aurora) -100%,
        transparent 50%
      );
      transition:
        background-image var(--t-base);
    /* color: #fff !important; */
    /* font-weight: 600; */
  }

  .navbar__nav .nav-dropdown__item--featured:hover {
    color: #fff !important;
    background-color: transparent !important;
    background-image:
    radial-gradient(
      circle at top right,
      var(--color-brand) -50%,
      transparent 100%
    ),
    radial-gradient(
      circle at bottom right,
      var(--color-aurora) -50%,
      transparent 100%
    );
  }

  .nav-mobile-section-title {
    display: none;
  }

  /* ---- Controls area ---- */
  .navbar__controls {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    flex-shrink: 0;
    margin-left: auto;
  }

  .navbar__desktop-controls {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .navbar__demo-button {
    min-width: min-content;
    white-space: nowrap;
    min-height: auto;
    gap: var(--sp-1);
    letter-spacing: 0.04em;
  }

  .navbar__nav > .navbar__mobile-controls {
    display: none;
  }

  .navbar__nav > .navbar__mobile-cta {
    display: none;
  }

  /* ---- Hamburger ---- */
  .menu-toggle {
    position: relative;
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 2rem;
    height: 2rem;
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    padding: 0;
    color: var(--text-secondary);
    cursor: pointer;
    transition:
      background var(--t-fast),
      color var(--t-fast),
      border-color var(--t-base);
  }

  .menu-toggle:hover {
    background: var(--bg-secondary);
    color: var(--text-primary);
  }

  .menu-toggle span {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.875rem;
    height: 2px;
    margin: -1px 0 0 -0.4375rem;
    background: currentColor;
    transition:
      transform var(--t-base),
      opacity var(--t-base);
  }

  .menu-toggle span:nth-child(1) {
    transform: translateY(calc(2px - 0.5rem));
  }
  .menu-toggle span:nth-child(3) {
    transform: translateY(calc(0.5rem - 2px));
  }
  .navbar.menu-open .menu-toggle span:nth-child(1) {
    transform: rotate(45deg);
  }
  .navbar.menu-open .menu-toggle span:nth-child(2) {
    opacity: 0;
  }
  .navbar.menu-open .menu-toggle span:nth-child(3) {
    transform: rotate(-45deg);
  }

  /* ---- Mobile ---- */
  @media (max-width: 980px) {
    /* The panel sits in the navbar's flow (wrapping below the bar) so the navbar's own
       backdrop blur covers the open menu; nested backdrop-filters don't blur the page. */
    .navbar .container {
      flex-wrap: wrap;
      row-gap: 0;
    }

    .navbar .navbar__menu-panel {
      display: none;
      position: relative;
      order: 1;
      flex: 0 0 100%;
      max-width: none;
      padding: 0;
      margin-top: var(--sp-4);
    }

    /* Full-bleed divider that continues the closed navbar's bottom border look */
    .navbar .navbar__menu-panel::before {
      content: '';
      position: absolute;
      top: 0;
      left: calc(-1 * var(--sp-6));
      right: calc(-1 * var(--sp-6));
      border-top: 1px solid var(--border-color);
    }

    .navbar.menu-open .navbar__menu-panel {
      display: block;
    }

    /* Only the content animates; the panel's top divider stays static. The panel's
       discrete display transition keeps it rendered while the content fades out. */
    .navbar .navbar__menu-panel {
      transition: display 90ms allow-discrete;
    }

    .navbar .navbar__nav {
      opacity: 0;
      transform: translateY(-0.5rem);
      transition:
        opacity 90ms ease-out,
        transform 90ms ease-out;
    }

    .navbar.menu-open .navbar__nav {
      opacity: 1;
      transform: none;

      @starting-style {
        opacity: 0;
        transform: translateY(-0.5rem);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .navbar .navbar__menu-panel,
      .navbar .navbar__nav {
        transition: none;
      }
    }

    .navbar__nav {
      display: none;
      display: grid;
      grid-template-columns: minmax(14rem, 1fr) minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      padding: var(--sp-4) 0 0;
      column-gap: var(--sp-4);
      row-gap: var(--sp-4);
      align-items: stretch;
    }

    .navbar__nav.is-open {
      display: grid;
    }

    .navbar__nav > li {
      width: 100%;
      align-items: stretch;
    }

    /* Both cards share row 1, so they stretch to the same height and their titles align. */
    .navbar__nav > .nav-item--services {
      grid-row: 1;
      grid-column: 1;
      min-width: 0;
      display: grid;
      grid-template-rows: minmax(0, 1fr);
    }

    .navbar__nav > .nav-item--displays {
      grid-row: 1;
      grid-column: 2;
      min-width: 0;
      display: grid;
      grid-template-rows: minmax(0, 1fr);
    }

    .navbar__nav > .navbar__mobile-other-links {
      grid-column: 1 / -1;
      grid-row: 2;
      min-width: 0;
      display: grid;
      grid-template-rows: minmax(0, 1fr);
    }

    .navbar__nav > .navbar__mobile-controls {
      grid-column: 1 / -1;
      grid-row: 3;
      width: 100%;
    }

    .navbar__mobile-services-card,
    .navbar__mobile-display-card,
    .navbar__mobile-company-card {
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      min-width: 0;
      height: auto;
      padding: var(--sp-2);
      border: 1px solid var(--border-color);
      border-radius: var(--radius);
      background: var(--bg-secondary);
    }

    .navbar__mobile-other-links-list {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-width: 0;
    }

    .navbar__nav a {
      display: flex;
      justify-content: flex-start;
      text-align: left;
      padding: var(--sp-3);
      width: 100%;
    }

    .navbar__nav .navbar__active-indicator {
      display: none;
    }

    .navbar__mobile-other-links-list
      .nav-interactive.is-active
      .navbar__active-indicator {
      display: block;
      top: var(--sp-3);
      right: auto;
      bottom: var(--sp-3);
      left: 0;
      width: 2px;
      height: auto;
      view-transition-name: none;
    }

    .navbar__desktop-controls {
      display: flex;
      align-items: center;
      gap: var(--sp-2);
    }

    .navbar__mobile-controls,
    .navbar__nav > .navbar__mobile-controls {
      display: none;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-2);
      padding: 0;
      margin-top: 0;
      width: 100%;
    }

    .navbar__mobile-settings {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-2);
      min-width: 0;
    }

    .navbar__mobile-settings-label {
      color: var(--text-secondary);
      font-family: var(--font-ui);
      font-size: var(--text-sm);
    }

    .navbar__mobile-settings .lang-toggle a {
      display: inline-flex;
      align-items: center;
      width: auto;
      padding: 5px var(--sp-3);
      text-align: center;
    }

    .navbar__nav .navbar__mobile-demo-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2rem;
      padding: 5px var(--sp-3);
      color: #fff;
      gap: var(--sp-1);
      flex: 0 0 auto;
      letter-spacing: 0.04em;
    }

    .menu-toggle {
      display: flex;
    }

    /* Dropdown — inline on mobile */
    .nav-item--dropdown {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      position: static;
      width: 100%;
    }

    .nav-dropdown__trigger {
      display: none;
      width: 100%;
      align-items: center;
      text-align: left;
      gap: var(--sp-3);
      justify-content: space-between;
      padding: var(--sp-3);
    }

    .nav-mobile-section-title {
      display: block;
      padding: 0 0 var(--sp-2);
      color: var(--color-brand);
      font-family: var(--font-ui);
      font-size: var(--text-xs);
      font-weight: var(--weight-bold);
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .nav-dropdown__panel {
      position: static;
      left: auto;
      right: auto;
      visibility: visible;
      opacity: 1;
      transform: none;
      pointer-events: auto;
      transition: none;
      border: none;
      background: transparent;
      padding: var(--sp-2) var(--sp-4);
      width: 100%;
      max-width: 100%;
      min-width: 0;
      border-radius: 0;
      display: none;
      background-color: var(--bg-secondary);
      border-radius: 0 0 var(--radius) var(--radius);
      border: 0;
      padding: 0;
    }

    .nav-item--dropdown .nav-dropdown__panel {
      display: flex;
    }

    .navbar__nav > .navbar__mobile-controls {
      display: none;
    }

    .nav-dropdown__panel.is-open {
      display: flex;
    }
  }

  @media (max-width: 450px) {
    .navbar__desktop-controls {
      display: none;
    }

    .navbar__nav .navbar__mobile-demo-button {
      min-width: min-content;
    }
  }

  @media (max-width: 580px) {
    .navbar__desktop-controls {
      display: none;
    }

    .navbar__mobile-controls,
    .navbar__nav > .navbar__mobile-controls {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-4);
    }

    .navbar__mobile-settings {
      justify-content: space-between;
    }

    .navbar__mobile-demo-wrap {
      width: 100%;
    }

    .navbar__nav .navbar__mobile-demo-button {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 360px) {
    .navbar__mobile-controls {
      gap: var(--sp-4);
    }
  }

  @media (max-width: 640px) {
    .navbar__nav {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-rows: auto;
      column-gap: 0;
      row-gap: var(--sp-4);
    }

    /* the grid's row-gap already provides this spacing */
    .navbar__nav > .navbar__mobile-controls {
      margin-top: 0;
      grid-row: auto;
    }

    .navbar__nav > .nav-item--services,
    .navbar__nav > .nav-item--displays,
    .navbar__nav > .navbar__mobile-other-links {
      width: 100%;
      grid-column: 1;
      grid-row: auto;
    }

    .navbar__mobile-services-card,
    .navbar__mobile-display-card,
    .navbar__mobile-company-card,
    .navbar .navbar__nav > .navbar__mobile-other-links {
      grid-row: auto;
    }
  }
</style>

<script>
  const navbar = document.getElementById("navbar");
  const menuBtn = document.getElementById("menuToggle");
  const navMenu = document.getElementById("navMenu");
  const dropdownToggles = Array.from(
    navMenu?.querySelectorAll<HTMLButtonElement>("[data-dropdown-toggle]") ?? [],
  );
  const closeDropdowns = () => {
    dropdownToggles.forEach((toggle) => {
      const panel = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
      panel?.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
    });
  };

  // Mobile menu toggle
  menuBtn?.addEventListener("click", () => {
    const isOpen = navMenu?.classList.toggle("is-open");
    navbar?.classList.toggle("menu-open", isOpen);
    menuBtn.setAttribute("aria-expanded", String(isOpen));
    menuBtn.setAttribute(
      "aria-label",
      isOpen
        ? (menuBtn.dataset.closeLabel ?? "")
        : (menuBtn.dataset.openLabel ?? ""),
    );

    if (!isOpen) closeDropdowns();
  });

  // Close on nav link click
  navMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      navMenu.classList.remove("is-open");
      navbar?.classList.remove("menu-open");
      menuBtn?.setAttribute("aria-expanded", "false");
      menuBtn?.setAttribute("aria-label", menuBtn.dataset.openLabel ?? "");
    });
  });

  // Close on outside click
  document.addEventListener("click", (e) => {
    if (
      !navbar?.contains(e.target as Node) &&
      navMenu?.classList.contains("is-open")
    ) {
      navMenu.classList.remove("is-open");
      navbar?.classList.remove("menu-open");
      menuBtn?.setAttribute("aria-expanded", "false");
      menuBtn?.setAttribute("aria-label", menuBtn.dataset.openLabel ?? "");
    }
  });

  // Scroll shadow
  function onScroll() {
    navbar?.classList.toggle("scrolled", window.scrollY > 4);
  }
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  dropdownToggles.forEach((toggle) => {
    const panel = document.getElementById(toggle.getAttribute("aria-controls") ?? "");
    toggle.addEventListener("click", (event) => {
      event.stopPropagation();
      const willOpen = !panel?.classList.contains("is-open");
      closeDropdowns();
      if (willOpen) {
        panel?.classList.add("is-open");
        toggle.setAttribute("aria-expanded", "true");
      }
    });
  });

  document.addEventListener("click", (e) => {
    if (!navbar?.contains(e.target as Node)) closeDropdowns();
  });

  document.addEventListener("keydown", (e) => {
    const openToggle = dropdownToggles.find(
      (toggle) => toggle.getAttribute("aria-expanded") === "true",
    );
    if (e.key === "Escape" && openToggle) {
      closeDropdowns();
      openToggle.focus();
    }
  });
</script>
