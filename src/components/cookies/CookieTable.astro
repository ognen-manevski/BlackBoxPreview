---
import { cookieRegistry } from '../../config/cookies';
import { getTranslations } from '../../i18n/utils';
import { commonTranslations } from '../../i18n/common';
import type { Lang } from '../../i18n/types';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = getTranslations(commonTranslations, lang).cookies;
---

<div class="cookie-table" role="table" aria-label={t.table.caption}>
  <div class="cookie-table__row cookie-table__header" role="row">
    <span role="columnheader">{t.table.name}</span>
    <span role="columnheader">{t.table.provider}</span>
    <span role="columnheader">{t.table.purpose}</span>
    <span role="columnheader">{t.table.category}</span>
    <span role="columnheader">{t.table.duration}</span>
  </div>

  {cookieRegistry.map((entry) => {
    const info = t.registry[entry.id];
    const category = t.categories[entry.category];
    return (
      <div class="cookie-table__row" role="row" data-cookie-table-category={entry.category} data-active={entry.category === 'necessary' ? 'true' : 'false'}>
        <span role="cell" data-label={t.table.name}>{entry.id}</span>
        <span role="cell" data-label={t.table.provider}>{entry.provider}</span>
        <span role="cell" data-label={t.table.purpose}>{info?.purpose}</span>
        <span role="cell" data-label={t.table.category}>{category?.label}</span>
        <span role="cell" data-label={t.table.duration}>{info?.duration}</span>
      </div>
    );
  })}
</div>
