---
import Navbar from '../components/molecules/Navbar.astro';
import Footer from '../components/molecules/Footer.astro';
import { getLocaleFromUrl } from '../i18n/utils';
import type { Lang } from '../i18n/types';
import { commonTranslations } from '../i18n/common';
import { getTranslations } from '../i18n/utils';

import '../styles/reset.css';
import '../styles/tokens.css';
import '../styles/global.css';
import '../styles/utilities.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  lang?: Lang;
}

const {
  title,
  description,
  canonical,
  ogImage = '/brand/thumbnails/og-default.jpg',
  lang = getLocaleFromUrl(Astro.url),
} = Astro.props;
const resolvedDescription = description ?? getTranslations(commonTranslations, lang).seo.defaultDescription;

const canonicalURL = canonical ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href);
---
<!doctype html>
<html lang={lang} data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- Theme init — must run before first paint to prevent flash -->
  <script is:inline>
    (function () {
      var t = localStorage.getItem('bb-theme') || 'dark';
      document.documentElement.setAttribute('data-theme', t);
    })();
  </script>

  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={resolvedDescription}>
  <link rel="canonical" href={canonicalURL}>
  <meta name="robots" content="index, follow">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={resolvedDescription}>
  <meta property="og:image" content={ogImage}>

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={resolvedDescription}>
  <meta name="twitter:image" content={ogImage}>

  <!-- Favicons -->
  <link rel="icon" href={`${import.meta.env.BASE_URL}brand/favicons/favicon-adaptive.svg`} type="image/svg+xml">
  <!-- <link rel="icon" href={`${import.meta.env.BASE_URL}brand/favicons/favicon.ico`} sizes="any"> -->
  <!-- <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}brand/favicons/apple-touch-icon.png`}> -->
  <link rel="manifest" href={`${import.meta.env.BASE_URL}brand/favicons/site.webmanifest`}>

  <!-- Theme color -->
  <meta name="theme-color" media="(prefers-color-scheme: dark)"  content="#111111">
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#FAFAFA">

  <!-- Sitemap -->
  <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`}>

  <!-- Fonts -->
  <!-- TODO: self-host fonts from /public/fonts/ for better performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Roboto:wght@300;400;500;700&family=Roboto+Mono:wght@400;500;700&display=swap"
  >
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,300..700,0,0"
  >
</head>
<body>

  <Navbar currentLang={lang} />

  <main id="main-content">
    <slot />
  </main>

  <Footer lang={lang} />

  <!-- Entrance animations -->
  <script>
    const animEls = document.querySelectorAll('[data-animate]');

    if ('IntersectionObserver' in window && animEls.length) {
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.10, rootMargin: '0px 0px -48px 0px' }
      );

      animEls.forEach((el, i) => {
        (el as HTMLElement).style.transitionDelay = `${(i % 4) * 80}ms`;
        observer.observe(el);
      });
    } else {
      animEls.forEach(el => el.classList.add('is-visible'));
    }
  </script>

</body>
</html>
