---
interface Props {
  id: string;
  name?: string;
  label: string;
  class?: string;
}

const { id, name = 'attachment', label, class: className = '' } = Astro.props;
---

<div class:list={['file-upload', className]}>
  <label class="file-upload__link" for={id}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21.44 11.05 12.25 20.24a5.25 5.25 0 1 1-7.42-7.43L14.73 2.92a3.5 3.5 0 0 1 4.95 4.95l-9.2 9.2a1.75 1.75 0 1 1-2.47-2.48l8.49-8.48" />
    </svg>
    <span>{label}</span>
  </label>
  <input id={id} class="file-upload__input" type="file" name={name}>
</div>

<style>
  .file-upload {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .file-upload__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    color: var(--text-secondary);
    cursor: pointer;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--t-fast), background var(--t-fast);
  }

  .file-upload__link:hover {
    color: var(--text-primary);
  }

  .file-upload__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 1px;
    height: 1px;
  }
</style>
