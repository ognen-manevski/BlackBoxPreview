---
import arrowOutward from '../../assets/vectors/icons/material/custom/arrow_outward_400w.svg?raw';

interface Props {
  class?: string;
  variant?: 'filled' | 'outline';
}
const { class: className = '', variant = 'filled' } = Astro.props;
---

{
  variant === 'outline' ? (
    <span class:list={['arrow-outward-icon', 'arrow-outward-icon--outline', className]} aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none">
        <path d="M5 19 19 5M9 5h10v10" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" stroke-linejoin="miter" />
      </svg>
    </span>
  ) : (
    <span class:list={['arrow-outward-icon', className]} aria-hidden="true" set:html={arrowOutward} />
  )
}

<style>
  .arrow-outward-icon {
    display: inline-flex;
    width: auto;
    height: auto;
    font-size: inherit;
    line-height: 1;
  }

  .arrow-outward-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }

  .arrow-outward-icon--outline :global(svg) {
    fill: none;
  }
</style>
