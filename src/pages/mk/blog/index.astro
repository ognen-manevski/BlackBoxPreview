---
import { getCollection } from 'astro:content';
import BlogPage from '../../../components/pages/BlogPage.astro';
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === 'mk')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---
<BlogPage lang="mk" posts={posts} />
