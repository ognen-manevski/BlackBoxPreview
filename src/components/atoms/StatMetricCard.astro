---
interface Props {
  value: string;
  label: string;
  compactValue?: boolean;
  valueSuffixSmall?: string;
}

const {
  value,
  label,
  compactValue = false,
  valueSuffixSmall,
} = Astro.props as Props;
---

<article class="stat-metric-card u-border-interactive">
  <div class="stat-metric-card__inner">
    <p class:list={["stat-metric-card__value", compactValue && "stat-metric-card__value--compact"]}>
      <span>{value}</span>
      {valueSuffixSmall && <small class="stat-metric-card__value-suffix"> {valueSuffixSmall}</small>}
    </p>
    <p class="stat-metric-card__label">{label}</p>
  </div>
</article>

<style>
  .stat-metric-card {
    height: 100%;
    min-height: 10.5rem;
    display: flex;
    border-radius: var(--radius);
    background: linear-gradient(
      90deg,
      var(--bg-secondary) 0%,
      color-mix(in srgb, var(--bg-secondary) 65%, var(--bg)) 100%
    );
  }

  .stat-metric-card__inner {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: var(--sp-1);
    padding: var(--sp-4);
    transform: scale(1);
    transition: transform 0.2s ease;
  }

  .stat-metric-card:is(:hover, :focus-within) .stat-metric-card__inner {
    transform: scale(1.03);
  }

  .stat-metric-card__value {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(1.9rem, 2vw + 0.9rem, 3.2rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--color-brand);
    font-weight: var(--weight-bold);
  }

  .stat-metric-card__value--compact {
    font-size: clamp(1.45rem, 1.1vw + 1rem, 2.25rem);
    margin-bottom: 0.3rem;
  }

  .stat-metric-card__value-suffix {
    font-size: 0.58em;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.01em;
    color: var(--text-secondary);
  }

  .stat-metric-card__label {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.35;
    color: var(--text-secondary);
    white-space: pre-line;
  }

  @media (max-width: 600px) {
    .stat-metric-card {
      min-height: 8.5rem;
    }
  }
</style>
