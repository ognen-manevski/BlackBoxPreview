---
import ClientLogoCell from '../atoms/ClientLogoCell.astro';
import type { ClientLogoItem } from '../../data/clientLogos';

interface Props {
  items: ClientLogoItem[];
  ariaLabel: string;
}

const { items, ariaLabel } = Astro.props as Props;
const loopingItems = [...items, ...items];
---

<div class="logo-carousel" aria-label={ariaLabel}>
  <div class="logo-carousel__viewport">
    <div class="logo-carousel__track" aria-hidden="true">
      {loopingItems.map((item, index) => (
        <div class="logo-carousel__item" style={`--logo-index: ${index};`}>
          <ClientLogoCell name={item.name} href={item.href} src={item.src} loading={index < items.length ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.logo-carousel').forEach((carousel) => {
    if (carousel.dataset.dragReady) return;

    const viewport = carousel.querySelector<HTMLElement>('.logo-carousel__viewport');
    const track = carousel.querySelector<HTMLElement>('.logo-carousel__track');

    if (!viewport || !track) return;

    carousel.dataset.dragReady = 'true';

    let activePointerId: number | null = null;
    let startX = 0;
    let startTime = 0;
    let startOffset = 0;
    let staticOffset = 0;
    let dragged = false;
    let suppressClick = false;
    let animation: Animation | null = null;

    const wrap = (value: number, length: number) =>
      length > 0 ? ((value % length) + length) % length : value;

    viewport.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || (event.pointerType === 'mouse' && event.button !== 0)) return;

      activePointerId = event.pointerId;
      startX = event.clientX;
      startOffset = staticOffset;
      dragged = false;
      suppressClick = false;
      animation = track.getAnimations()[0] ?? null;
      startTime = Number(animation?.currentTime ?? 0);
      carousel.classList.add('is-dragging');
    });

    viewport.addEventListener('pointermove', (event) => {
      if (event.pointerId !== activePointerId) return;

      const delta = event.clientX - startX;
      if (Math.abs(delta) <= 3) return;

      dragged = true;
      if (!viewport.hasPointerCapture(event.pointerId)) {
        viewport.setPointerCapture(event.pointerId);
      }

      track.style.setProperty('--drag-offset', `${(animation ? 0 : startOffset) + delta}px`);
      event.preventDefault();
    });

    const finishDrag = (event: PointerEvent) => {
      if (event.pointerId !== activePointerId) return;

      const delta = event.clientX - startX;
      const cycleWidth = track.getBoundingClientRect().width / 2;

      if (dragged && animation && cycleWidth > 0) {
        const duration = Number(animation.effect?.getTiming().duration);
        if (duration > 0) {
          animation.currentTime = wrap(startTime - (delta / cycleWidth) * duration, duration);
        }
      } else if (dragged) {
        staticOffset = wrap(startOffset + delta, cycleWidth);
      }

      if (animation) {
        track.style.removeProperty('--drag-offset');
      } else {
        track.style.setProperty('--drag-offset', `${staticOffset}px`);
      }

      suppressClick = dragged;
      dragged = false;
      activePointerId = null;
      animation = null;
      carousel.classList.remove('is-dragging');

      if (viewport.hasPointerCapture(event.pointerId)) {
        viewport.releasePointerCapture(event.pointerId);
      }
    };

    viewport.addEventListener('pointerup', finishDrag);
    viewport.addEventListener('pointercancel', finishDrag);
    viewport.addEventListener('dragstart', (event) => event.preventDefault());
    viewport.addEventListener(
      'click',
      (event) => {
        if (!suppressClick || event.detail === 0) return;
        event.preventDefault();
        event.stopPropagation();
        suppressClick = false;
      },
      true,
    );
  });
</script>

<style>
  .logo-carousel {
    position: relative;
    width: 100%;
    min-width: 0;
    padding-top: 2.5rem;
    overflow-x: clip;
    overflow-y: visible;
    /* background: var(--bg-secondary); */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .logo-carousel__viewport {
    overflow-x: clip;
    overflow-y: visible;
    padding: var(--sp-4) 0;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
  }

  .logo-carousel__track {
    display: flex;
    width: max-content;
    gap: var(--sp-4);
    /* padding-inline: var(--sp-4); */
    animation: logo-carousel-scroll 28s linear infinite;
    translate: var(--drag-offset, 0px) 0;
    will-change: transform;
  }

  .logo-carousel:is(:hover, .is-dragging) .logo-carousel__track,
  .logo-carousel:has(:focus-visible) .logo-carousel__track {
    animation-play-state: paused;
  }

  .logo-carousel.is-dragging,
  .logo-carousel.is-dragging * {
    cursor: grabbing;
  }

  .logo-carousel__track img {
    -webkit-user-drag: none;
  }

  .logo-carousel__item {
    flex: 0 0 auto;
    width: clamp(9rem, 14vw, 12rem);
    height: clamp(4rem, 6vw, 4.75rem);
  }

  @keyframes logo-carousel-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 900px) {
    .logo-carousel__viewport {
      padding: var(--sp-3) 0;
    }

    .logo-carousel__track {
      gap: var(--sp-3);
      animation-duration: 22s;
    }

    .logo-carousel__item {
      width: clamp(8rem, 34vw, 10rem);
      height: 3.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-carousel__track {
      animation: none;
      transform: none;
    }
  }
</style>
