---
import LegalPageLayout from '../../layouts/LegalPageLayout.astro';
import heroImage from '../../assets/images/legal pages/cookie.png';
import { cookiebotDomainGroupId } from '../../config/cookiebot';
import type { Lang } from '../../i18n/types';
import { legalTranslations } from '../../i18n/pages/legal';
import { Content as EnglishContent } from '../../content/legal/cookie-policy.en.md';
import { Content as MacedonianContent } from '../../content/legal/cookie-policy.mk.md';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = legalTranslations[lang];
const PolicyContent = lang === 'mk' ? MacedonianContent : EnglishContent;
---
<LegalPageLayout heroImage={heroImage} restoreListMarkers lang={lang} title={t.cookies.title} subtitle={t.cookies.subtitle} updatedDate={t.cookies.updatedDate} description={t.cookies.description}>
  <div data-cookie-policy-copy><PolicyContent /></div>
  {cookiebotDomainGroupId && (
    <div class="legal-page__cookie-table" data-cookie-table-live>
      <script
        id="CookieDeclaration"
        src={`https://consent.cookiebot.com/${cookiebotDomainGroupId}/cd.js`}
        type="text/javascript"
        async
        is:inline
      ></script>
      <button type="button" class="btn btn--primary legal-page__manage" data-open-cookie-preferences>{t.cookies.manage}</button>
    </div>
  )}
</LegalPageLayout>
<script>
  document.querySelectorAll('[data-cookie-policy-copy]').forEach((copy) => {
    const marker = [...copy.querySelectorAll('p')].find((p) => p.textContent?.includes('[CookiebotDeclaration]'));
    const live = copy.parentElement?.querySelector('[data-cookie-table-live]');
    if (marker) {
      if (live) marker.before(live);
      marker.remove();
    }
  });
</script>
