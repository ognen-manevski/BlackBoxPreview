<svg class="sd-frontend-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" width="1400" height="1200" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1400 1200">
  <defs>
    <style>

      .sd-frontend-icon {
        --fill-color: var(--icon-bg);
        --stroke-color: var(--color-brand);
      }

      .cls-1-frontend, .cls-2-frontend, .cls-3-frontend {
        fill: none;
      }

      .cls-2-frontend {
        fill-rule: evenodd;
      }

      .cls-2-frontend, .cls-3-frontend {
        stroke: var(--stroke-color);
        stroke-miterlimit: 10;
        stroke-width: 5px;
      }

      .cls-4-frontend {
        clip-path: url(#sd-frontend-clippath);
      }


      #cursor-frontend{
        transition: transform 0.5s ease;
        fill: var(--fill-color);
      }

      .sd-service-card:hover .sd-frontend-icon #cursor-frontend{
        transform: translate(-50px, -100px);
      }

      .sd-service-card:hover .sd-frontend-icon #arrow-frontend{
        transform: translate(20px, 0px);
        animation: arrow-frontend-anim 1.4s ease infinite;
      }

      .sd-service-card:hover .sd-frontend-icon #arrow-frontend-2{
        animation: arrow-frontend-2-anim 1.4s ease infinite;
      }

      @keyframes arrow-frontend-anim {
        0% {
          transform: translate(0px, 0px);
        }
        50% {
          transform: translate(20px, 0px);
        }
        100% {
          transform: translate(0px, 0px);
        }
      }

      @keyframes arrow-frontend-2-anim {
        0% {
          transform: translate(0px, 0px);
        }
        50% {
          transform: translate(-20px, 0px);
        }
        100% {
          transform: translate(0px, 0px);
        }
      }

      #sun, #mountain {
        transition: transform 0.5s ease;
        transform-origin: left center;
      }


      .sd-service-card:hover .sd-frontend-icon #sun,
      .sd-service-card:hover .sd-frontend-icon #mountain {
        transform: translate(-20px, 0px) scale(1.05);
      }


      #text-line {
        --x: 745.79211px;
        --width: 385.42105px;
        --dist: 30px;
        --delay: 0s;
      }

      #text-line-2 {
        --x: 903.79047px;
        --width: 227.42269px;
        --dist: 30px;
        --delay: 0.6s;
      }

      #text-line-3 {
        --x: 903.79047px;
        --width: 227.42269px;
        --dist: 30px;
        --delay: 0.2s;
      }

      #text-line-4 {
        --x: 903.79047px;
        --width: 227.42269px;
        --dist: 30px;
        --delay: 0.4s;
      }

      .sd-service-card:hover .sd-frontend-icon #text-line,
      .sd-service-card:hover .sd-frontend-icon #text-line-2,
      .sd-service-card:hover .sd-frontend-icon #text-line-3,
      .sd-service-card:hover .sd-frontend-icon #text-line-4 {
        animation: text-line-anim 1.4s ease infinite;
        animation-delay: var(--delay);
      }

      @keyframes text-line-anim {
        0%,
        100% {
          x: var(--x);
          width: var(--width);
        }

        50% {
          x: calc(var(--x) + var(--dist));
          width: calc(var(--width) - var(--dist));
        }
      }


      #_1-fronted {
        --delay: 0s;
      }
      #_2-fronted {
        --delay: 0.1s;
      }
      #_3-fronted {
        --delay: 0.2s;
      }

      .sd-service-card:hover .sd-frontend-icon #_1-fronted,
      .sd-service-card:hover .sd-frontend-icon #_2-fronted,
      .sd-service-card:hover .sd-frontend-icon #_3-fronted {
        animation: dots-blink 1s step-start infinite;
        animation-delay: var(--delay);
      }

      @keyframes dots-blink {
        0%,
        100%{
          opacity: 1;
        }

        50% {
          opacity: 0;
        }
      }


    </style>
    <clipPath id="sd-frontend-clippath">
