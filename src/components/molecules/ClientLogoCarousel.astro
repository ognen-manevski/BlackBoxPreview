---
import ClientLogoCell from '../atoms/ClientLogoCell.astro';
import type { ClientLogoItem } from '../../data/clientLogos';

interface Props {
  items: ClientLogoItem[];
  ariaLabel: string;
}

const { items, ariaLabel } = Astro.props as Props;
const loopingItems = [...items, ...items];
---

<div class="logo-carousel" aria-label={ariaLabel}>
  <div class="logo-carousel__viewport">
    <div class="logo-carousel__track" aria-hidden="true">
      {loopingItems.map((item, index) => (
        <div class="logo-carousel__item" style={`--logo-index: ${index};`}>
          <ClientLogoCell name={item.name} href={item.href} src={item.src} loading={index < items.length ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .logo-carousel {
    position: relative;
    overflow: hidden;
    /* background: var(--bg-secondary); */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      #000 10%,
      #000 90%,
      transparent 100%
    );
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
  }

  .logo-carousel__viewport {
    overflow: hidden;
    padding: var(--sp-4) 0;
  }

  .logo-carousel__track {
    display: flex;
    width: max-content;
    gap: var(--sp-4);
    /* padding-inline: var(--sp-4); */
    animation: logo-carousel-scroll 28s linear infinite;
    will-change: transform;
  }

  .logo-carousel:is(:hover, :focus-within) .logo-carousel__track {
    animation-play-state: paused;
  }

  .logo-carousel__item {
    flex: 0 0 auto;
    width: clamp(9rem, 14vw, 12rem);
    height: clamp(4rem, 6vw, 4.75rem);
  }

  @keyframes logo-carousel-scroll {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 900px) {
    .logo-carousel__viewport {
      padding: var(--sp-3) 0;
    }

    .logo-carousel__track {
      gap: var(--sp-3);
      animation-duration: 22s;
    }

    .logo-carousel__item {
      width: clamp(8rem, 34vw, 10rem);
      height: 3.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-carousel__track {
      animation: none;
      transform: none;
    }
  }
</style>
