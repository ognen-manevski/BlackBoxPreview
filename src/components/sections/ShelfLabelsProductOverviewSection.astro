---
import ShelfLabelViewer from "../molecules/shelf-label-viewer/ShelfLabelViewer.astro";
import textureBlack from "../../assets/images/services/shelf-labels/texture-black.png";
import textureWhite from "../../assets/images/services/shelf-labels/texture-wh.png";
import textureWood from "../../assets/images/services/shelf-labels/texture-wood.png";
import type{ShelfLabelsContent}from'../../i18n/pages/shelf-labels'; interface Props{content:ShelfLabelsContent['overview'];viewerContent:ShelfLabelsContent['viewer']} const{content,viewerContent}=Astro.props;

const frameOptions = [
    {
        value: "black",
        label: content.colors[0],
        textureSrc: textureBlack.src,
    },
    {
        value: "white",
        label: content.colors[1],
        textureSrc: textureWhite.src,
    },
    {
        value: "wood",
        label: content.colors[2],
        textureSrc: textureWood.src,
    },
] as const;
---

<section
    class="section sl-hardware"
    id="hardware-features"
    aria-labelledby="hardware-features-heading"
>
    <div class="grid-bg"></div>
    <div class="blue-light"></div>

    <div class="container sl-hardware__container">
        <header class="section__header sl-hardware__intro">
            <p class="section-label">{content.label}</p>
            <div class="sl-hardware__heading">
                <h2
                    class="section-headline sl-hardware__headline"
                    id="hardware-features-heading"
                >
                    {content.heading}
                </h2>
                <p class="section-copy sl-hardware__lead">
                    {content.copy}
                </p>
            </div>
        </header>

        <div class="sl-hardware__visual-shell" data-hardware-visual>
            <div class="sl-hardware__visual" aria-hidden="true">
                <div class="sl-hardware__viewer">
                    <ShelfLabelViewer initialColor="white" content={viewerContent} />
                </div>
            </div>

            <div
                class="sl-hardware__controls"
                role="group"
                aria-label={content.colorAriaLabel}
            >
                {
                    frameOptions.map((option, index) => (
                        <button
                            type="button"
                            class={`sl-hardware__control ${index === 1 ? "is-active" : ""}`}
                            data-color={option.value}
                            aria-pressed={index === 0 ? "true" : "false"}
                        >
                            <span
                                class="sl-hardware__control-chip"
                                aria-hidden="true"
                            >
                                <img
                                    src={option.textureSrc}
                                    alt=""
                                    loading="lazy"
                                    decoding="async"
                                />
                            </span>
                            <span>{option.label}</span>
                        </button>
                    ))
                }
            </div>
        </div>
    </div>

    <style>
        .sl-hardware {
            background: var(--bg);
            border-bottom: 1px solid var(--border-color);
            overflow: hidden;
            position: relative;
        }

        :global(.section).sl-hardware {
            padding-bottom: 0;
        }

        @media (max-width: 1024px) {
            :global(.section).sl-hardware {
                padding-bottom: var(--sp-8);
            }
        }

        .sl-hardware__container {
            display: grid;
            /* gap: var(--sp-8); */
            overflow: visible;
            position: relative;
        }

        .blue-light {
            position: absolute;
            inset: 0;
        }


        .sl-hardware__intro {
            display: grid;
            gap: var(--sp-3);
            /* align-items: end; */
            margin-bottom: 0;
        }

        .sl-hardware__heading {
            display: grid;
            grid-template-columns: 0.6fr 1fr;
            gap: var(--sp-5);
            align-items: start;
            margin-bottom: 0;
        }

        .sl-hardware__headline,
        .sl-hardware__lead {
            margin: 0;
        }

        .sl-hardware__lead {
            align-self: end;
            max-width: 100ch;
        }

        .sl-hardware__visual-shell {
            position: relative;
            width: 100%;
            margin-left: 0;
            margin-right: 0;
            overflow: visible;
        }

        .sl-hardware__visual {
            width: 100%;
            position: relative;
            aspect-ratio: 16 / 10;
            overflow: visible;
        }

        .sl-hardware__viewer {
            width: 100%;
            height: 100%;
            border: 0;
            border-radius: 0;
            background: transparent;
            overflow: hidden;
            overflow: visible;
        }

        .sl-hardware__viewer :global(.shelf-label-viewer) {
            height: 100%;
            min-height: 0;
        }

        .sl-hardware__controls {
            position: absolute;
            top: 50%;
            right: var(--sp-4);
            transform: translateY(-50%);
            z-index: 4;
            display: grid;
            gap: var(--sp-2);
        }

        .sl-hardware__control {
            display: inline-flex;
            align-items: center;
            gap: var(--sp-2);
            padding: var(--sp-2) var(--sp-3);
            border: 1px solid var(--border-color);
            border-radius: var(--radius);
            background: var(--surface);
            color: var(--text-secondary);
            font-size: var(--text-sm);
            cursor: pointer;
            transition:
                color var(--t-base),
                border-color var(--t-base),
                background var(--t-base);
        }

        .sl-hardware__control.is-active {
            color: var(--text-primary);
            border-color: var(--color-brand);
            background: color-mix(
                in srgb,
                var(--color-brand) 12%,
                var(--surface)
            );
        }

        .sl-hardware__control-chip {
            width: 1.2rem;
            height: 1.2rem;
            border-radius: 50%;
            overflow: hidden;
            flex-shrink: 0;
            border: 2px solid var(--text-secondary);
        }

        .sl-hardware__control-chip img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        @media (max-width: 1024px) {
            .sl-hardware__container {
                gap: var(--sp-6);
            }

            .sl-hardware__intro {
                grid-template-columns: 1fr;
            }

            .sl-hardware__visual-shell {
                width: 100%;
                margin-left: 0;
                margin-right: 0;
            }

            .sl-hardware__visual {
                aspect-ratio: 12 / 10;
            }

            .sl-hardware__controls {
                top: auto;
                right: auto;
                left: 50%;
                bottom: var(--sp-3);
                transform: translateX(-50%);
                grid-auto-flow: column;
                grid-auto-columns: minmax(7rem, max-content);
                justify-content: start;
                overflow-x: auto;
                padding-bottom: var(--sp-1);
            }

            .sl-hardware__lead {
                max-width: 65ch;
            }
        }
    </style>

    <script>
        const visualRoot = document.querySelector("[data-hardware-visual]");

        if (visualRoot) {
            const controls = Array.from(
                visualRoot.querySelectorAll(".sl-hardware__control"),
            );

            if (controls.length) {
                controls.forEach((button) => {
                    button.addEventListener("click", () => {
                        const color = button.getAttribute("data-color");

                        if (!color) {
                            return;
                        }

                        document.dispatchEvent(
                            new CustomEvent("shelf-label-color-change", {
                                detail: { color },
                            }),
                        );

                        controls.forEach((item) => {
                            const isActive = item === button;
                            item.classList.toggle("is-active", isActive);
                            item.setAttribute(
                                "aria-pressed",
                                isActive ? "true" : "false",
                            );
                        });
                    });
                });
            }
        }
    </script>
</section>
