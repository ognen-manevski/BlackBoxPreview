---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogGrid from '../blog/BlogGrid.astro';
import PageHero from '../sections/PageHero.astro';
import glassCubesDarkPoster from '../../assets/images/video-thumbnails/gradients/dark/glass-cubes-1-0.jpg';
import { blogContent } from '../../i18n/pages/blog';
import { getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/types';
import '../../styles/blog.css';
interface Props { lang: Lang; posts: CollectionEntry<'blog'>[] }
const { lang, posts } = Astro.props;
const content = getTranslations(blogContent, lang);
---
<BaseLayout lang={lang} title={content.seo.title} description={content.seo.description}>
  <section class="blog-page blog-page--use-cases">
    <PageHero
      eyebrow={content.label}
      title={content.heading}
      subtitle={content.copy}
      background={{ video: 'glass-cubes-loop.mp4', poster: glassCubesDarkPoster }}
    />
    <div class="container blog-page__inner">
      <h2 class="section-headline blog-page__grid-heading">{content.industryHeading}</h2>
      <BlogGrid posts={posts} />
    </div>
  </section>
</BaseLayout>
