---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props as Props;
---

<article class="sl-ds-card" data-sl-ds-card>
  <div class="sl-ds-card__icon" aria-hidden="true">
    <slot name="icon" />
  </div>
  <div>
    <h3 class="sl-ds-card__title">{title}</h3>
    <p class="sl-ds-card__text">{text}</p>
  </div>
</article>

<style>
  .sl-ds-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-5);
    padding: var(--sp-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--surface);
    height: auto;
  }

  .sl-ds-card__icon {
    width: var(--sp-8);
    height: var(--sp-8);
    border-radius: var(--radius);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--icon-bg);
    color: var(--color-brand);
    border: 1px solid var(--color-brand);
  }

  .sl-ds-card__title {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.3;
  }

  .sl-ds-card__text {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    /* line-height: 1.45; */
    /* max-width: 40ch; */
  }

  .sl-ds-card__icon :global(svg *),
  .sl-ds-card__icon :global(path),
  .sl-ds-card__icon :global(line),
  .sl-ds-card__icon :global(polyline),
  .sl-ds-card__icon :global(polygon),
  .sl-ds-card__icon :global(rect),
  .sl-ds-card__icon :global(circle),
  .sl-ds-card__icon :global(ellipse) {
    vector-effect: non-scaling-stroke;
  }

  @media (max-width: 1024px) {
    .sl-ds-card {
      position: relative;
      top: auto;
    }
  }
</style>
