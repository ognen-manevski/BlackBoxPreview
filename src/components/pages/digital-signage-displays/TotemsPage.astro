---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BookDemoSection from '../../sections/BookDemoSection.astro';
import DigitalSignageIndustrySolutionsSection from '../../sections/services/neoslide/DigitalSignageIndustrySolutionsSection.astro';
import DigitalSignagePurchaseSection from '../../sections/services/neoslide/DigitalSignagePurchaseSection.astro';
import TotemsHeroSection from '../../sections/digital-signage-displays/TotemsHeroSection.astro';
import TotemsHowItWorksSection from '../../sections/digital-signage-displays/TotemsHowItWorksSection.astro';
import TotemsProductOverviewSection from '../../sections/digital-signage-displays/TotemsProductOverviewSection.astro';
import TotemsTechnicalDetailsSection from '../../sections/digital-signage-displays/TotemsTechnicalDetailsSection.astro';
import TotemsWhySection from '../../sections/digital-signage-displays/TotemsWhySection.astro';
import ShelfLabelsHardwareDetailsSection from '../../sections/digital-signage-displays/electronic-shelf-labels/ShelfLabelsHardwareDetailsSection.astro';
import { digitalSignageContent } from '../../../i18n/pages/services/neoslide';
import { shelfLabelsContent } from '../../../i18n/pages/digital-signage-displays/electronic-shelf-labels';
import { totemsContent } from '../../../i18n/pages/digital-signage-displays/totems';
import { storefrontImage, totemsCorporateImage, totemsRetailImage, totemsShoppingCentresImage } from '../../../i18n/pages/data/industrySolutions';
import { getTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/types';
import featureDisplayImage from '../../../assets/images/services/neoslide/totems/features/01-quality-displays.jpg';
import featureTouchscreenImage from '../../../assets/images/services/neoslide/totems/features/02-optional-touchscreens.jpg';
import featureIndoorOutdoorImage from '../../../assets/images/services/neoslide/totems/features/03-indoor-outdoor.jpg';
import featureContentManagementImage from '../../../assets/images/services/neoslide/totems/features/04-remote content-management.jpg';
import featureModularImage from '../../../assets/images/services/neoslide/totems/features/05-Exploded modular digital totem.jpg';
import featureDoubleSidedImage from '../../../assets/images/services/neoslide/totems/features/06-double-sided.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getTranslations(totemsContent, lang);
const signage = getTranslations(digitalSignageContent, lang);
const shelfLabels = getTranslations(shelfLabelsContent, lang);
const totemFeatureImages = [
  {
    image: featureDisplayImage,
    alt: { en: 'Layered screen construction for a digital signage display.', mk: 'Слоевита изработка на екран за дигитална сигнализација.' },
  },
  {
    image: featureTouchscreenImage,
    alt: { en: 'Visitor using an interactive digital totem.', mk: 'Посетител користи интерактивен дигитален тотем.' },
  },
  {
    image: featureIndoorOutdoorImage,
    alt: { en: 'Digital totems shown in indoor and outdoor settings.', mk: 'Дигитални тотеми поставени во внатрешен и надворешен простор.' },
  },
  {
    image: featureContentManagementImage,
    alt: { en: 'Laptop managing content across multiple digital totems.', mk: 'Лаптоп управува со содржината на повеќе дигитални тотеми.' },
  },
  {
    image: featureModularImage,
    alt: { en: 'Exploded view of modular digital totem components.', mk: 'Разложен приказ на модуларните компоненти на дигитален тотем.' },
  },
  {
    image: featureDoubleSidedImage,
    alt: { en: 'Single-sided and double-sided digital totems.', mk: 'Едностран и двостран дигитален тотем.' },
  },
];
if (shelfLabels.hardware.features.length !== content.keyFeatures.features.length) {
  throw new Error('Digital totems key feature copy must match the hardware image count.');
}
const hardwareContent = {
  ...shelfLabels.hardware,
  label: content.keyFeatures.label,
  heading: content.keyFeatures.heading,
  copy: content.keyFeatures.copy,
  ariaLabel: content.keyFeatures.ariaLabel,
  features: shelfLabels.hardware.features.map((feature, index) => {
    const featureCopy = content.keyFeatures.features[index];
    const featureImage = totemFeatureImages[index];

    if (!featureCopy) {
      throw new Error(`Missing digital totems key feature copy at index ${index}.`);
    }
    if (!featureImage) {
      throw new Error(`Missing digital totems key feature image at index ${index}.`);
    }

    return {
      ...feature,
      counter: featureCopy.counter,
      title: featureCopy.title,
      description: featureCopy.description,
      imageSrc: featureImage.image.src,
      image: featureImage.image,
      imageAlt: featureImage.alt[lang],
    };
  }),
};
const industryApplications = content.industryApplications;
const industrySolutionImages = new Map(
  signage.industries.solutions.map((solution) => [solution.caseStudySlug, solution]),
);
const totemsIndustryContent = {
  ...signage.industries,
  label: industryApplications.label,
  heading: industryApplications.heading,
  copy: industryApplications.copy,
  cta: industryApplications.cta,
  listAriaLabel: industryApplications.listAriaLabel,
  metrics: signage.industries.metrics,
  solutions: industryApplications.cards.map((card) => {
    const imageSource = industrySolutionImages.get(card.caseStudySlug)
      ?? (card.caseStudySlug === 'shopping-centres'
        ? industrySolutionImages.get('retail')
        : undefined);

    if (!imageSource) {
      throw new Error(`Missing digital totems industry image for "${card.caseStudySlug}".`);
    }

    return {
      ...imageSource,
      imageSrc: card.caseStudySlug === 'retail'
        ? totemsRetailImage.src
        : card.caseStudySlug === 'shopping-centres'
          ? storefrontImage.src
          : card.caseStudySlug === 'corporate'
            ? totemsCorporateImage.src
          : imageSource.imageSrc,
      title: card.title,
      excerpt: card.text,
      imageAlt: card.caseStudySlug === 'retail'
        ? (lang === 'mk' ? 'Дигитален тотем во бутик со модна колекција' : 'Digital signage totem displaying a fashion collection in a boutique')
        : card.caseStudySlug === 'shopping-centres'
          ? (lang === 'mk' ? 'Дигитален тотем во трговски центар' : 'Digital signage display in a shopping centre')
          : card.caseStudySlug === 'corporate'
            ? (lang === 'mk' ? 'Самостоен дигитален тотем во модерен деловен простор' : 'Freestanding digital signage totem in a modern office')
          : imageSource.imageAlt,
      caseStudySlug: card.caseStudySlug,
    };
  }),
};
---

<BaseLayout lang={lang} title={content.seo.title} description={content.seo.description}>
  <TotemsHeroSection content={content.hero} />
  <TotemsHowItWorksSection content={content.howItWorks} lang={lang} iconSet="totems" />
  <TotemsWhySection content={content.whyTotems} />
  <TotemsProductOverviewSection
    content={content.productOverview}
    totemModelContent={content.productOverview.viewer}
  />
  <ShelfLabelsHardwareDetailsSection content={hardwareContent} />
  <TotemsTechnicalDetailsSection content={content.technicalDetails} />
  <DigitalSignagePurchaseSection
    content={content.purchase}
    lang={lang}
    bookDemoHref="#book-demo"
    headlineWidth="22ch"
    iconSet="totems"
  />
  <DigitalSignageIndustrySolutionsSection
    content={totemsIndustryContent}
    lang={lang}
    preserveSolutionOrderAndCopy
  />
  <BookDemoSection lang={lang} defaultService={content.demoService} />
</BaseLayout>
