---
import { Image } from 'astro:assets';
import type { VideoStreamingContent } from "../../../../i18n/pages/services/video-streaming.ts";
import ProgressiveImage from "../../../../components/atoms/ProgressiveImage.astro";
import horizontalPoster from "../../../../assets/images/video-thumbnails/video-streaming/hero/horisontal-poster.jpg";
import verticalPoster from "../../../../assets/images/video-thumbnails/video-streaming/hero/mobile-poster.jpg";
import heroProductImage from "../../../../assets/images/services/video-streaming/hero/video-hero-product.png";
import { getImageOutputWidth, getOptimizedImageUrl, getResponsiveImageWidths } from "../../../../utils/images";

interface Props {
  content: VideoStreamingContent["hero"];
}

const { content } = Astro.props;
const optimizedHorizontalPoster = await getOptimizedImageUrl(horizontalPoster, 1600);
const optimizedVerticalPoster = await getOptimizedImageUrl(verticalPoster, 1200);
---

<section class="vs-hero" aria-label={content.ariaLabel} data-vs-hero>
  <div class="vs-hero__background" aria-hidden="true">
    <video
      class="vs-hero__video vs-hero__video--horizontal"
      muted
      playsinline
      preload="none"
      poster={optimizedHorizontalPoster}
      aria-hidden="true"
    >
      <source src={`${import.meta.env.BASE_URL}videos/video-streaming/hero/horisontal.mp4`} type="video/mp4" />
    </video>
    <video
      class="vs-hero__video vs-hero__video--vertical"
      muted
      playsinline
      preload="none"
      poster={optimizedVerticalPoster}
      aria-hidden="true"
    >
      <source src={`${import.meta.env.BASE_URL}videos/video-streaming/hero/vertical.mp4`} type="video/mp4" />
    </video>
  </div>
  <div class="vs-hero__overlay" aria-hidden="true"></div>
  <div class="container vs-hero__frame">
    <div class="vs-hero__content">
      <h1 class="section-headline section-headline--hero vs-hero__title">
        <span>{content.titleLineOne}</span>
        {' '}
        <span class="hero-highlight hero-highlight--animated">{content.titleHighlight}</span>
      </h1>
      <p class="section-copy vs-hero__lead">{content.lead}</p>
    </div>
    <figure class="vs-hero__preview">
      <div class="vs-hero__screen" data-progressive-host="relative">
        <ProgressiveImage src={heroProductImage} fit="contain">
          <Image
            class="vs-hero__screen-image"
            src={heroProductImage}
            alt="Live-streaming dance performance preview"
            widths={getResponsiveImageWidths(heroProductImage)}
            width={getImageOutputWidth(heroProductImage)}
            sizes="(min-width: 64rem) 38vw, (min-width: 40rem) 90vw, 94vw"
            format="webp"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </ProgressiveImage>
      </div>
      <figcaption class="vs-hero__caption">{content.previewLabel}</figcaption>
    </figure>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-vs-hero]");
  const videos = section?.querySelectorAll<HTMLVideoElement>(".vs-hero__video");
  const startedVideos = new WeakSet<HTMLVideoElement>();
  let activeVideo: HTMLVideoElement | undefined;
  let sectionIsVisible = false;

  const playHeroVideo = () => {
    const video = [...(videos ?? [])].find((candidate) => getComputedStyle(candidate).display !== "none");

    if (!video) {
      return;
    }

    if (activeVideo && activeVideo !== video) {
      activeVideo.pause();
    }

    activeVideo = video;

    if (startedVideos.has(video) && (video.ended || !video.paused)) {
      return;
    }

    startedVideos.add(video);
    video.play().catch((error: unknown) => {
      console.error("Unable to play the video-streaming hero video.", error);
    });
  };

  if (section && videos?.length && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    if ("IntersectionObserver" in window) {
      const visibilityObserver = new IntersectionObserver(
        (entries) => {
          sectionIsVisible = entries.some((entry) => entry.isIntersecting);

          if (sectionIsVisible) {
            playHeroVideo();
          }
        },
        { threshold: 0.25 },
      );
      const resizeObserver = "ResizeObserver" in window
        ? new ResizeObserver(() => {
            if (sectionIsVisible) {
              playHeroVideo();
            }
          })
        : undefined;

      visibilityObserver.observe(section);
      resizeObserver?.observe(section);
      document.addEventListener("astro:before-swap", () => {
        visibilityObserver.disconnect();
        resizeObserver?.disconnect();
      }, { once: true });
    } else {
      playHeroVideo();
    }
  }
</script>

<style>
  .vs-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg);
    container: vs-hero / inline-size;
  }

  .vs-hero__background,
  .vs-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .vs-hero__background {
    z-index: 0;
    overflow: hidden;
    background: var(--bg-secondary);
  }

  .vs-hero__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vs-hero__video--vertical {
    display: none;
  }

  .vs-hero__overlay {
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--bg) 88%, transparent) 0%,
      color-mix(in srgb, var(--bg) 68%, transparent) 48%,
      color-mix(in srgb, var(--bg) 36%, transparent) 100%
    );
  }

  @container vs-hero (max-width: 48rem) {
    .vs-hero__video--horizontal {
      display: none;
    }

    .vs-hero__video--vertical {
      display: block;
    }

    .vs-hero__overlay {
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--bg) 82%, transparent) 0%,
        color-mix(in srgb, var(--bg) 72%, transparent) 100%
      );
    }
  }

  .vs-hero__frame {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: var(--sp-4);
    min-height: 80svh;
  }

  .vs-hero__content {
    container-type: inline-size;
    display: grid;
    align-content: center;
    gap: var(--sp-4);
    width: 100%;
    max-width: none;
  }

  .vs-hero__title,
  .vs-hero__lead {
    margin: 0;
  }

  .vs-hero .vs-hero__title {
    font-size: max(2.75rem, min(6.8cqi, 4.5rem));
    line-height: 1.05;
  }

  .vs-hero__title > span {
    display: block;
  }

  @container (min-width: 40rem) {
    .vs-hero__title > span {
      white-space: nowrap;
    }
  }

  .vs-hero__lead {
    max-width: 56ch;
  }

  .vs-hero__preview {
    display: grid;
    gap: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    background: transparent;
  }

  .vs-hero__screen {
    width: 100%;
    background: transparent;
  }

  .vs-hero__screen-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .vs-hero__caption {
    position: relative;
    display: grid;
    place-items: center;
    justify-self: center;
    width: fit-content;
    min-height: var(--sp-7);
    padding-inline: var(--sp-5);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-align: center;
  }

  .vs-hero__caption::after {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
    width: 0.75rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #ff3b30;
    box-shadow: 0 0 0 0 rgb(255 59 48 / 0.55);
    content: "";
    transform: translate(50%, -50%);
    animation: vs-recording-pulse 1.6s ease-out infinite;
  }

  @keyframes vs-recording-pulse {
    70% {
      box-shadow: 0 0 0 0.45rem rgb(255 59 48 / 0);
    }

    100% {
      box-shadow: 0 0 0 0 rgb(255 59 48 / 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vs-hero__caption::after {
      animation: none;
    }
  }

  @media (max-width: 1024px) {
    .vs-hero__frame {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-6);
      min-height: auto;
      padding-top: calc(var(--navbar-height) + var(--sp-4));
      padding-bottom: var(--sp-8);
    }

    .vs-hero__content {
      margin-inline: auto;
      text-align: center;
    }

    .vs-hero__title,
    .vs-hero__lead {
      margin-inline: auto;
    }

    .vs-hero__preview {
      width: min(100%, 48rem);
      justify-self: center;
    }

  }

  @media (max-width: 600px) {
    .vs-hero .vs-hero__frame {
      padding-inline: var(--sp-2);
    }

    .vs-hero .vs-hero__title {
      font-size: min(7.2cqi, 3rem);
      letter-spacing: -0.03em;
      text-wrap: balance;
    }

    .vs-hero__title > span {
      display: inline;
      white-space: normal;
    }

  }

  @media (max-width: 320px) {
    .vs-hero .vs-hero__title {
      font-size: max(1.5rem, 7.2cqi);
      text-wrap: pretty;
    }
  }

</style>
