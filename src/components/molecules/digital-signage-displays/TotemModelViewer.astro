---
interface Props {
  content: {
    ariaLabel: string;
    loadingLabel: string;
    errorLabel: string;
  };
}

const { content } = Astro.props;
---

<div class="totem-model-viewer" data-totem-model-viewer>
  <canvas
    aria-label={content.ariaLabel}
    data-error-label={content.errorLabel}
    tabindex="0"
  ></canvas>
  <p class="totem-model-viewer__status" data-model-status aria-live="polite">
    {content.loadingLabel}
  </p>
</div>

<script>
  import { mountTotemModelViewers } from "./totem-model-viewer/lifecycle.ts";

  mountTotemModelViewers();
</script>

<style>
  .totem-model-viewer {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 16rem;
    cursor: grab;
    touch-action: none;
  }

  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    .totem-model-viewer,
    .totem-model-viewer canvas {
      touch-action: pan-y !important;
    }
  }

  .totem-model-viewer:active {
    cursor: grabbing;
  }

  .totem-model-viewer canvas {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
  }

  .totem-model-viewer canvas:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: -2px;
  }

  .totem-model-viewer__status {
    position: absolute;
    inset: auto 0 0;
    z-index: 2;
    margin: 0;
    color: var(--text-secondary);
    text-align: center;
    pointer-events: none;
  }

  .totem-model-viewer__status:empty,
  .totem-model-viewer__status[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .totem-model-viewer {
      cursor: default;
    }
  }
</style>
