---
interface Props {
  title: string;
  text: string;
}

const { title, text } = Astro.props as Props;
---

<article class="ds-card" data-ds-card>
  <div class="ds-card__layout">
    <div class="ds-card__icon" aria-hidden="true">
      <slot name="icon" />
    </div>
    <div>
      <h3 class="ds-card__title"><slot name="title">{title}</slot></h3>
      <p class="ds-card__text">{text}</p>
    </div>
  </div>
</article>

<style>
  .ds-card {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--surface);
    height: auto;
    container-type: inline-size;
  }

  .ds-card__layout {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-3);
  }

  .ds-card__icon {
    width: var(--sp-8);
    height: var(--sp-8);
    border-radius: var(--radius);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--icon-bg);
    color: var(--color-brand);
    border: 1px solid var(--color-brand);
  }

  .ds-card__icon :global(svg) {
    display: block;
    width: 2.5rem;
    height: 2.5rem;
  }

  .ds-card__title {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.3;
    text-wrap: balance;
  }

  .ds-card__text {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  @container (max-width: 22rem) {
    .ds-card__layout {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }

  @media (max-width: 1024px) {
    .ds-card {
      position: relative;
      top: auto;
    }
  }
</style>