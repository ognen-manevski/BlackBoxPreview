---
import { getCollection } from 'astro:content';
import NewsPage from '../../components/pages/NewsPage.astro';
const posts = (await getCollection('news', ({ data }) => !data.draft && data.lang === 'en')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---
<NewsPage lang="en" posts={posts} />
