---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getImageOutputWidth, getOptimizedImageUrl, getResponsiveImageWidths } from '../../utils/images';

interface Props {
  videoSrc: string;
  posterSrc?: ImageMetadata;
  objectPosition?: string;
  widthMd?: string;
  widthSm?: string;
  opacityMd?: string;
  opacitySm?: string;
  overlayColor?: string;
  videoBlur?: string;
}

const {
  videoSrc,
  posterSrc,
  objectPosition = 'center right',
  widthMd = 'min(64vw, 32rem)',
  widthSm = '100%',
  opacityMd = '0.9',
  opacitySm = '0.5',
  overlayColor = 'transparent',
  videoBlur = '0px',
} = Astro.props as Props;
const optimizedPoster = posterSrc ? await getOptimizedImageUrl(posterSrc, 1600) : undefined;
---

<div
  class="section-gradient-bg"
  aria-hidden="true"
  style={`--section-bg-width-md: ${widthMd}; --section-bg-width-sm: ${widthSm}; --section-bg-opacity-md: ${opacityMd}; --section-bg-opacity-sm: ${opacitySm}; --section-bg-overlay: ${overlayColor}; --section-bg-video-blur: ${videoBlur};`}
>
  <video
    class="section-gradient-bg__video"
    src={videoSrc}
    poster={optimizedPoster}
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    style={`object-position: ${objectPosition};`}
  ></video>

  {posterSrc && (
    <Picture
      class="section-gradient-bg__poster"
      src={posterSrc}
      widths={getResponsiveImageWidths(posterSrc)}
      width={getImageOutputWidth(posterSrc)}
      sizes="100vw"
      alt=""
      loading="lazy"
    />
  )}

  <div class="section-gradient-bg__overlay"></div>
</div>

<style>
  .section-gradient-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .section-gradient-bg__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
    transition: opacity var(--t-base);
    filter: blur(var(--section-bg-video-blur));
    transform: scale(1.01);
  }

  .section-gradient-bg__overlay {
    position: absolute;
    inset: 0;
    background: var(--section-bg-overlay);
  }

  .section-gradient-bg__poster {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 1;
  }

  .section-gradient-bg__poster :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 700px) {
    .section-gradient-bg__video {
      display: none;
    }

    .section-gradient-bg__poster {
      display: block;
      opacity: 0.5;
      filter: blur(0.5rem);
      transform: scale(1.03);
      transform-origin: center;
    }
  }
</style>
