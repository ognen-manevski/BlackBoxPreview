---
import DsCard from '../../atoms/DsCard.astro';
import SectionTitleGroup from '../../molecules/SectionTitleGroup.astro';
import type { TotemsContent } from '../../../i18n/pages/digital-signage-displays/totems';

interface Props {
  content: TotemsContent['whyTotems'];
  iconSet?: 'totems' | 'interactive-displays';
}

const { content, iconSet = 'totems' } = Astro.props;
const totemsBenefitIconModules = import.meta.glob<string>(
  '../../../assets/vectors/icons/totems/totem-benefit-icons/*.svg',
  { query: '?raw', import: 'default' },
);
const interactiveDisplaysBenefitIconModules = import.meta.glob<string>(
  '../../../assets/vectors/icons/interactive-displays/interactive-benefit-icons/*.svg',
  { query: '?raw', import: 'default' },
);
const totemsBenefitIconNames = [
  'capture-attention',
  'keep-information-current',
  'reduce-printing-manual-work',
  'strengthen-your-brand',
  'help-customers-find-answers',
  'support-sales',
] as const;
const interactiveDisplaysBenefitIconNames = [
  'easy-to-find',
  'self-service',
  'fewer-repetitive-questions',
  'help-customers-decide',
  'encourage-participation',
  'consistent-experience',
] as const;
const benefitIconNames = iconSet === 'totems' ? totemsBenefitIconNames : interactiveDisplaysBenefitIconNames;
const benefitIconModules = iconSet === 'totems' ? totemsBenefitIconModules : interactiveDisplaysBenefitIconModules;
const benefitIconDirectory = iconSet === 'totems' ? 'totems/totem-benefit-icons' : 'interactive-displays/interactive-benefit-icons';
const benefitIcons = await Promise.all(benefitIconNames.map(async (name) => {
  const iconPath = `../../../assets/vectors/icons/${benefitIconDirectory}/${name}.svg`;
  const loadIcon = benefitIconModules[iconPath];

  if (!loadIcon) {
    throw new Error(`Missing digital totems benefit icon: ${name}`);
  }

  return (await loadIcon()).replace(/^<\?xml[^>]*>\s*/, '');
}));
---

<section class="section totems-why" aria-labelledby="totems-why-heading">
  <div class="container u-section-title-stack">
    <SectionTitleGroup
      class="totems-why__intro"
      label={content.label}
      heading={content.heading}
      headingId="totems-why-heading"
      headlineWidth="30ch"
      titleWidth="58%"
      copy={content.copy}
    />

    <ul class="totems-why__cards" aria-label={content.ariaLabel}>
      {content.cards.map((card, index) => (
        <li class="totems-why__item">
          <DsCard title={card.title} text={card.text}>
            <span slot="icon" set:html={benefitIcons[index]} />
          </DsCard>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .totems-why {
    background: var(--bg);
    border-bottom: 1px solid var(--border-color);
  }

  .totems-why__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-2);
    margin: 0;
    padding: 0;
  }

  .totems-why__item {
    display: grid;
    list-style: none;
  }

  .totems-why__cards :global(.ds-card__icon > span) {
    display: contents;
  }

  .totems-why__cards :global(.ds-card__icon svg) {
    width: 80%;
    height: 80%;
  }

  @media (max-width: 1200px) {
    .totems-why__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .totems-why__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
