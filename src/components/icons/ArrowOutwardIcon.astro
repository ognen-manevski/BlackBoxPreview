---
import arrowOutward from '../../assets/vectors/icons/material/custom/arrow_outward_400w.svg?raw';

interface Props { class?: string }
const { class: className = '' } = Astro.props;
---

<span class:list={['arrow-outward-icon', className]} aria-hidden="true" set:html={arrowOutward} />

<style>
  .arrow-outward-icon {
    display: inline-flex;
    width: auto;
    height: auto;
    font-size: inherit;
    line-height: 1;
  }

  .arrow-outward-icon :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
</style>
