---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../sections/ContactForm.astro';
import PageHero from '../sections/PageHero.astro';
import ContactDetailItem from '../atoms/ContactDetailItem.astro';
import PhoneIcon from '../icons/PhoneIcon.astro';
import MailIcon from '../icons/MailIcon.astro';
import MapPinIcon from '../icons/MapPinIcon.astro';
import SubscribeField from '../atoms/SubscribeField.astro';
import { commonTranslations } from '../../i18n/common';
import { homePageContent } from '../../i18n/pages/home';
import { contactPageContent } from '../../i18n/pages/contact';
import { getLocalizedPath, getTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/types';
import gradient1DarkPoster from '../../assets/images/video-thumbnails/gradients/dark/gradient-1-grain-0.jpg';
import { getOptimizedImageUrl } from '../../utils/images';
import openInNewIconRaw from '../../assets/vectors/icons/material/custom/open_in_new-600w.svg?raw';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const content = getTranslations(contactPageContent, lang);
const homeContact = getTranslations(homePageContent, lang).contact;
const common = getTranslations(commonTranslations, lang);
const href = (path: string) => getLocalizedPath(path, lang);
const mapsUrl = 'https://maps.google.com/maps?q=Klenoec+61,+Skopje,+Macedonia';
const mapEmbedUrl = `${mapsUrl}&output=embed&t=m`;
const contactIconStyle = '--icon-badge-size: 2rem; --icon-badge-border: color-mix(in srgb, var(--border-color) 72%, var(--color-brand)); --icon-badge-bg: var(--icon-bg); --icon-badge-color: var(--color-brand);';
const openInNewIcon = openInNewIconRaw.replace('fill="#1f1f1f"', 'fill="currentColor"').replace('<svg ', '<svg class="btn__arrow" width="18" height="18" ');
const optimizedNewsletterPoster = await getOptimizedImageUrl(gradient1DarkPoster, 1600);
---

<BaseLayout lang={lang} title={content.seo.title} description={content.seo.description}>
  <PageHero
    eyebrow={content.hero.eyebrow}
    title={content.hero.title}
    subtitle={content.hero.copy}
  />

  <section class="contact-page__contact section" aria-labelledby="contact-page-heading">
    <div class="container contact-page__contact-grid">
      <div class="contact-page__details">
        <h2 class="section-headline contact-page__section-title" id="contact-page-heading">
          {common.footer.contact}
        </h2>
        <ul class="contact-page__details-list">
          <li>
            <ContactDetailItem
              class="contact-page__detail"
              label={homeContact.phoneLabel}
              value="+389 75 444 908"
              href="tel:+38975444908"
              iconStyle={contactIconStyle}
            >
              <PhoneIcon slot="icon" />
            </ContactDetailItem>
          </li>
          <li>
            <ContactDetailItem
              class="contact-page__detail"
              label={homeContact.emailDirectLabel}
              value="contact@blackboxsolutions.mk"
              href="mailto:contact@blackboxsolutions.mk"
              iconStyle={contactIconStyle}
            >
              <MailIcon slot="icon" />
            </ContactDetailItem>
          </li>
          <li>
            <ContactDetailItem
              class="contact-page__detail"
              label={common.footer.office}
              value={common.footer.officeAddress}
              href={mapsUrl}
              iconStyle={contactIconStyle}
            >
              <MapPinIcon slot="icon" />
            </ContactDetailItem>
          </li>
        </ul>
        <div class="contact-page__map u-border-interactive">
          <iframe
            src={mapEmbedUrl}
            title={common.footer.mapTitle}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
          <footer class="contact-page__map-footer">
            <a class="btn btn--primary btn--sm btn--with-arrow contact-page__map-cta" href={mapsUrl} target="_blank" rel="noopener noreferrer">
              <span>{common.footer.openInMaps}</span>
              <Fragment set:html={openInNewIcon} />
            </a>
          </footer>
        </div>
      </div>

      <ContactForm content={homeContact} heading={content.contact.formTitle} />
    </div>
  </section>

  <section class="contact-page__newsletter section" aria-labelledby="contact-newsletter-heading">
    <video
      class="contact-page__newsletter-video"
      autoplay
      loop
      muted
      playsinline
      preload="metadata"
      poster={optimizedNewsletterPoster}
      aria-hidden="true"
    >
      <source src={`${import.meta.env.BASE_URL}videos/gradients/dark/base-gradient-1.mp4`} type="video/mp4" media="(min-width: 641px)" />
    </video>
    <div class="contact-page__newsletter-overlay" aria-hidden="true"></div>
    <div class="container contact-page__newsletter-inner">
      <p class="section-label contact-page__newsletter-label">{content.newsletter.eyebrow}</p>
      <div class="contact-page__newsletter-layout">
        <div class="contact-page__newsletter-copy">
          <h2 class="section-headline" id="contact-newsletter-heading">
            {content.newsletter.title}
          </h2>
          <p class="section-copy">{content.newsletter.copy}</p>
        </div>
        <div class="contact-page__newsletter-form">
          <SubscribeField
            class="contact-page__subscribe"
            buttonLabel={common.forms.subscribe}
            label={common.forms.emailLabel}
            placeholder="you@company.com"
            visibleLabel
            privacyId="contact-page-subscribe-consent"
            privacyText={common.forms.privacyPrefix}
            privacyLinkText={common.forms.privacyPolicy}
            privacyLinkHref={href('/privacy-policy/')}
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page__contact-grid {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    align-items: stretch;
    gap: var(--sp-8);
  }

  .contact-page__details {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    min-width: 0;
  }

  .contact-page__section-title {
    margin: 0;
  }

  .contact-page__details-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4) var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-page__details-list li:last-child {
    grid-column: 1 / -1;
  }

  :global(.contact-page__detail) {
    align-items: center;
  }

  .contact-page__map {
    display: flex;
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    min-height: 18rem;
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
  }

  .contact-page__map iframe {
    display: block;
    flex: 1;
    width: 100%;
    min-height: 18rem;
    border: 0;
    filter: grayscale(1) invert(.9) contrast(.95);
  }

  .contact-page__map-footer {
    display: flex;
    justify-content: flex-start;
    padding: var(--sp-3);
    border-top: 1px solid var(--border-color);
  }

  .contact-page__map-cta {
    text-decoration: none;
  }

  :global(.contact-page__map-cta .btn__arrow) {
    height: 1.4em;
    transform: translateY(-.1em);
    transition: none;
  }

  :global(.contact-page__map-cta:is(:hover, :focus-visible) .btn__arrow) {
    transform: translateY(-.1em);
  }

  :global(.contact-page__contact .privacy-consent),
  :global(.contact-page__newsletter .privacy-consent) {
    align-items: center;
  }

  :global(.contact-page__contact .privacy-consent__check),
  :global(.contact-page__newsletter .privacy-consent__check) {
    margin-top: 0;
  }

  .contact-page__newsletter {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg);
  }

  .contact-page__newsletter-video {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-page__newsletter-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(90deg, color-mix(in srgb, var(--bg) 70%, transparent) 0%, color-mix(in srgb, var(--bg) 24%, transparent) 70%, color-mix(in srgb, var(--bg) 35%, transparent) 100%);
  }

  .contact-page__newsletter-inner {
    position: relative;
    z-index: 2;
  }

  .contact-page__newsletter-label {
    margin: 0 0 var(--sp-5);
  }

  .contact-page__newsletter-layout {
    display: flex;
    align-items: center;
    gap: var(--sp-8);
  }

  .contact-page__newsletter-copy {
    display: grid;
    gap: var(--sp-3);
    flex: 1 1 50%;
    min-width: 0;
  }

  .contact-page__newsletter-copy .section-label,
  .contact-page__newsletter-copy .section-headline,
  .contact-page__newsletter-copy .section-copy {
    margin: 0;
  }

  .contact-page__newsletter-form {
    flex: 1 1 50%;
    min-width: 0;
  }

  @media (max-width: 900px) {
    .contact-page__contact-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .contact-page__map {
      flex: initial;
    }

    .contact-page__newsletter-layout {
      flex-direction: column;
      align-items: stretch;
      gap: var(--sp-6);
    }
  }

  @media (max-width: 600px) {
    .contact-page__details-list {
      grid-template-columns: 1fr;
    }

    .contact-page__details-list li:last-child {
      grid-column: auto;
    }
  }

  @media (max-width: 700px) {
    .contact-page__newsletter-overlay {
      background: linear-gradient(180deg, color-mix(in srgb, var(--bg) 62%, transparent) 0%, color-mix(in srgb, var(--bg) 34%, transparent) 100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-page__newsletter-video {
      display: none;
    }
  }

</style>
