---
import ClientLogoCell from '../atoms/ClientLogoCell.astro';
import ContentGrid from '../molecules/ContentGrid.astro';
import SectionTitleGroup from '../molecules/SectionTitleGroup.astro';
import { clientLogos } from '../../data/clientLogos';
import type { HomePageContent } from '../../i18n/pages/home';
interface Props { content: HomePageContent['partners']; }
const { content } = Astro.props;

const partnerGridCells = Array.from({ length: 12 }, (_, index) => {
  const partner = clientLogos[index % clientLogos.length];

  return {
    component: ClientLogoCell,
    props: {
      name: partner.name,
      href: partner.href,
      src: partner.src,
      loading: index < 6 ? 'eager' : 'lazy',
    },
    ariaLabel: partner.name,
  };
});
---

<section class="section partners" id="partners" aria-labelledby="partners-heading">
  <div class="container partners__inner u-section-title-stack">
    <SectionTitleGroup
      class="partners__header"
      headlineClass="partners__headline"
      copyClass="partners__copy"
      label={content.label}
      heading={content.heading}
      headingId="partners-heading"
      copy={content.copy}
    />

    <ContentGrid cellContent={partnerGridCells} ariaLabel={content.gridAriaLabel} />
  </div>
</section>

<style>
  .partners {
    background: var(--bg);
  }

  :global(.partners__headline) {
    max-width: 24ch;
    margin-bottom: 0;
  }

  :global(.partners__copy) {
    max-width: 52ch;
  }

  @media (max-width: 800px) {
    :global(.partners .content-grid) {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    :global(.partners .content-grid__cell:nth-child(n + 11)) {
      display: none;
    }
  }

  @media (max-width: 700px) {
    :global(.partners .content-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    :global(.partners .content-grid__cell:nth-child(n + 10)) {
      display: none;
    }
  }

  @media (max-width: 260px) {
    :global(.partners .content-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    :global(.partners .content-grid__cell:nth-child(n + 7)) {
      display: none;
    }
  }
</style>
