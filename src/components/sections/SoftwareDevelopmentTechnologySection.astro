---
import TechnologyGrid from "../molecules/TechnologyGrid.astro";
import SectionTitleGroup from "../molecules/SectionTitleGroup.astro";
import type { SoftwareDevelopmentContent } from '../../i18n/pages/software-development';
interface Props { content: SoftwareDevelopmentContent['technology'] } const { content } = Astro.props;
---

<section
  class="section technology"
  id="technology"
  aria-labelledby="technology-heading"
>
  <div class="container technology__inner">
    <SectionTitleGroup
      class="technology__header"
      label={content.label}
      heading={content.heading}
      headingId="technology-heading"
      titleWidth="42%"
      headlineWidth="26ch"
      copy={content.copy}
    />

    <TechnologyGrid content={content.grid} />
  </div>
</section>

<style>
  .technology {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg);
  }

  .technology__inner {
    position: relative;
    z-index: 1;
  }

  .technology__header {
    /* max-width: 74ch; */
    margin-bottom: var(--sp-6);
  }

</style>
