---
interface Props {
  content: {
    ariaLabel: string;
    loadingLabel: string;
    errorLabel: string;
  };
}

const { content } = Astro.props;
---

<div
  class="interactive-display-viewer"
  data-interactive-display-viewer
>
  <canvas aria-label={content.ariaLabel} data-error-label={content.errorLabel} tabindex="0"></canvas>
  <p class="interactive-display-viewer__status" data-model-status aria-live="polite">
    {content.loadingLabel}
  </p>
</div>

<script>
  import { mountInteractiveDisplayViewers } from "./interactive-display-model-viewer/lifecycle.ts";

  mountInteractiveDisplayViewers();
</script>

<style>
  .interactive-display-viewer {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 16rem;
    cursor: grab;
    touch-action: none;
  }

  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    .interactive-display-viewer,
    .interactive-display-viewer canvas {
      touch-action: pan-y !important;
    }
  }

  .interactive-display-viewer:active {
    cursor: grabbing;
  }

  .interactive-display-viewer canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .interactive-display-viewer canvas:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: -2px;
  }

  .interactive-display-viewer__status {
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    color: var(--text-secondary);
    text-align: center;
    pointer-events: none;
  }

  .interactive-display-viewer__status:empty {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .interactive-display-viewer {
      cursor: default;
    }
  }
</style>
