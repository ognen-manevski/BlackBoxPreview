---
import type { VideoStreamingContent } from "../../../../i18n/pages/services/video-streaming.ts";

interface Props {
  content: VideoStreamingContent["hero"];
}

const { content } = Astro.props;
---

<section class="vs-hero" aria-label={content.ariaLabel}>
  <div class="container vs-hero__frame">
    <div class="vs-hero__content">
      <h1 class="section-headline section-headline--hero vs-hero__title">
        <span>{content.titleLineOne}</span>
        {' '}
        <span class="hero-highlight hero-highlight--animated">{content.titleHighlight}</span>
      </h1>
      <p class="section-copy vs-hero__lead">{content.lead}</p>
    </div>

    <figure class="vs-hero__preview">
      <!-- TODO: Replace the screen placeholder with the streaming product preview image. -->
      <div class="vs-hero__screen" aria-hidden="true"></div>
      <figcaption class="vs-hero__caption">{content.previewLabel}</figcaption>
    </figure>
  </div>
</section>

<style>
  .vs-hero {
    overflow: hidden;
    background: var(--bg);
  }

  .vs-hero__frame {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    align-items: center;
    gap: var(--sp-4);
    min-height: 80svh;
  }

  .vs-hero__content {
    container-type: inline-size;
    display: grid;
    align-content: center;
    gap: var(--sp-4);
    width: 100%;
    max-width: none;
  }

  .vs-hero__title,
  .vs-hero__lead {
    margin: 0;
  }

  .vs-hero .vs-hero__title {
    font-size: max(2.75rem, min(6.8cqi, 4.5rem));
    line-height: 1.05;
  }

  .vs-hero__title > span {
    display: block;
  }

  @container (min-width: 40rem) {
    .vs-hero__title > span {
      white-space: nowrap;
    }
  }

  .vs-hero__lead {
    max-width: 56ch;
  }

  .vs-hero__preview {
    display: grid;
    gap: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
  }

  .vs-hero__screen {
    width: 100%;
    aspect-ratio: 16 / 9;
    border: 1px solid var(--border-color);
    background: var(--bg);
  }

  .vs-hero__caption {
    display: grid;
    place-items: center;
    min-height: var(--sp-7);
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-align: center;
  }

  @media (max-width: 1024px) {
    .vs-hero__frame {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sp-6);
      min-height: auto;
      padding-top: calc(var(--navbar-height) + var(--sp-4));
      padding-bottom: var(--sp-8);
    }

    .vs-hero__content {
      margin-inline: auto;
      text-align: center;
    }

    .vs-hero__title,
    .vs-hero__lead {
      margin-inline: auto;
    }

    .vs-hero__preview {
      width: min(100%, 48rem);
      justify-self: center;
    }
  }

  @media (max-width: 600px) {
    .vs-hero .vs-hero__frame {
      padding-inline: var(--sp-2);
    }

    .vs-hero .vs-hero__title {
      font-size: min(7.2cqi, 3rem);
      letter-spacing: -0.03em;
      text-wrap: balance;
    }

    .vs-hero__title > span {
      display: inline;
      white-space: normal;
    }

  }

  @media (max-width: 320px) {
    .vs-hero .vs-hero__title {
      font-size: max(1.5rem, 7.2cqi);
      text-wrap: pretty;
    }
  }

</style>
