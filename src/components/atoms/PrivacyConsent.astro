---
import Checkmark from './Checkmark.astro';

interface Props {
  id?: string;
  name?: string;
  checked?: boolean;
  required?: boolean;
  text: string;
  linkText: string;
  linkHref?: string;
  class?: string;
}

const {
  id = `privacy-${Math.random().toString(36).slice(2, 9)}`,
  name = 'privacyConsent',
  checked = true,
  required = false,
  text,
  linkText,
  linkHref = '#',
  class: className = '',
} = Astro.props;
---

<label class:list={['privacy-consent', className]}>
  <input
    class="privacy-consent__input"
    id={id}
    name={name}
    type="checkbox"
    checked={checked}
    required={required}
    data-privacy-consent-input
  >
  <span class="privacy-consent__check" aria-hidden="true">
    <Checkmark size="0.7rem" />
  </span>
  <span class="privacy-consent__text">
    {text} <a href={linkHref}>{linkText}</a>
  </span>
</label>

<style>
  .privacy-consent {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
    padding: var(--sp-1) var(--sp-2);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background var(--t-fast);
  }

  .privacy-consent__input {
    appearance: none;
    width: 0.875rem;
    height: 0.875rem;
    margin: 0;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--text-muted) 55%, var(--border-color));
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    cursor: pointer;
    position: absolute;
    opacity: 0;
    pointer-events: none;
    transition: background var(--t-fast), border-color var(--t-fast);
  }

  .privacy-consent__check {
    width: 0.875rem;
    height: 0.875rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--text-muted) 55%, var(--border-color));
    border-radius: var(--radius-sm);
    background: var(--bg-secondary);
    color: transparent;
    transition: background var(--t-fast), border-color var(--t-fast), color var(--t-fast);
  }

  .privacy-consent__input:checked + .privacy-consent__check {
    border-color: var(--color-brand);
    background-color: var(--bg-secondary);
    color: var(--color-brand);
  }

  .privacy-consent__input:focus-visible + .privacy-consent__check {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .privacy-consent__text a {
    color: var(--text-primary);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--text-primary) 45%, transparent);
    text-underline-offset: 0.12em;
  }

  .privacy-consent__text a:is(:hover, :focus-visible) {
    text-decoration-color: currentColor;
  }
</style>

<script>
  const syncConsentForm = (form: HTMLFormElement) => {
    const consentInput = form.querySelector('[data-privacy-consent-input]');
    if (!(consentInput instanceof HTMLInputElement)) return;

    const submitControls = form.querySelectorAll('button[type="submit"], input[type="submit"]');
    submitControls.forEach(submitControl => {
      if (submitControl instanceof HTMLButtonElement || submitControl instanceof HTMLInputElement) {
        submitControl.disabled = !consentInput.checked;
      }
    });
  };

  const syncConsentForms = () => {
    document.querySelectorAll('form').forEach(form => {
      if (form instanceof HTMLFormElement) syncConsentForm(form);
    });
  };

  syncConsentForms();

  document.addEventListener('change', event => {
    const target = event.target;
    if (!(target instanceof HTMLInputElement) || !target.matches('[data-privacy-consent-input]')) return;

    const form = target.closest('form');
    if (form instanceof HTMLFormElement) syncConsentForm(form);
  });

  document.addEventListener('reset', event => {
    const form = event.target;
    if (form instanceof HTMLFormElement) window.setTimeout(() => syncConsentForm(form));
  });
</script>
