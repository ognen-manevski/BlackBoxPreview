---
import DisclosureItem from '../../../atoms/DisclosureItem.astro';
import MetricChip from '../../../atoms/MetricChip.astro';
import type { DigitalSignageContent } from '../../../../i18n/pages/services/neoslide';
import ArrowForwardIcon from '../../../icons/ArrowForwardIcon.astro';
import type { Lang } from '../../../../i18n/types';
import { getCollection } from 'astro:content';
interface Props {
    content: DigitalSignageContent['industries'];
    lang: Lang;
    preserveSolutionOrderAndCopy?: boolean;
}
const { content, lang, preserveSolutionOrderAndCopy = false } = Astro.props;
const { metrics, solutions } = content;
const base = import.meta.env.BASE_URL;
const localPath = (path: string) => `${base}${lang === 'mk' ? 'mk/' : ''}${path}`;
const newCaseStudySlugs = new Set([
    'corporate',
    'education',
    'sports-events',
    'events-venues',
    'banking-finance',
    'public-advertising',
]);
const blogPosts = await getCollection('blog', ({ data }) => !data.draft && data.lang === lang);
const blogPostsBySlug = new Map(blogPosts.map((post) => [post.id.split('/')[0], post]));
const visibleSolutions = solutions
    .map((solution, sourceIndex) => {
        const post = solution.caseStudySlug ? blogPostsBySlug.get(solution.caseStudySlug) : undefined;
        const useNeoSlideCopy = solution.caseStudySlug && newCaseStudySlugs.has(solution.caseStudySlug);

        return {
            ...solution,
            title: preserveSolutionOrderAndCopy || useNeoSlideCopy || !post ? solution.title : post.data.title,
            excerpt: preserveSolutionOrderAndCopy || useNeoSlideCopy || !post ? solution.excerpt : post.data.description,
            publishedAt: post?.data.publishedAt.getTime() ?? 0,
            sourceIndex,
        };
    })
    .filter((solution) => solution.caseStudySlug && solution.publishedAt > 0)
    .sort((a, b) => preserveSolutionOrderAndCopy
        ? a.sourceIndex - b.sourceIndex
        : b.publishedAt - a.publishedAt || a.sourceIndex - b.sourceIndex)
    .slice(0, 6);
---

<section
    class="section industry-solutions"
    id="industry-solutions"
    aria-labelledby="industry-solutions-heading"
>
    <div class="container industry-solutions__container">
        <div class="industry-solutions__layout">
            <header class="industry-solutions__intro section__header">
                <p class="section-label industry-solutions__label">{content.label}</p>
                <h2 class="section-headline industry-solutions__headline" id="industry-solutions-heading">
                    {content.heading}
                </h2>
                <p class="section-copy industry-solutions__copy">
                    {content.copy}
                </p>

                <a class="btn btn--primary btn--with-arrow industry-solutions__cta" href={localPath('use-cases/')}>
                    {content.cta}
                    <ArrowForwardIcon />
                </a>

                {metrics.length > 0 && (
                    <ul class="industry-solutions__metrics" aria-label={content.metricsAriaLabel}>
                        {metrics.map((metric) => (
                            <MetricChip value={metric.value} label={metric.label} />
                        ))}
                    </ul>
                )}
            </header>

            <div class="industry-solutions__list" aria-label={content.listAriaLabel}>
                {visibleSolutions.map((solution, index) => (
                    <DisclosureItem
                        counter={String(index + 1).padStart(2, '0')}
                        title={solution.title}
                        content={solution.excerpt}
                        imageSrc={solution.imageSrc}
                        imageAlt={solution.imageAlt}
                        href={solution.caseStudySlug ? localPath(`use-cases/${solution.caseStudySlug}/`) : undefined}
                        ctaLabel={content.findOutMore}
                        open={index === 0}
                    />
                ))}
            </div>
        </div>
    </div>
</section>

<style>
    .industry-solutions {
        background: var(--bg);
        border-bottom: 1px solid var(--border-color);
    }

    .industry-solutions__layout {
        display: grid;
        grid-template-columns: 1fr 1.435fr;
        gap: var(--sp-10);
        align-items: start;
    }

    .industry-solutions__label {
        margin-bottom: 0;
    }

    .industry-solutions__intro {
        display: grid;
        gap: var(--sp-4);
        text-align: left;
        max-width: 40rem;
        margin-bottom: 0;
    }

    .industry-solutions__headline {
        max-width: 18ch;
    }

    .industry-solutions__copy {
        max-width: 52ch;
    }

    .industry-solutions__cta {
        width: fit-content;
        margin-top: var(--sp-3);
    }

    .industry-solutions__list {
        display: grid;
        gap: var(--sp-4);
        align-content: start;
    }

    .industry-solutions__metrics {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-3);
        margin-top: var(--sp-7);
    }

    .industry-solutions__metrics :global(.metric-chip) {
        flex: 1 1 13rem;
    }

    @media (max-width: 1200px) {
        .industry-solutions__layout {
            gap: var(--sp-6);
        }
    }

    @media (max-width: 980px) {
        .industry-solutions__layout {
            grid-template-columns: 1fr;
            gap: var(--sp-6);
        }
    }

    @media (max-width: 700px) {
        .industry-solutions__layout {
            gap: var(--sp-5);
        }

        .industry-solutions__intro {
            max-width: none;
        }

        .industry-solutions__headline,
        .industry-solutions__copy {
            max-width: none;
        }

        .industry-solutions__metrics {
            margin-top: var(--sp-6);
        }
    }
</style>
