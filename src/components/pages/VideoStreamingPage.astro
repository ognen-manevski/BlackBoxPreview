---
import BaseLayout from '../../layouts/BaseLayout.astro'; import VideoStreamingHeroSection from '../sections/VideoStreamingHeroSection.astro'; import VideoStreamingConsultingSection from '../sections/VideoStreamingConsultingSection.astro'; import VideoStreamingHotelSolutionsSection from '../sections/VideoStreamingHotelSolutionsSection.astro'; import BookDemoSection from '../sections/BookDemoSection.astro'; import{videoStreamingContent}from'../../i18n/pages/video-streaming'; import{getTranslations}from'../../i18n/utils';import type{Lang}from'../../i18n/types';interface Props{lang:Lang}const{lang}=Astro.props;const c=getTranslations(videoStreamingContent,lang);
---
<BaseLayout lang={lang} title={c.seo.title} description={c.seo.description}><VideoStreamingHeroSection content={c.hero}/><VideoStreamingConsultingSection content={c.consulting}/><VideoStreamingHotelSolutionsSection content={c.hotel} bentoContent={c.bento}/><BookDemoSection lang={lang} defaultService={c.demoService}/></BaseLayout>
