---
import type { VideoStreamingContent } from '../../../../i18n/pages/services/video-streaming.ts';
import ProgressiveImage from '../../../atoms/ProgressiveImage.astro';
import streamingEventsDashboardImage from '../../../../assets/images/services/video-streaming/how-it-works/streaming-events-dashboard.jpg';
import checkoutImage from '../../../../assets/images/services/video-streaming/how-it-works/checkout.jpg';
import eventGalleryImage from '../../../../assets/images/services/video-streaming/how-it-works/event-gallery.jpg';
import livePerformancePoster from '../../../../assets/images/video-thumbnails/video-streaming/how-it-works/live-performance-poster.jpg';
import reachBeyondVenueIcon from '../../../../assets/vectors/icons/video-streaming/video-streaming-benefits-icons/reach-beyond-the-venue.svg?raw';
import anotherSourceOfRevenueIcon from '../../../../assets/vectors/icons/video-streaming/video-streaming-benefits-icons/another-source-of-revenue.svg?raw';
import brandAtTheCentreIcon from '../../../../assets/vectors/icons/video-streaming/video-streaming-benefits-icons/brand-at-the-centre.svg?raw';

interface Props {
  content: VideoStreamingContent['consulting'];
}

const { content } = Astro.props;
const prepareIcon = (icon: string) => icon
  .replace(/^<\?xml[^>]*>\s*/, '')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const featureIcons = [
  reachBeyondVenueIcon,
  anotherSourceOfRevenueIcon,
  brandAtTheCentreIcon,
].map(prepareIcon);
const cardImages = [streamingEventsDashboardImage, checkoutImage, eventGalleryImage];
---

<section class="section vs-consulting" aria-labelledby="vs-consulting-heading">
  <div class="container vs-consulting__inner">
    <div class="vs-consulting__content-wrap">
      <div class="vs-consulting__content">
        <p class="section-label">{content.label}</p>
        <h2
          class="section-headline vs-consulting__headline"
          id="vs-consulting-heading"
        >
          {content.heading}
        </h2>
        <p class="section-copy vs-consulting__copy">
          {content.copy}
        </p>
      </div>

      <ul class="vs-consulting__feature-list">
        {content.featureCards.map((card, index) => (
          <li class="vs-consulting__feature">
            <span class="vs-consulting__feature-icon" aria-hidden="true" set:html={featureIcons[index]} />
            <div class="vs-consulting__feature-content">
              <h3 class="vs-consulting__feature-title">{card.title}</h3>
              <p class="vs-consulting__feature-copy">{card.copy}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="vs-consulting__cards">
      {content.cards.map((card, index) => (
        <article
          class="vs-consulting__card"
          style={`--vs-card-z:${index + 1};`}
          tabindex="0"
        >
          <div class="vs-consulting__card-media" data-progressive-host="relative">
            {index === 2 ? (
              <video
                class="vs-consulting__card-visual"
                data-vs-how-it-works-video
                muted
                playsinline
                preload="none"
                poster={livePerformancePoster.src}
                aria-hidden="true"
              >
                <source src={`${import.meta.env.BASE_URL}videos/video-streaming/how-it-works/live-performance.mp4`} type="video/mp4" />
              </video>
            ) : (
              <ProgressiveImage src={cardImages[index < 2 ? index : 2]}>
                <img
                  class="vs-consulting__card-visual"
                  src={cardImages[index < 2 ? index : 2].src}
                  alt=""
                  loading={index === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  aria-hidden="true"
                />
              </ProgressiveImage>
            )}
            <div class="vs-consulting__card-overlay" />
          </div>

          <div class="vs-consulting__card-content">
            <p class="vs-consulting__card-number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </p>
            <div class="vs-consulting__card-body">
              <h3 class="vs-consulting__card-title">{card.title}</h3>
              <p class="vs-consulting__card-copy">{card.copy}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-vs-how-it-works-video]');

  if (video && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const card = video.closest<HTMLElement>('.vs-consulting__card') ?? video;
    const playVideo = () => {
      if (video.ended) {
        video.currentTime = 0;
      }

      video.play().catch((error: unknown) => {
        console.error('Unable to play the video-streaming how-it-works video.', error);
      });
    };
    const pauseVideo = () => {
      video.pause();
      video.currentTime = 0;
    };

    card.addEventListener('mouseenter', playVideo);
    card.addEventListener('mouseleave', pauseVideo);
    card.addEventListener('focusin', playVideo);
    card.addEventListener('focusout', pauseVideo);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            playVideo();
          }
        },
        { threshold: 0.35 },
      );

      observer.observe(card);
      document.addEventListener('astro:before-swap', () => {
        observer.disconnect();
        card.removeEventListener('mouseenter', playVideo);
        card.removeEventListener('mouseleave', pauseVideo);
        card.removeEventListener('focusin', playVideo);
        card.removeEventListener('focusout', pauseVideo);
      }, { once: true });
    } else {
      playVideo();
    }
  }
</script>

<style>
  .vs-consulting {
    background: var(--bg);
    padding-top: var(--sp-10);
    padding-bottom: var(--sp-10);
  }

  .vs-consulting__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sp-8);
    align-items: start;
  }

  .vs-consulting__content-wrap {
    position: sticky;
    top: calc(var(--navbar-height) + var(--sp-8));
    align-self: start;
    display: grid;
    align-content: start;
    gap: var(--sp-4);
  }

  .vs-consulting__content {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
  }

  .vs-consulting__headline,
  .vs-consulting__copy {
    margin: 0;
  }

  .vs-consulting__headline {
    max-width: 23ch;
  }

  .vs-consulting__copy {
    max-width: 54ch;
  }

  .vs-consulting__feature-list {
    display: grid;
    gap: var(--sp-5);
    width: min(100%, 54ch);
    padding: 0;
    list-style: none;
  }

  .vs-consulting__feature {
    display: grid;
    grid-template-columns: var(--sp-8) minmax(0, 1fr);
    align-items: center;
    gap: var(--sp-3);
  }

  .vs-consulting__feature-content {
    display: grid;
    gap: var(--sp-1);
  }

  .vs-consulting__feature-title,
  .vs-consulting__feature-copy {
    margin: 0;
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .vs-consulting__feature-title {
    color: var(--text-primary);
    font-weight: 600;
  }

  .vs-consulting__feature-copy {
    color: var(--text-secondary);
  }

  .vs-consulting__feature-icon {
    display: grid;
    width: var(--sp-8);
    height: var(--sp-8);
    place-items: center;
    border: 1px solid var(--color-brand);
    border-radius: var(--radius);
    background: var(--icon-bg);
    color: var(--color-brand);
    font-size: 0.5rem;
    font-weight: 600;
    line-height: 1;
  }

  .vs-consulting__feature-icon :global(svg) {
    display: block;
    width: 3.5rem;
    height: 3.5rem;
  }

  @media (min-width: 1101px) {
    .vs-consulting__content-wrap {
      gap: var(--sp-8);
    }
  }

  .vs-consulting__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
    width: 100%;
    justify-self: stretch;
    align-self: start;
    --mingap: calc(var(--sp-10) * 2);
    gap: var(--mingap);
    /* padding-top: var(--sp-1); */
    /* padding-bottom: 45svh; */
  }

  .vs-consulting__card {
    position: sticky;
    top: calc(var(--navbar-height) + var(--sp-8));
    min-height: 0;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    z-index: var(--vs-card-z);
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .vs-consulting__card-media {
    position: relative;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--border-color);
    background: color-mix(in srgb, var(--surface) 88%, black 12%);
  }

  .vs-consulting__card-visual {
    position: relative;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: saturate(0.8);
  }

  .vs-consulting__card-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        transparent 10%,
        color-mix(in srgb, black 35%, transparent) 100%
      ),
      linear-gradient(
        110deg,
        color-mix(in srgb, var(--bg) 24%, transparent) 0%,
        transparent 100%
      );
    pointer-events: none;
  }

  .vs-consulting__card-content {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: 1fr;
    align-items: stretch;
    align-content: start;
    gap: var(--sp-6);
    padding: var(--sp-5);
    background: var(--surface);
  }

  .vs-consulting__card-number {
    align-self: start;
    margin: 0;
    font-family: var(--font-mono);
    color: var(--color-brand);
    font-size: clamp(1.3rem, 1.18rem + 0.65vw, 1.8rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.08em;
  }

  .vs-consulting__card-body {
    display: grid;
    grid-template-rows: minmax(2.4em, auto) minmax(0, 1fr);
    gap: var(--sp-2);
    min-width: 0;
  }

  .vs-consulting__card-title,
  .vs-consulting__card-copy {
    margin: 0;
  }

  .vs-consulting__card-title {
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.18rem + 0.65vw, 1.8rem);
    font-weight: var(--weight-display);
    line-height: 1.2;
    color: var(--text-primary);
  }

  .vs-consulting__card-copy {
    font-family: var(--font-body);
    /* color: color-mix(in srgb, var(--text-primary) 84%, var(--text-secondary) 16%); */
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  .vs-consulting__card:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--color-brand) 65%, white 35%);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .vs-consulting__card-visual {
      transition: none;
    }
  }

  @media (max-width: 1100px) {
    .vs-consulting {
      padding-top: var(--sp-8);
      padding-bottom: var(--sp-8);
    }

    .vs-consulting__inner {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .vs-consulting__content-wrap {
      position: static;
      top: auto;
      gap: var(--sp-6);
    }

    .vs-consulting__content {
      padding-bottom: 0;
    }

    .vs-consulting__headline,
    .vs-consulting__copy {
      max-width: none;
    }

    .vs-consulting__cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      justify-self: stretch;
      padding-top: var(--sp-2);
      gap: var(--sp-3);
    }

    .vs-consulting__card {
      position: static;
      top: auto;
    }

    .vs-consulting__feature-list {
      width: 100%;
    }

    .vs-consulting__card-content {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: 1fr;
      gap: var(--sp-3);
    }

    .vs-consulting__copy {
      max-width: none;
    }
  }

  @media (max-width: 620px) {
    .vs-consulting__inner {
      grid-template-columns: 1fr;
    }

    .vs-consulting__cards {
      grid-template-columns: 1fr;
    }
  }
</style>
