---
import neoslideDark from '../../assets/images/home/neoslide-dark.jpg';
import shelfLabelsDark from '../../assets/images/home/labels-dark.jpg';
import videoStreamingDark from '../../assets/images/home/video-dark.jpg';
import softwareDevelopmentDark from '../../assets/images/home/code-dark.jpg';
import ProgressiveImage from '../atoms/ProgressiveImage.astro';
import type { HomePageContent } from '../../i18n/pages/home';
import ArrowForwardIcon from '../icons/ArrowForwardIcon.astro';
import ArrowOutwardIcon from '../icons/ArrowOutwardIcon.astro';
import SectionTitleGroup from '../molecules/SectionTitleGroup.astro';

interface Props { content: HomePageContent['services']; }
const { content } = Astro.props;
const images = [neoslideDark, shelfLabelsDark, videoStreamingDark, softwareDevelopmentDark];
const splitTitle = (title: string) => {
  const words = title.trim().split(/\s+/);
  if (words.length < 2) return [title, ''];

  let splitIndex = 1;
  let smallestDifference = Number.POSITIVE_INFINITY;
  for (let index = 1; index < words.length; index += 1) {
    const firstLine = words.slice(0, index).join(' ');
    const secondLine = words.slice(index).join(' ');
    const difference = Math.abs(firstLine.length - secondLine.length);
    if (difference < smallestDifference) {
      splitIndex = index;
      smallestDifference = difference;
    }
  }

  return [words.slice(0, splitIndex).join(' '), words.slice(splitIndex).join(' ')];
};
const services = content.items.map((item, index) => ({
  ...item,
  image: images[index],
  titleLines: splitTitle(item.title),
}));
---

<section class="section services-section" id="services" aria-labelledby="services-heading">
  <div class="container u-section-title-stack">
    <SectionTitleGroup
      class="services-section__header"
      headlineClass="services-section__headline"
      copyClass="services-section__lead"
      label={content.label}
      heading={content.heading}
      headingId="services-heading"
      titleWidth="34%"
      copy={`${content.intro} ${content.copy}`}
    />

    <div class="services-grid" data-services-grid>
      {services.map((service, index) => (
        <article
          class={`services-card u-border-interactive ${index === 0 ? 'is-active' : ''}`}
          data-services-card
          data-card-index={index}
        >
          <div
            class="services-card__media"
            data-progressive-host
            aria-hidden="true"
          >
            <ProgressiveImage
              src={service.image}
              bounds="top: var(--preview-top); right: auto; bottom: auto; left: var(--preview-left); width: var(--preview-width); height: var(--preview-height); transform: var(--preview-transform);"
              fit="contain"
            >
              <img
                class="services-card__image"
                src={service.image.src}
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </ProgressiveImage>
            <div class="services-card__gradient"></div>
          </div>

          <span class="services-card__arrow" aria-hidden="true">
            <ArrowOutwardIcon />
          </span>

          <div class="services-card__content">
            <p class="services-card__counter">{service.counter}</p>
            <h3 class="services-card__title">
              <span>{service.titleLines[0]}</span>{' '}
              {service.titleLines[1] && <span>{service.titleLines[1]}</span>}
            </h3>

            <div class="services-card__details" aria-hidden={index === 0 ? 'false' : 'true'}>
              <div class="services-card__details-inner">
                <p class="services-card__description">{service.description}</p>
                <a class="services-card__cta" href={service.href}>
                  {content.learnMore}
                  <ArrowForwardIcon />
                </a>
              </div>
            </div>
          </div>

          <a class="services-card__hitarea" href={service.href} aria-label={`${content.openPrefix} ${service.title}`}></a>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const servicesGrid = document.querySelector('[data-services-grid]');

  if (servicesGrid) {
    const cards = Array.from(servicesGrid.querySelectorAll<HTMLElement>('[data-services-card]'));
    const narrowQuery = window.matchMedia('(max-width: 1080px)');

    const setActive = (nextCard: HTMLElement) => {
      cards.forEach((card) => {
        const isActive = card === nextCard;
        card.classList.toggle('is-active', isActive);

        const details = card.querySelector('.services-card__details');
        if (details) {
          details.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        }
      });
    };

    const openAll = () => {
      cards.forEach((card) => {
        card.classList.add('is-active');

        const details = card.querySelector('.services-card__details');
        if (details) {
          details.setAttribute('aria-hidden', 'false');
        }
      });
    };

    const syncForViewport = (matches: boolean) => {
      if (matches) {
        openAll();
      } else {
        setActive(cards[0]);
      }
    };

    syncForViewport(narrowQuery.matches);
    narrowQuery.addEventListener('change', (event) => syncForViewport(event.matches));

    cards.forEach((card) => {
      card.addEventListener('pointerenter', () => {
        if (narrowQuery.matches) return;
        setActive(card);
      });

      card.addEventListener('focusin', () => {
        if (narrowQuery.matches) return;
        setActive(card);
      });

      card.addEventListener('click', (event) => {
        if (narrowQuery.matches) return;

        const active = card.classList.contains('is-active');
        const target = event.target;
        const clickedLink = target instanceof Element && target.closest('a');

        if (!active) {
          event.preventDefault();
          setActive(card);
          return;
        }

        if (!clickedLink) {
          const hitarea = card.querySelector('.services-card__hitarea');
          if (hitarea instanceof HTMLAnchorElement) {
            hitarea.click();
          }
        }
      });
    });
  }
</script>

<style>
  .services-section {
    background: var(--bg);
    border-bottom: 1px solid var(--border-color);
  }

  :global(.services-section__headline) {
    max-width: 22ch;
    margin-bottom: var(--sp-4);
  }

  :global(.services-section__lead) {
    color: var(--text-secondary);
  }

  .services-grid {
    --card-height: clamp(26rem, 52vw, 34rem);
    --card-floor: 22%;
    --card-pad: var(--sp-5);
    --services-transition: 0.56s cubic-bezier(0.4, 0, 0.2, 1);

    display: flex;
    gap: var(--sp-2);
  }

  .services-card {
    --card-grow: 1;

    position: relative;
    isolation: isolate;
    min-height: var(--card-height);
    flex: var(--card-grow) 1 0%;
    border-radius: var(--radius-lg);
    background: var(--bg);
    overflow: clip;
    transition:
      flex-grow var(--services-transition),
      background var(--t-base);
  }

  .services-card.is-active {
    --card-grow: 3;
    background: var(--bg);
  }

  .services-card__arrow {
    position: absolute;
    top: var(--card-pad);
    right: var(--card-pad);
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1rem;
    /* height: 2.5rem; */
    color: var(--color-brand);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--t-base);
  }

  .services-card.is-active .services-card__arrow {
    opacity: 1;
  }

  .services-card__media {
    --preview-top: var(--card-pad);
    --preview-left: 0;
    --preview-width: 100%;
    --preview-height: 52%;
    --preview-transform: none;

    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }

  .services-card__image {
    --img-shift-x: 0;
    --img-scale: 1;

    position: absolute;
    left: 0;
    right: 0;
    top: var(--card-pad);
    bottom: auto;
    width: 100%;
    height: 52%;
    object-fit: contain;
    object-position: center top;
    opacity: 0.92;
    transform-origin: top center;
    transform: translateX(var(--img-shift-x)) scale(var(--img-scale));
    transition:
      transform var(--services-transition),
      left var(--services-transition),
      right var(--services-transition),
      width var(--services-transition),
      top var(--services-transition),
      bottom var(--services-transition),
      height var(--services-transition),
      opacity var(--t-base);
  }

  .services-card__gradient {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      transparent 30%,
      var(--bg) 60%,
      var(--bg) 100%
    );
  }

  .services-card__content {
    position: absolute;
    inset: 0;
    z-index: 3;
    padding: var(--card-pad);
    min-height: var(--card-floor);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--sp-2);
    transition: justify-content var(--services-transition);
  }

  .services-card__counter {
    font-family: var(--font-mono);
    color: var(--color-brand);
    font-size: clamp(2rem, 1.6vw + 1.4rem, 3rem);
    letter-spacing: 0.01em;
    line-height: 1;
    font-weight: var(--weight-semibold);
  }

  .services-card__title {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: var(--weight-display);
    line-height: 1.25;
    max-width: 22ch;
    color: var(--text-primary);
    transition: font-size var(--services-transition);
  }

  .services-card:not(.is-active) .services-card__title span {
    display: block;
  }

  .services-card__details {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--services-transition);
  }

  .services-card__details-inner {
    min-height: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    max-width: 56ch;
    padding-top: 0;
    transition: padding-top var(--services-transition);
  }

  .services-card__description {
    color: var(--text-secondary);
    line-height: 1.6;
    text-wrap: balance;
  }

  .services-card__cta {
    align-self: flex-start;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #fff;
    background: var(--color-brand);
    border: 1px solid var(--color-brand);
    border-radius: var(--radius);
    padding: var(--sp-2) var(--sp-4);
    white-space: nowrap;
    transition: background var(--t-base), border-color var(--t-base), color var(--t-base);
  }

  .services-card__cta:hover,
  .services-card__cta:focus-visible {
    background: var(--color-brand-dark);
    border-color: var(--color-brand-dark);
  }

  .services-card__cta :global(.cta-arrow-icon) {
    transition: transform var(--t-base);
  }

  .services-card__cta:hover :global(.cta-arrow-icon),
  .services-card__cta:focus-visible :global(.cta-arrow-icon) {
    transform: translateX(0.22rem);
  }

  .services-card__hitarea {
    position: absolute;
    inset: 0;
    z-index: 1;
    transform-origin: bottom;
    transform: scaleY(0);
    pointer-events: none;
    transition: transform var(--services-transition);
  }

  .services-card:not(.is-active) .services-card__details {
    visibility: hidden;
  }

  .services-card.is-active .services-card__details {
    grid-template-rows: 1fr;
    visibility: visible;
  }

  .services-card.is-active .services-card__details-inner {
    padding-top: var(--sp-3);
  }

  .services-card.is-active .services-card__title {
    font-size: var(--text-lg);
  }

  .services-card.is-active .services-card__hitarea {
    transform: scaleY(1);
    pointer-events: auto;
  }

  .services-card.is-active .services-card__image {
    --img-shift-x: -50%;

    left: 50%;
    right: auto;
    width: 58%;
    top: var(--card-pad);
    height: 60%;
  }

  .services-card.is-active .services-card__media {
    --preview-left: 50%;
    --preview-width: 58%;
    --preview-height: 60%;
    --preview-transform: translateX(-50%);
  }

  @media (max-width: 1080px) {
    .services-grid {
      flex-direction: column;
      flex-wrap: nowrap;
    }

    .services-card,
    .services-card.is-active {
      --card-grow: 1;
      display: flex;
      flex-direction: row;
      align-items: stretch;
      flex-basis: auto;
      min-height: 0;
    }

    .services-card__media,
    .services-card.is-active .services-card__media {
      position: relative;
      inset: auto;
      flex: 0 0 26%;
      aspect-ratio: 1 / 1;
      overflow: hidden;
      --preview-top: 50%;
      --preview-left: 50%;
      --preview-width: calc(100% - var(--card-pad));
      --preview-height: calc(100% - var(--card-pad));
      --preview-transform: translate(-50%, -50%);
    }

    .services-card__image,
    .services-card.is-active .services-card__image {
      position: absolute;
      inset: auto;
      top: 50%;
      left: 50%;
      right: auto;
      bottom: auto;
      transform: translate(-50%, -50%);
      width: calc(100% - var(--card-pad));
      height: calc(100% - var(--card-pad));
      max-height: none;
      object-position: center center;
    }

    .services-card__gradient {
      display: none;
    }

    .services-card__content {
      position: static;
      z-index: auto;
      flex: 1;
      justify-content: center;
    }

    .services-card__counter {
      font-size: clamp(1.25rem, 1vw + 1rem, 1.75rem);
    }

    .services-card__title,
    .services-card.is-active .services-card__title {
      font-size: var(--text-md);
    }

    .services-card__description {
      font-size: var(--text-sm);
    }

    .services-card__details,
    .services-card:not(.is-active) .services-card__details {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .services-card__details-inner,
    .services-card:not(.is-active) .services-card__details-inner {
      padding-top: var(--sp-3);
    }

    .services-card__hitarea {
      transform: none;
      pointer-events: auto;
    }

    .services-card.is-active {
      border-color: var(--border-color);
      box-shadow: none;
    }
  }

  @media (max-width: 640px) {
    .services-card,
    .services-card.is-active {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .services-card__media,
    .services-card.is-active .services-card__media {
      position: relative;
      inset: auto;
      flex: none;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      --preview-top: var(--card-pad);
      --preview-left: var(--card-pad);
      --preview-width: calc(100% - (var(--card-pad) * 2));
      --preview-height: calc(100% - (var(--card-pad) * 2));
      --preview-transform: none;
    }

    .services-card__image,
    .services-card.is-active .services-card__image {
      position: absolute;
      inset: auto;
      top: var(--card-pad);
      left: var(--card-pad);
      right: auto;
      bottom: auto;
      width: calc(100% - (var(--card-pad) * 2));
      height: calc(100% - (var(--card-pad) * 2));
      max-height: none;
      object-fit: contain;
      transform: none;
    }

    .services-card__gradient {
      display: block;
      position: absolute;
      inset: 0;
      background: linear-gradient(to bottom, transparent 75%, var(--bg) 100%);
    }

    .services-card__content {
      position: static;
      z-index: auto;
      flex: 1;
      justify-content: flex-start;
      padding-top: calc(var(--card-pad) * 0.4);
    }
  }

  @media (max-width: 200px) {
    .services-card__media,
    .services-card.is-active .services-card__media {
      aspect-ratio: auto;
      --preview-top: 0;
      --preview-left: 0;
      --preview-width: 100%;
      --preview-height: 100%;
    }

    .services-card__image,
    .services-card.is-active .services-card__image {
      position: static;
      inset: auto;
      top: auto;
      left: auto;
      width: 100%;
      height: auto;
      display: block;
    }
  }
</style>
