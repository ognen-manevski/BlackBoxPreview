---
interface Props {
  content: {
    ariaLabel: string;
    loadingLabel: string;
    errorLabel: string;
  };
}

const { content } = Astro.props;
import placeholderSvg from "../../../assets/vectors/illustrations/interactive/interactive-3d-placeholder.svg?raw";
---

<div
  class="interactive-display-viewer"
  data-interactive-display-viewer
>
  <canvas aria-label={content.ariaLabel} data-error-label={content.errorLabel} tabindex="0"></canvas>
  <div class="interactive-display-viewer__loading" data-model-loading>
    <div
      class="interactive-display-viewer__placeholder"
      aria-hidden="true"
      set:html={placeholderSvg}
    ></div>
    <p class="interactive-display-viewer__status" data-model-status aria-live="polite">
      {content.loadingLabel}
    </p>
  </div>
</div>

<script>
  import { mountInteractiveDisplayViewers } from "./interactive-display-model-viewer/lifecycle.ts";

  mountInteractiveDisplayViewers();
</script>

<style>
  .interactive-display-viewer {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 16rem;
    cursor: grab;
    touch-action: none;
  }

  @media (max-width: 1024px), (hover: none) and (pointer: coarse) {
    .interactive-display-viewer,
    .interactive-display-viewer canvas {
      touch-action: pan-y !important;
    }
  }

  .interactive-display-viewer:active {
    cursor: grabbing;
  }

  .interactive-display-viewer canvas {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
  }

  .interactive-display-viewer__loading {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template: 1fr / 1fr;
    place-items: center;
    pointer-events: none;
  }

  .interactive-display-viewer__placeholder,
  .interactive-display-viewer__status {
    grid-area: 1 / 1;
  }

  .interactive-display-viewer__placeholder {
    height: min(100%, 40rem);
    max-width: 100%;
    color: var(--color-brand);
  }

  .interactive-display-viewer__placeholder :global(svg) {
    display: block;
    width: auto;
    height: 100%;
    max-width: 100%;
  }

  .interactive-display-viewer canvas:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: -2px;
  }

  .interactive-display-viewer__status {
    z-index: 1;
    margin: 0;
    color: var(--text-secondary);
    text-align: center;
    pointer-events: none;
  }

  .interactive-display-viewer__loading[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .interactive-display-viewer {
      cursor: default;
    }
  }
</style>
