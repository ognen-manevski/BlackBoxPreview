---
import type { HomePageContent } from '../../i18n/pages/home';
interface Props { content: HomePageContent['faq']; }
const { content } = Astro.props;
---

<section class="section faq" id="faq" aria-labelledby="faq-heading">
  <div class="container faq__inner">
    <header class="faq__intro">
      <p class="section-label">{content.label}</p>
      <h2 class="section-headline faq__headline" id="faq-heading">
        {content.heading}
      </h2>
      <p class="section-copy faq__copy">
        {content.copy}
      </p>
    </header>

    <div class="faq__list" role="list" aria-label={content.listAriaLabel}>
      {content.items.map((item, index) => (
        <details class="faq-item u-border-interactive" open={index === 0}>
          <summary class="faq-item__summary">
            <span class="faq-item__question title">{item.question}</span>
            <svg class="faq-item__icon" width="8" height="5" viewBox="0 0 8 5" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M7.06 0L4 3.05333L0.94 0L0 0.94L4 4.94L8 0.94L7.06 0Z" fill="currentColor"/>
            </svg>
          </summary>

          <div class="faq-item__content-wrap">
            <div class="faq-item__content">
              <p>{item.answer}</p>
            </div>
          </div>
        </details>
      ))}
    </div>

    <aside class="faq__contact u-border-interactive" aria-label={content.contactAriaLabel}>
      <h3 class="faq__contact-title">{content.contactHeading}</h3>
      <p class="faq__contact-copy">
        {content.contactCopy}
      </p>
      <a class="faq__contact-link" href="/#contact">
        <span>{content.contactCta}</span>
        <span class="faq__contact-arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14" />
            <path d="m13 5 7 7-7 7" />
          </svg>
        </span>
      </a>
    </aside>
  </div>
</section>

<style>
  .faq {
    background: var(--bg);
  }

  .faq__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    grid-template-areas:
      'intro list'
      'contact list';
    gap: var(--sp-6) var(--sp-8);
    align-items: start;
  }

  .faq__intro {
    grid-area: intro;
    display: grid;
    gap: var(--sp-3);
    max-width: 34rem;
  }


  .faq__list {
    grid-area: list;
    display: grid;
    gap: var(--sp-3);
  }

  .faq-item {
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-secondary) 88%, var(--bg));
    overflow: clip;
  }

  .faq-item__summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-5);
    cursor: pointer;
  }

  .faq-item__summary::-webkit-details-marker {
    display: none;
  }

  .faq-item__question {
    line-height: 1.5;
    font-weight: var(--weight-display);
  }

  .faq-item__icon {
    width: 0.8rem;
    height: 0.5rem;
    flex-shrink: 0;
    color: var(--text-secondary);
    transition: transform 0.22s ease;
  }

  .faq-item[open] .faq-item__icon {
    transform: rotate(180deg);
  }

  .faq-item__content-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.28s ease;
  }

  .faq-item[open] .faq-item__content-wrap {
    grid-template-rows: 1fr;
  }

  .faq-item__content {
    min-height: 0;
    overflow: hidden;
  }

  .faq-item__content p {
    margin: 0;
    padding: 0 var(--sp-5) var(--sp-5);
    border-top: 1px solid var(--border-color);
    padding-top: var(--sp-4);
    color: var(--text-secondary);
    line-height: 1.7;
    opacity: 0;
    transform: translateY(-0.35rem);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  .faq-item[open] .faq-item__content p {
    opacity: 1;
    transform: translateY(0);
  }

  @supports selector(::details-content) {
    .faq-item__content-wrap {
      display: block;
      transition: none;
    }

    .faq-item::details-content {
      block-size: 0;
      overflow: hidden;
      transition:
        block-size 0.28s ease,
        content-visibility 0.28s allow-discrete;
    }

    .faq-item[open]::details-content {
      block-size: auto;
    }
  }

  .faq__contact {
    grid-area: contact;
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-5);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-secondary) 90%, var(--bg));
    max-width: 42rem;
    align-self: end;
  }

  .faq__contact-title {
    line-height: 1.1;
  }

  .faq__contact-copy {
    color: var(--text-secondary);
    max-width: 44ch;
  }

  .faq__contact-link {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    width: fit-content;
    text-decoration: none;
    color: var(--text-secondary);
  }

  .faq__contact-arrow {
    width: 2rem;
    height: 2rem;
    display: grid;
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--color-brand);
    color: white;
    transition: transform 0.18s ease, background 0.18s ease;
  }

  .faq__contact-arrow svg {
    width: 1rem;
    height: 1rem;
    display: block;
  }

  .faq__contact-link:is(:hover, :focus-visible) {
    color: var(--text-primary);
  }

  .faq__contact-link:is(:hover, :focus-visible) .faq__contact-arrow {
    transform: translateX(0.2rem);
    background: var(--color-brand-dark);
  }

  @media (max-width: 900px) {
    .faq__inner {
      grid-template-columns: 1fr;
      grid-template-areas:
        'intro'
        'list'
        'contact';
      gap: var(--sp-5);
    }

    .faq__intro,
    .faq__contact {
      max-width: none;
    }

    .faq__headline,
    .faq__copy {
      max-width: none;
    }
  }

  @media (max-width: 600px) {
    .faq-item__summary,
    .faq-item__content p,
    .faq__contact {
      padding-left: var(--sp-4);
      padding-right: var(--sp-4);
    }

    .faq-item__summary {
      align-items: flex-start;
    }

    .faq-item__content p {
      padding-bottom: var(--sp-4);
      padding-top: var(--sp-4);
    }

    .faq__contact-link {
      font-size: var(--text-base);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item__content-wrap,
    .faq-item__content p,
    .faq-item__icon,
    .faq__contact-arrow,
    .faq-item::details-content {
      transition: none;
    }
  }
</style>
