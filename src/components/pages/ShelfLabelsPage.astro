---
import BaseLayout from '../../layouts/BaseLayout.astro'; import ShelfLabelsHeroSection from '../sections/ShelfLabelsHeroSection.astro'; import ShelfLabelsHowItWorksSection from '../sections/ShelfLabelsHowItWorksSection.astro'; import ShelfLabelsPerformanceSection from '../sections/ShelfLabelsPerformanceSection.astro'; import ShelfLabelsScrollFeaturesSection from '../sections/ShelfLabelsScrollFeaturesSection.astro'; import ShelfLabelsProductOverviewSection from '../sections/ShelfLabelsProductOverviewSection.astro'; import ShelfLabelsHardwareDetailsSection from '../sections/ShelfLabelsHardwareDetailsSection.astro'; import BookDemoSection from '../sections/BookDemoSection.astro'; import {shelfLabelsContent} from '../../i18n/pages/shelf-labels'; import {getTranslations} from '../../i18n/utils'; import type{Lang}from'../../i18n/types'; interface Props{lang:Lang} const{lang}=Astro.props; const c=getTranslations(shelfLabelsContent,lang);
---
<BaseLayout lang={lang} title={c.seo.title} description={c.seo.description}><ShelfLabelsHeroSection content={c.hero}/><ShelfLabelsHowItWorksSection content={c.howItWorks}/><ShelfLabelsPerformanceSection content={c.performance}/><ShelfLabelsProductOverviewSection content={c.overview} viewerContent={c.viewer}/><ShelfLabelsHardwareDetailsSection content={c.hardware}/><ShelfLabelsScrollFeaturesSection content={c.features}/><BookDemoSection lang={lang} defaultService={c.demoService}/></BaseLayout>
