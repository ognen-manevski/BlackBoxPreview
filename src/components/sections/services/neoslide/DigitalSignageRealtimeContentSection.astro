---
import { Image } from 'astro:assets';
import ProgressiveImage from '../../../atoms/ProgressiveImage.astro';
import realtimeContentImage from '../../../../assets/images/services/neoslide/real-time content/weather.png';
import { getImageOutputWidth, getResponsiveImageWidths } from '../../../../utils/images';
import type { DigitalSignageContent } from '../../../../i18n/pages/services/neoslide.ts';
interface Props { content: DigitalSignageContent['realtime'] } const { content } = Astro.props;
---

<section class="ds-realtime" aria-label={content.ariaLabel}>
    <div class="container ds-realtime__container">
        <div class="ds-realtime__content">
            <div class="ds-realtime__text">
                <p class="ds-realtime__eyebrow section-label">{content.label}</p>
                <h2 class="ds-realtime__title section-headline">
                    {content.heading}
                </h2>
                <p class="ds-realtime__copy section-copy">
                    {content.copy}
                </p>
            </div>

            <div class="ds-realtime__media" data-progressive-host="relative">
                <ProgressiveImage src={realtimeContentImage} fit="contain">
                    <Image
                        class="ds-realtime__image"
                        src={realtimeContentImage}
                        alt={content.imageAlt}
                        widths={getResponsiveImageWidths(realtimeContentImage)}
                        width={getImageOutputWidth(realtimeContentImage)}
                        sizes="auto, (min-width: 64rem) 45vw, 100vw"
                        format="webp"
                        loading="lazy"
                        decoding="async"
                    />
                </ProgressiveImage>
            </div>
        </div>
    </div>
</section>

<style>
    .ds-realtime {
        background: var(--bg-secondary);
        border-bottom: 1px solid var(--border-color);
    }

    .ds-realtime__container {
        padding-block: var(--sp-10);
    }

    .ds-realtime__content {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: var(--sp-8);
        align-items: center;
    }

    .ds-realtime__text {
        display: grid;
        gap: var(--sp-3);
        max-width: 38rem;
    }

    .ds-realtime__eyebrow,
    .ds-realtime__title,
    .ds-realtime__copy {
        margin: 0;
    }

    .ds-realtime__media {
        width: 100%;
    }

    .ds-realtime__image {
        width: 100%;
        height: auto;
        display: block;
    }

    @media (max-width: 900px) {
        .ds-realtime__content {
            grid-template-columns: 1fr;
            gap: var(--sp-6);
        }

        .ds-realtime__text {
            max-width: none;
        }
    }

    @media (max-width: 600px) {
        .ds-realtime__content {
            gap: var(--sp-7);
        }
    }
</style>
