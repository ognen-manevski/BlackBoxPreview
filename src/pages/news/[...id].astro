---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
export async function getStaticPaths() {
  const posts = await getCollection('news', ({ data }) => !data.draft && data.lang === 'en');
  return posts.map((post) => ({ params: { id: post.id.split('/')[0] }, props: { post } }));
}
interface Props { post: CollectionEntry<'news'> }
const { post } = Astro.props;
const { Content } = await render(post);
---
<BlogPostLayout post={post}><Content /></BlogPostLayout>
