---
import missionIcon from '../../assets/vectors/icons/mission-vision/mission-icon.svg?raw';
import visionIcon from '../../assets/vectors/icons/mission-vision/vision-icon.svg?raw';
import AboutPrinciples from '../molecules/AboutPrinciples.astro';
import ClientLogoCarousel from '../molecules/ClientLogoCarousel.astro';
import IconBadge from '../atoms/IconBadge.astro';
import { clientLogos } from '../../data/clientLogos';
import logoDarkPoster from '../../assets/images/video-thumbnails/bg-videos/3D-Logo.jpg';
import type { HomePageContent } from '../../i18n/pages/home';

const missionIconMarkup = missionIcon as unknown as string;
const visionIconMarkup = visionIcon as unknown as string;

interface Props { content: HomePageContent['about']; }
const { content } = Astro.props;
---

<section class="section about" id="about" aria-labelledby="about-heading">
  <div class="container about__inner">
    <div class="about__grid">
      <div class="about__content">
        <p class="section-label">{content.label}</p>
        <h2 class="section-headline about__headline" id="about-heading">
          {content.heading}
        </h2>
        <p class="section-copy about__lead">
          {content.copy}
        </p>

        <div class="about__cards" aria-label={content.cardsAriaLabel}>
          <article class="mk-card about-card">
            <IconBadge
              class="about-card__icon"
              aria-hidden="true"
              style="--icon-badge-size: 2.5rem; --icon-badge-border: var(--color-brand); --icon-badge-bg: var(--color-brand-bg); --icon-badge-color: var(--color-brand); margin-bottom: var(--sp-1);"
            >
              <span class="about-card__svg" set:html={missionIconMarkup}></span>
            </IconBadge>
            <h3 class="about-card__title">{content.missionTitle}</h3>
            <p class="about-card__text">
              {content.missionCopy}
            </p>
          </article>

          <article class="mk-card about-card">
            <IconBadge
              class="about-card__icon"
              aria-hidden="true"
              style="--icon-badge-size: 2.5rem; --icon-badge-border: var(--color-brand); --icon-badge-bg: var(--color-brand-bg); --icon-badge-color: var(--color-brand); margin-bottom: var(--sp-1);"
            >
              <span class="about-card__svg" set:html={visionIconMarkup}></span>
            </IconBadge>
            <h3 class="about-card__title">{content.visionTitle}</h3>
            <p class="about-card__text">
              {content.visionCopy}
            </p>
          </article>
        </div>
      </div>

      <div class="about__media">
        <video
          class="about__video"
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster={logoDarkPoster.src}
          aria-label={content.videoAriaLabel}
        >
          <source src={`${import.meta.env.BASE_URL}videos/bg-videos/3D-Logo.mp4`} type="video/mp4" />
        </video>
      </div>
    </div>

    <ClientLogoCarousel items={clientLogos} ariaLabel={content.logosAriaLabel} />

    <AboutPrinciples
      principles={content.principles}
      ariaLabel={content.principlesAriaLabel}
    />
  </div>
</section>

<style>
  .about {
    background: var(--bg);
  }

  .about__inner {
    display: grid;
    gap: var(--sp-6);
  }

  .about__inner :global(.logo-carousel) {
    margin-top: calc(var(--sp-2) - 2.5rem);
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: var(--sp-6);
    align-items: start;
  }

  .about__content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .about__headline {
    max-width: 24ch;
    text-wrap: balance;
  }

  .about__lead {
    max-width: none;
    text-wrap: pretty;
  }

  .about__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-4);
  }

  .about-card {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--sp-5);
    background: var(--surface, var(--bg-secondary));
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    min-height: 100%;
  }

  .about-card__svg {
    width: 1.35rem;
    height: 1.35rem;
    display: block;
  }

  .about-card__svg :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .about-card__title {
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .about-card__text {
    color: var(--text-secondary);
    line-height: 1.65;
  }

  .about__media {
    position: relative;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: linear-gradient(180deg, color-mix(in srgb, var(--bg-secondary) 80%, var(--bg)) 0%, var(--bg) 100%);
    min-height: 0;
    align-self: stretch;
    height: 100%;
  }

  .about__video {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: cover;
    object-position: center;
    margin: 0 auto;
    position: relative;
  }

  @media (max-width: 1100px) {
    .about__grid {
      grid-template-columns: 1fr;
    }

    .about__video {
      max-height: 24rem;
    }

  }

  @media (max-width: 600px) {
    .about__cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .about__video {
      min-height: 20rem;
    }
  }
</style>
