---
import CaseStudyCard from '../molecules/CaseStudyCard.astro';
import ContentGrid from '../molecules/ContentGrid.astro';
import SectionGradientBackground from '../atoms/SectionGradientBackground.astro';
import ArrowButton from '../atoms/ArrowButton.astro';
import { getCollection } from 'astro:content';
import waveDarkPoster from '../../assets/images/video-thumbnails/bg-videos/wave.jpg';
import type { HomePageContent } from '../../i18n/pages/home';
import type { Lang } from '../../i18n/types';

interface Props { content: HomePageContent['caseStudies']; lang: Lang }
const { content, lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
  .slice(0, 4)
  .map((post, index) => {
    const slug = post.id.split('/')[0];
    return {
      number: String(index + 1).padStart(2, '0'),
      title: post.data.title,
      excerpt: post.data.description,
      href: `${base}${lang === 'mk' ? 'mk/' : ''}use-cases/${slug}/`,
      thumbnailSrc: post.data.cover,
      thumbnailAlt: post.data.coverAlt,
      ctaLabel: content.readMore,
    };
  });

const caseStudyGridCells = posts.map((post) => ({
  component: CaseStudyCard,
  props: post,
  ariaLabel: post.title,
  className: 'case-studies__grid-cell u-border-interactive',
}));
---

<!-- video needs edits, slower + loop glitch -->

<section class="section case-studies" id="case-studies" aria-labelledby="case-studies-heading">
  <SectionGradientBackground
    videoSrc={`${import.meta.env.BASE_URL}videos/bg-videos/wave.mp4`}
    posterSrc={waveDarkPoster}
    overlayColor="var(--video-overlay)"
    videoBlur="1px"
  />

  <div class="container">
    <p class="section-label">{content.label}</p>
    <div class="case-studies__layout">
      <header class="case-studies__header section__header">
        <div class="case-studies__heading-group">
          <h2 class="section-headline" id="case-studies-heading">
            {content.heading}
          </h2>
          <p class="section-copy">{content.copy}</p>
        </div>
      </header>

      <div class="case-studies__actions">
        <p class="case-studies__explore-copy section-copy">{content.exploreCopy}</p>
        <ArrowButton class="case-studies__view-all" href={`${base}${lang === 'mk' ? 'mk/' : ''}use-cases/`} variant="primary">
          {content.viewAll}
        </ArrowButton>
      </div>

      <div class="case-studies__cards">
        <ContentGrid
          cellContent={caseStudyGridCells}
          cellCount={4}
          columns={2}
          ariaLabel={content.gridAriaLabel}
          surfaceClass="case-studies__cards-surface"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .case-studies {
    position: relative;
    isolation: isolate;
    background: var(--bg);
    overflow: hidden;
  }


  .case-studies .container {
    position: relative;
    z-index: 1;
  }

  .case-studies__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas:
      "title more"
      "cards cards";
    gap: var(--sp-7);
  }

  .case-studies__header {
    grid-area: title;
    margin: 0;
  }

  .case-studies__heading-group .section-copy{
    max-width: 65ch;
  }

  .case-studies__heading-group {
    display: grid;
    justify-items: start;
    gap: var(--sp-4);
  }

  .case-studies__explore-copy {
    max-width: 65ch;
  }

  .case-studies__actions {
    grid-area: more;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--border-color);
    background: var(--surface);
    padding: var(--sp-5);
    gap: var(--sp-5);
    border-radius: var(--radius-lg);
    /* height: 100%; */
  }

  .case-studies__cards {
    grid-area: cards;
  }

  :global(.case-studies .case-studies__cards-surface) {
    padding: 1px;
    background: var(--border-color);
  }

  :global(.case-studies .grid-frame) {
    background: var(--bg-secondary);
  }

  .case-studies :global(.content-grid) {
    gap: 1px;
    border: 0;
    background: var(--border-color);
  }

  .case-studies :global(.content-grid__cell) {
    border: 0;
    background: var(--bg-secondary);
  }

  :global(.case-studies .u-border-interactive) {
    border: 0;
    box-shadow: none;
  }

  .case-studies__view-all {
    flex: 0 0 auto;
    width: fit-content;
  }

  .case-studies__explore-copy {
    flex: 1 1 16rem;
    min-width: 0;
  }

  /* :global(.case-studies .content-grid__cell) {
    align-items: stretch;
    justify-items: stretch;
  }

  :global(.case-studies .case-studies__grid-cell) {
    display: block;
    padding: 0;
  } */

  @media (max-width: 768px) {
    .case-studies__layout {
      grid-template-columns: 1fr;
      grid-template-areas:
        "title"
        "cards"
        "more";
      gap: var(--sp-6);
    }

    .case-studies :global(.content-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 700px) {
    .case-studies :global(.content-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .case-studies :global(.content-grid__cell) {
      min-height: auto;
    }
  }

  @media (max-width: 360px) {
    .case-studies :global(.content-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
