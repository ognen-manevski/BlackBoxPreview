---
interface Props {
    name: string;
    src: string;
    href?: string;
    tooltip?: string;
    loading?: "eager" | "lazy";
}

const { name, src, href, tooltip = name, loading = "lazy" } = Astro.props as Props;
const tooltipId = `client-logo-tooltip-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
const isExternal = href?.startsWith('http');
---

{
    href ? (
        <a
            class="client-logo"
            href={href}
            aria-label={name}
            aria-describedby={tooltipId}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noreferrer noopener' : undefined}
        >
            <span class="client-logo__backdrop" aria-hidden="true"></span>
            <span
                class="client-logo__mono"
                style={`--logo-url: url('${src}')`}
                aria-hidden="true"></span>
            <img
                class="client-logo__image client-logo__image--color"
                src={src}
                alt=""
                loading={loading}
                decoding="async"
            />
            <span class="client-logo__tooltip" id={tooltipId} role="tooltip">{tooltip}</span>
        </a>
    ) : (
        <div class="client-logo" tabindex="0" aria-label={name} aria-describedby={tooltipId}>
            <span class="client-logo__backdrop" aria-hidden="true"></span>
            <span
                class="client-logo__mono"
                style={`--logo-url: url('${src}')`}
                aria-hidden="true"></span>
            <img
                class="client-logo__image client-logo__image--color"
                src={src}
                alt={name}
                loading={loading}
                decoding="async"
            />
            <span class="client-logo__tooltip" id={tooltipId} role="tooltip">{tooltip}</span>
        </div>
    )
}

<style>
    .client-logo {
        position: relative;
        display: grid;
        place-items: center;
        overflow: hidden;
        isolation: isolate;
        width: 100%;
        height: 100%;
        min-height: inherit;
        border: 0;
        background: transparent;
        color: var(--text-primary);
        text-decoration: none;
        --transition: opacity 0ms,
            transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
        transition: var(--transition);
    }

    .client-logo:is(a) {
        cursor: pointer;
    }

    .client-logo__tooltip {
        position: absolute;
        left: 50%;
        bottom: var(--sp-2);
        translate: -50% 0;
        z-index: 3;
        min-width: max-content;
        max-width: calc(100% - var(--sp-4));
        padding: var(--sp-2) var(--sp-3);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        background: var(--bg);
        color: var(--text-primary);
        font-size: var(--text-sm);
        /* line-height: 1.2; */
        text-align: center;
        /* backdrop-filter: blur(8px); */
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(0.25rem);
        transition:
            opacity 0.16s ease,
            visibility 0.16s ease,
            transform 0.16s ease;
    }

    .client-logo__backdrop {
        position: absolute;
        inset: 0;
        z-index: 0;
        border-radius: 0;
        background: rgb(from var(--text-muted) r g b / 0.08);
        opacity: 0;
        transition: var(--transition);
    }

    .client-logo__mono {
        position: absolute;
        z-index: 1;
        width: 100%;
        aspect-ratio: 3 / 1;
        background: var(--text-primary);
        mask: var(--logo-url) center / contain no-repeat;
        -webkit-mask: var(--logo-url) center / contain no-repeat;
        transition: var(--transition);
    }

    .client-logo__image {
        position: absolute;
        z-index: 2;
        width: 100%;
        aspect-ratio: 3 / 1;
        height: auto;
        object-fit: contain;
        transition: var(--transition);
    }

    .client-logo__image--color {
        opacity: 0;
    }

    .client-logo:is(:hover, :focus-visible) .client-logo__backdrop {
        opacity: 1;
    }

    .client-logo:is(:hover, :focus-visible) .client-logo__mono {
        opacity: 0;
        transform: scale(1.1);
    }

    .client-logo:is(:hover, :focus-visible) .client-logo__image--color {
        opacity: 1;
        transform: scale(1.1);
    }

    .client-logo:is(:hover, :focus-visible) .client-logo__tooltip {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }
</style>
