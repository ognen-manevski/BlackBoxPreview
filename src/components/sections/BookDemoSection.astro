---
import IconBadge from '../atoms/IconBadge.astro';
import ArrowButton from '../atoms/ArrowButton.astro';
import{demoContent}from'../../i18n/pages/demo';import{getTranslations}from'../../i18n/utils';import type{Lang}from'../../i18n/types';

interface ServiceOption {
  label: string;
  value: string;
}

interface Props {
  defaultService?: string;
  serviceOptions?: ServiceOption[];
  lang: Lang;
}

const {
  lang,
  defaultService = '',
  serviceOptions,
} = Astro.props as Props;
const content=getTranslations(demoContent,lang).compact;
const localizedOptions=serviceOptions??content.services;

const normalizedDefaultService = defaultService.trim().toLowerCase();
const options = localizedOptions.map(option => ({
  ...option,
  checked: Boolean(normalizedDefaultService) && option.value.trim().toLowerCase() === normalizedDefaultService,
}));
---

<section
  class="section book-demo"
  id="book-demo"
  aria-labelledby="book-demo-heading"
  data-book-demo
  data-default-service={defaultService}
>
  <video
    class="book-demo__bg-video"
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    aria-hidden="true"
  >
    <source src="/videos/gradients/dark/base-gradient-1.mp4" type="video/mp4" />
  </video>
  <div class="book-demo__bg-overlay" aria-hidden="true"></div>

  <div class="container book-demo__inner">
    <div class="book-demo__content">
      <p class="section-label">{content.label}</p>
      <h2 class="section-headline book-demo__headline" id="book-demo-heading">
        {content.heading}
      </h2>
      <p class="section-copy book-demo__copy">
        {content.copy}<br>{content.copySecondLine}
      </p>

      <ul class="book-demo__benefits" aria-label={content.benefitsAriaLabel}>
        <li class="book-demo__benefit-item">
          <IconBadge
            class="book-demo__benefit-icon"
            style="--icon-badge-size: 1.5rem; --icon-badge-border: var(--border-color); --icon-badge-bg: color-mix(in srgb, var(--bg-secondary) 75%, var(--bg)); --icon-badge-color: var(--color-brand);"
          >
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 8.3 6.5 11.3 12.5 5.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </IconBadge>
          <span>{content.benefits[0]}</span>
        </li>
        <li class="book-demo__benefit-item">
          <IconBadge
            class="book-demo__benefit-icon"
            style="--icon-badge-size: 1.5rem; --icon-badge-border: var(--border-color); --icon-badge-bg: color-mix(in srgb, var(--bg-secondary) 75%, var(--bg)); --icon-badge-color: var(--color-brand);"
          >
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 8.3 6.5 11.3 12.5 5.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </IconBadge>
          <span>{content.benefits[1]}</span>
        </li>
        <li class="book-demo__benefit-item">
          <IconBadge
            class="book-demo__benefit-icon"
            style="--icon-badge-size: 1.5rem; --icon-badge-border: var(--border-color); --icon-badge-bg: color-mix(in srgb, var(--bg-secondary) 75%, var(--bg)); --icon-badge-color: var(--color-brand);"
          >
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3.5 8.3 6.5 11.3 12.5 5.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </IconBadge>
          <span>{content.benefits[2]}</span>
        </li>
      </ul>
    </div>

    <div class="book-demo__form-wrap u-border-interactive">
      <h3 class="book-demo__form-title">
        {content.formTitleStart}<span class="book-demo__service-name" data-demo-service>{defaultService}</span>{content.formTitleEnd}
      </h3>

      <form class="book-demo__form" action="#" method="post">
        <label class="book-demo__field">
          <span>{content.name}</span>
          <input type="text" name="name" placeholder={content.namePlaceholder} autocomplete="name" required>
        </label>

        <label class="book-demo__field">
          <span>{content.email}</span>
          <input type="email" name="email" placeholder={content.emailPlaceholder} autocomplete="email" required>
        </label>

        <details class="book-demo__customize u-border-interactive">
          <summary class="book-demo__customize-summary">
            <span>{content.customize}</span>
            <svg class="book-demo__customize-icon" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>

          <div class="book-demo__customize-content">
            <label class="book-demo__field">
              <span>{content.phone}</span>
              <input type="tel" name="phone" placeholder={content.phonePlaceholder} autocomplete="tel">
            </label>

            <fieldset class="book-demo__services">
              <legend>{content.serviceLegend}</legend>
              <div class="book-demo__service-options">
                {
                  options.map(option => (
                    <label class="book-demo__service-option u-border-interactive">
                      <input
                        type="checkbox"
                        name="services"
                        value={option.value}
                        checked={option.checked}
                      >
                      <span class="book-demo__check" aria-hidden="true">
                        <svg viewBox="0 0 16 16" fill="none">
                          <path d="M3.5 8.3 6.5 11.3 12.5 5.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                      </span>
                      <span>{option.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <label class="book-demo__field">
              <span>{content.message}</span>
              <textarea
                name="message"
                placeholder={content.messagePlaceholder}
                rows="5"
              ></textarea>
            </label>
          </div>
        </details>

        <div class="book-demo__actions">
          <ArrowButton type="submit" variant="primary">{content.submit}</ArrowButton>
          <button class="btn btn--outline" type="reset">{content.reset}</button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  const demoSections = document.querySelectorAll('[data-book-demo]');

  demoSections.forEach(section => {
    const serviceSlot = section.querySelector('[data-demo-service]');
    const checkboxes = Array.from(section.querySelectorAll('input[name="services"]'));
    const defaultService = section.getAttribute('data-default-service') || '';

    const updateTitle = () => {
      const selected = checkboxes.find(input => input.matches(':checked'));
      const serviceName = selected ? selected.getAttribute('value') || '' : defaultService;

      if (serviceSlot) {
        serviceSlot.textContent = serviceName;
      }
    };

    checkboxes.forEach(input => {
      input.addEventListener('change', updateTitle);
    });

    updateTitle();
  });
</script>

<style>
  .book-demo {
    position: relative;
    overflow: hidden;
    background: var(--bg);
  }

  .book-demo__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .book-demo__bg-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--bg) 70%, transparent) 0%, color-mix(in srgb, var(--bg) 24%, transparent) 70%, color-mix(in srgb, var(--bg) 35%, transparent) 100%);
    z-index: 1;
  }

  .book-demo__inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: var(--sp-8);
    align-items: start;
  }

  .book-demo__content {
    display: grid;
    gap: var(--sp-4);
    max-width: 44rem;
  }

  .book-demo__headline {
    max-width: 16ch;
  }

  .book-demo__copy {
    max-width: 62ch;
  }

  .book-demo__benefits {
    margin: var(--sp-4) 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--sp-3);
  }

  .book-demo__benefit-item {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    color: var(--text-primary);
    font-size: var(--text-base);
  }

  .book-demo__benefit-icon {
    flex-shrink: 0;
  }

  .book-demo__form-wrap {
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    padding: var(--sp-6);
    display: grid;
    gap: var(--sp-5);
  }

  .book-demo__form-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .book-demo__service-name {
    color: var(--color-brand);
  }

  .book-demo__form {
    display: grid;
    gap: var(--sp-4);
  }

  .book-demo__field {
    display: grid;
    gap: var(--sp-2);
  }

  .book-demo__field > span,
  .book-demo__services legend {
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .book-demo__field :is(input, textarea) {
    width: 100%;
    border: 1px solid var(--border-color);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-secondary) 82%, var(--bg));
    color: var(--text-primary);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: 1.5;
    padding: var(--sp-3) var(--sp-4);
    transition: border-color var(--t-fast), background var(--t-fast);
  }

  .book-demo__field textarea {
    resize: vertical;
    min-height: 6rem;
  }

  .book-demo__field :is(input, textarea)::placeholder {
    color: var(--text-muted);
  }

  .book-demo__field :is(input, textarea):is(:focus, :focus-visible) {
    border-color: var(--color-brand);
    outline: none;
  }

  .book-demo__customize {
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-secondary) 88%, var(--bg));
    overflow: hidden;
  }

  .book-demo__customize-summary {
    list-style: none;
    display: inline-flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--text-primary);
    user-select: none;
  }

  .book-demo__customize-summary::-webkit-details-marker {
    display: none;
  }

  .book-demo__customize-icon {
    width: 0.7rem;
    height: 0.45rem;
    color: var(--text-secondary);
    transition: transform var(--t-base);
    flex-shrink: 0;
  }

  .book-demo__customize[open] .book-demo__customize-icon {
    transform: rotate(180deg);
  }

  .book-demo__customize-content {
    border-top: 1px solid var(--border-color);
    padding: var(--sp-4);
    display: grid;
    gap: var(--sp-4);
  }

  .book-demo__services {
    margin: 0;
    padding: 0;
    border: 0;
    display: grid;
    gap: var(--sp-3);
  }

  .book-demo__service-options {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-2);
  }

  .book-demo__service-option {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-secondary) 82%, var(--bg));
    padding: var(--sp-2) var(--sp-3);
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .book-demo__service-option input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .book-demo__check {
    width: 1.2rem;
    height: 1.2rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    color: transparent;
    background: color-mix(in srgb, var(--bg-secondary) 70%, var(--bg));
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color var(--t-fast), background var(--t-fast), color var(--t-fast);
    flex-shrink: 0;
  }

  .book-demo__check svg {
    width: 0.8rem;
    height: 0.8rem;
  }

  .book-demo__service-option input:checked + .book-demo__check {
    color: var(--color-brand);
    border-color: var(--color-brand);
    background: var(--color-brand-bg);
  }

  .book-demo__service-option input:focus-visible + .book-demo__check {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .book-demo__service-option input:checked ~ span:last-child {
    color: var(--text-primary);
  }

  .book-demo__actions {
    display: flex;
    flex-wrap: wrap;
    margin-top: var(--sp-3);
    gap: var(--sp-3);
  }

  @media (max-width: 1024px) {
    .book-demo__inner {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .book-demo__headline {
      max-width: 20ch;
    }
  }

  @media (max-width: 640px) {
    .book-demo__form-wrap {
      padding: var(--sp-5);
    }

    .book-demo__actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .book-demo__actions .btn {
      justify-content: center;
    }

    .book-demo__service-options {
      grid-template-columns: 1fr;
    }
  }
</style>
