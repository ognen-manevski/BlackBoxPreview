---
import DsCard from '../../../atoms/DsCard.astro';
import ArrowButton from '../../../atoms/ArrowButton.astro';
import streamingDeliveryIcon from '../../../../assets/vectors/icons/video-streaming/video-streaming-development-icons/streaming-delivery.svg?raw';
import systemIntegrationsIcon from '../../../../assets/vectors/icons/video-streaming/video-streaming-development-icons/system-integrations.svg?raw';
import platformPlanningIcon from '../../../../assets/vectors/icons/video-streaming/video-streaming-development-icons/platform-planning.svg?raw';
import type { VideoStreamingContent } from '../../../../i18n/pages/services/video-streaming.ts';

interface Props {
  content: VideoStreamingContent['customDevelopment'];
}

const { content } = Astro.props;
const prepareIcon = (icon: string) => icon
  .replace(/^<\?xml[^>]*>\s*/, '')
  .replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
const cardIcons = [
  platformPlanningIcon,
  systemIntegrationsIcon,
  streamingDeliveryIcon,
].map(prepareIcon);
---

<section class="section vs-custom-development" aria-labelledby="vs-custom-development-heading">
  <div class="container vs-custom-development__container">
    <div class="vs-custom-development__left">
      <div class="vs-custom-development__content">
        <p class="section-label">{content.label}</p>
        <h2 class="section-headline vs-custom-development__heading" id="vs-custom-development-heading">
          {content.heading}
        </h2>
        <p class="section-copy vs-custom-development__copy">{content.copy}</p>
      </div>

      <article class="vs-custom-development__cta-card vs-custom-development__cta-card--desktop u-border-interactive">
        <div class="vs-custom-development__cta-content">
          <h3 class="vs-custom-development__cta-heading">{content.cta.heading}</h3>
          <p class="vs-custom-development__cta-copy">{content.cta.copy}</p>
          <ArrowButton
            class="vs-custom-development__cta-button"
            href="#book-demo"
            variant="primary"
          >
            {content.cta.label}
          </ArrowButton>
        </div>
      </article>
    </div>

    <ul class="vs-custom-development__cards" aria-label={content.ariaLabel}>
      {content.cards.map((card, index) => (
        <li class="vs-custom-development__item">
          <DsCard title={card.title} text={card.copy}>
            <span slot="icon" set:html={cardIcons[index]} />
          </DsCard>
        </li>
      ))}
    </ul>

    <article class="vs-custom-development__cta-card vs-custom-development__cta-card--responsive u-border-interactive">
      <div class="vs-custom-development__cta-content">
        <h3 class="vs-custom-development__cta-heading">{content.cta.heading}</h3>
        <p class="vs-custom-development__cta-copy">{content.cta.copy}</p>
        <ArrowButton
          class="vs-custom-development__cta-button"
          href="#book-demo"
          variant="primary"
        >
          {content.cta.label}
        </ArrowButton>
      </div>
    </article>
  </div>
</section>

<style>
  .vs-custom-development {
    background: var(--bg);
    border-bottom: 1px solid var(--border-color);
  }

  .vs-custom-development__container {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    column-gap: clamp(var(--sp-6), 7vw, var(--sp-9));
    row-gap: var(--sp-6);
    align-items: stretch;
  }

  .vs-custom-development__left {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--sp-6);
  }

  .vs-custom-development__content {
    display: grid;
    gap: var(--sp-3);
  }

  .vs-custom-development__heading,
  .vs-custom-development__copy {
    margin: 0;
  }

  .vs-custom-development__heading {
    max-width: 30ch;
  }

  .vs-custom-development__copy {
    max-width: 80ch;
  }

  .vs-custom-development__cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
  }

  .vs-custom-development__item {
    display: grid;
    list-style: none;
  }

  :global(.vs-custom-development__cards .vs-custom-development__item .ds-card) {
    padding: var(--sp-4) var(--sp-5);
  }

  :global(.vs-custom-development__cards .vs-custom-development__item .ds-card__layout) {
    gap: var(--sp-5);
  }

  .vs-custom-development__cta-card {
    display: grid;
    width: min(100%, 34rem);
    padding: var(--sp-4);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(
        ellipse 135% 110% at 100% -10%,
        color-mix(in srgb, var(--color-brand) 40%, transparent),
        transparent 76%
      ),
      radial-gradient(
        ellipse 115% 95% at 100% 70%,
        color-mix(in srgb, var(--color-aurora) 20%, transparent),
        transparent 78%
      ),
      var(--surface);
  }

  .vs-custom-development__cta-card--responsive {
    display: none;
    container-name: vs-custom-development-cta;
    container-type: inline-size;
  }

  .vs-custom-development__cta-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
  }

  .vs-custom-development__cta-heading {
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.3;
    text-wrap: balance;
  }

  .vs-custom-development__cta-copy {
    max-width: 50ch;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-base);
    line-height: 1.45;
  }

  :global(.vs-custom-development__cards .vs-custom-development__item .ds-card__icon) {
    align-self: center;
    width: 6rem;
    height: 6rem;
    aspect-ratio: 1 / 1;
  }

  :global(.vs-custom-development__cards .vs-custom-development__item .ds-card__icon svg) {
    width: 4.5rem;
    height: 4.5rem;
  }

  :global(.vs-custom-development__cta-card .vs-custom-development__cta-button .cta-arrow-icon svg) {
    transform: none;
  }

  @media (max-width: 1200px) {
    .vs-custom-development__container {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
      align-items: start;
    }

    .vs-custom-development__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: var(--sp-6);
    }

    .vs-custom-development__cta-card--desktop {
      display: none;
    }

    .vs-custom-development__cta-card--responsive {
      display: grid;
      width: 100%;
      margin-top: var(--sp-6);
    }

    .vs-custom-development__copy {
      max-width: none;
    }
  }

  @media (max-width: 1024px) {
    .vs-custom-development__cards {
      grid-template-columns: 1fr;
    }
  }

  @container vs-custom-development-cta (min-width: 48rem) {
    .vs-custom-development__cta-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: var(--sp-6);
      row-gap: var(--sp-3);
      align-items: center;
    }

    .vs-custom-development__cta-heading,
    .vs-custom-development__cta-copy {
      grid-column: 1;
    }

    :global(.vs-custom-development__cta-button) {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
      justify-self: end;
    }
  }
</style>
